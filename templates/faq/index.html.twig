{% extends 'base.html.twig' %}

{# SEO gere par SeoService via la variable seo (base.html.twig) #}

{% block jsonld %}
{% if groups|length > 0 %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {% set allFaqs = [] %}
        {% for group in groups %}
            {% for faq in group.faqs %}
                {% set allFaqs = allFaqs|merge([faq]) %}
            {% endfor %}
        {% endfor %}
        {% for faq in allFaqs %}
        {
            "@type": "Question",
            "name": {{ faq.question|json_encode|raw }},
            "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq.content|striptags|json_encode|raw }}
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endif %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ absolute_url(path('app_home')) }}"},
        {"@type": "ListItem", "position": 2, "name": "FAQ"}
    ]
}
</script>
{% endblock %}

{% block body %}
    {# Corps delegue : une surcouche client, sinon le rendu commun #}
    {% include [
        'client/faq.html.twig',
        'faq/_index_generic.html.twig'
    ] %}
{% endblock %}
