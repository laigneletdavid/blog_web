{# ======================================================================
   SIMULATEURS — sommaire
   ====================================================================== #}
{% extends 'base.html.twig' %}

{% block body %}
{% include 'simulateur/_hero.html.twig' with {
    surtitre: 'BM Notaire · Saint-Martory',
    titre: 'Estimer,<br><em>avant de décider.</em>',
    chapo: 'Ces outils donnent un ordre de grandeur pour préparer votre projet. Seule l’étude, au vu de votre situation, peut arrêter un chiffre.'
} only %}

<section class="bm-section">
    <div class="bm-poles">
        {% for slug, simulateur in simulateurs %}
            <a href="{{ path('app_simulateur_show', { slug: slug }) }}" class="bm-pole">
                <span class="bm-pole__num">{{ '%02d'|format(loop.index) }}</span>
                <h2 class="bm-pole__titre">{{ simulateur.titre }}</h2>
                <p class="bm-pole__liste">{{ simulateur.resume }}</p>
                <span class="bm-pole__fleche" aria-hidden="true">↗</span>
            </a>
        {% endfor %}
    </div>
</section>
{% endblock %}
