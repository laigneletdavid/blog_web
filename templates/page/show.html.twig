{% extends 'base.html.twig' %}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ page.title|json_encode|raw }},
    "url": "{{ app.request.uri }}",
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ app.request.uri }}"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ absolute_url(path('app_home')) }}"},
        {"@type": "ListItem", "position": 2, "name": {{ page.title|json_encode|raw }}}
    ]
}
</script>
{% endblock %}

{% block body %}
    {# Corps delegue : une surcouche client, sinon celle du theme, sinon le
       rendu commun. Un client peut ainsi redessiner cette page sans toucher
       aux fichiers partages par les autres. #}
    {% include [
        'client/page/show.html.twig',
        'themes/' ~ _theme ~ '/page/show.html.twig',
        'page/_show_generic.html.twig'
    ] %}
{% endblock %}
