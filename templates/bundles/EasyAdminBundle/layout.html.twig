{% extends '@!EasyAdmin/layout.html.twig' %}

{# Bascule mode simple / expert, sous le menu principal. Seulement sur les
   ecrans ou elle change quelque chose : l'edition d'un article, d'une page ou
   d'un service (options avancees) et la page Reglages (modules, abonnes,
   familles d'etiquettes). Ailleurs, cliquer ne montrait rien. #}
{% block main_menu_wrapper %}
    {{ parent() }}
    {% set _bw_crud = ea is defined and ea ? ea.crud : null %}
    {% set _bw_expert_ici = (_bw_crud
            and _bw_crud.controllerFqcn in [
                'App\\Controller\\Admin\\ArticleCrudController',
                'App\\Controller\\Admin\\PageCrudController',
                'App\\Controller\\Admin\\ServiceCrudController',
            ]
            and _bw_crud.currentAction in ['new', 'edit'])
        or app.request.attributes.get('_route') == 'admin_settings'
        or app.request.query.get('routeName') == 'admin_settings' %}
    {% if is_granted('ROLE_AUTHOR') and _bw_expert_ici %}
        <form class="bw-expert-toggle" method="post" action="{{ path('admin_expert_toggle') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_expert') }}">
            <button type="submit" class="bw-expert-toggle__btn" role="switch" aria-checked="{{ is_admin_expert() ? 'true' : 'false' }}">
                <span class="bw-expert-toggle__track" aria-hidden="true"><span class="bw-expert-toggle__thumb"></span></span>
                <span>Mode expert</span>
            </button>
            <span class="bw-expert-toggle__hint">{{ is_admin_expert() ? 'Réglages techniques affichés.' : 'Affiche les réglages techniques.' }}</span>
        </form>
    {% endif %}
{% endblock %}

{# Identite du site client (logo + nom, reglages Identite du site) en tete de la barre du haut #}
{% block content_top_header %}
    {% set _bw_site = seo_service.currentSite %}
    {% if _bw_site %}
        <a class="bw-site-identity" href="{{ path('app_home') }}" target="_blank" rel="noopener" title="Voir le site">
            {# Logo seul s'il est regle (il porte deja le nom), sinon le nom #}
            {% if _bw_site.logo and _bw_site.logo.fileName %}
                <img class="bw-site-identity__logo" src="{{ asset('documents/medias/' ~ _bw_site.logo.fileName) }}" alt="{{ _bw_site.name }}">
            {% else %}
                <span class="bw-site-identity__name">{{ _bw_site.name }}</span>
            {% endif %}
        </a>
    {% endif %}
    {{ parent() }}
{% endblock %}

{# Le texte d'aide d'une page (Crud::setHelp) s'affiche en clair sous le titre :
   il porte des liens vers les ecrans voisins, inutilisables dans l'infobulle d'origine #}
{% block content_help %}{% endblock %}

{% block content_header_wrapper %}
    {{ parent() }}
    {% if ea.crud is not null and ea.crud.helpMessage is not empty %}
        <p class="bw-page-help">{{ ea.crud.helpMessage|trans|raw }}</p>
    {% endif %}
    {# Pas de bilan SEO sur un formulaire de creation : tout y serait "a corriger" #}
    {% if seo_report is defined and seo_report is not null and ea.crud.currentPage == 'edit' %}
        <section class="px-0 mt-2">
            {% include 'admin/field/seo_report_panel.html.twig' %}
        </section>
    {% endif %}
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    {% include 'admin/_help_panel.html.twig' %}
{% endblock %}
