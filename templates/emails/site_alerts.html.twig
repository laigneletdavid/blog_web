{# Alertes hebdo du site, pour le super admin (RAPPORT.md, phase R4).
   Meme charte que monthly_report.html.twig, styles en ligne. #}
{% set rouge = '#B91C1C' %}
{% set encre = '#1F2328' %}
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0; padding:0; background:#EEF2F7;">
<div style="padding:24px 12px; background:#EEF2F7;">
<div style="font-family:Arial, Helvetica, sans-serif; max-width:600px; margin:0 auto; background:#FFFFFF; color:#374151; font-size:15px; line-height:1.55; border-radius:12px; overflow:hidden; border-top:5px solid {{ rouge }};">
    <div style="padding:24px;">
        <p style="margin:0; color:#6B7280; font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">
            {% if site_url %}<a href="{{ site_url }}" style="color:#6B7280; text-decoration:none;">{{ site_name }}</a>{% else %}{{ site_name }}{% endif %} · alertes de la semaine
        </p>
        <h1 style="font-size:22px; line-height:1.3; margin:8px 0 20px; color:{{ encre }};">
            {{ alerts|length }} point{{ alerts|length > 1 ? 's' }} à vérifier
        </h1>

        {% for alert in alerts %}
            <div style="margin:0 0 14px; padding:14px 16px; background:#FEF2F2; border-left:4px solid {{ rouge }}; border-radius:6px;">
                <div style="font-weight:bold; color:{{ rouge }};">{{ alert.title }}</div>
                <div style="margin:4px 0 6px; color:{{ encre }}; word-break:break-word;">{{ alert.detail }}</div>
                <div style="font-size:14px; color:#374151;"><strong>À faire :</strong> {{ alert.action }}</div>
            </div>
        {% endfor %}
    </div>
    <div style="padding:14px 24px; background:#F7F8FA; border-top:1px solid #E5E7EB; color:#9CA3AF; font-size:12px;">
        Contrôles automatiques BlogWeb. Rien n'est envoyé les semaines où tout va bien.
    </div>
</div>
</div>
</body>
</html>
