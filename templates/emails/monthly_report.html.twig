{# Rapport mensuel client (RAPPORT.md, phase R1 : sans Search Console).
   Une colonne, styles en ligne : les clients mail ignorent les feuilles de style.
   Couleurs du logo BlogWeb : bleu #0B57D0, orange #F7931E, encre #1F2328. #}
{% set r = report %}
{% set bleu = '#0B57D0' %}
{% set orange = '#F7931E' %}
{% set encre = '#1F2328' %}

{% macro pourcent(valeur) %}{{ valeur|number_format(2, ',', ' ') }} %{% endmacro %}

{% macro fleche(trend) %}
    {%- if trend is null -%}
    {%- elseif trend > 0 -%}<span style="color:#15803D; font-weight:bold;">&#9650; +{{ _self.pourcent(trend) }}</span>
    {%- elseif trend < 0 -%}<span style="color:#B91C1C; font-weight:bold;">&#9660; {{ _self.pourcent(trend) }}</span>
    {%- else -%}<span style="color:#6B7280;">= stable</span>
    {%- endif -%}
{% endmacro %}

{% macro titre(texte) %}
    <h2 style="font-size:17px; margin:32px 0 12px; padding-left:10px; border-left:4px solid #F7931E; color:#1F2328;">{{ texte }}</h2>
{% endmacro %}

<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0; padding:0; background:#EEF2F7;">
<div style="padding:24px 12px; background:#EEF2F7;">
<div style="font-family:Arial, Helvetica, sans-serif; max-width:600px; margin:0 auto; background:#FFFFFF; color:#374151; font-size:15px; line-height:1.55; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(31,35,40,0.08);">

    {# En-tete BlogWeb #}
    <table role="presentation" width="100%" style="border-collapse:collapse;">
        <tr>
            <td style="padding:20px 24px 16px; width:120px; vertical-align:middle;">
                {% if logo_src %}<img src="{{ logo_src }}" alt="BlogWeb" width="96" style="display:block; width:96px; height:auto; border:0;">{% else %}<strong style="font-size:20px; color:{{ encre }};">BlogWeb</strong>{% endif %}
            </td>
            <td style="padding:20px 24px 16px; text-align:right; vertical-align:middle; font-size:16px; line-height:1.4; color:{{ encre }};">
                Le code, c'est <strong style="color:{{ bleu }};">nous</strong>.<br>
                Le contenu, c'est <strong style="color:{{ orange }};">vous</strong>.
            </td>
        </tr>
    </table>
    <table role="presentation" width="100%" style="border-collapse:collapse;">
        <tr>
            <td style="height:4px; width:60%; background:{{ bleu }}; font-size:0; line-height:0;">&nbsp;</td>
            <td style="height:4px; width:40%; background:{{ orange }}; font-size:0; line-height:0;">&nbsp;</td>
        </tr>
    </table>

    <div style="padding:26px 24px 28px;">

    {# 1. Le mois en une phrase #}
    <p style="margin:0; color:#6B7280; font-size:13px; text-transform:uppercase; letter-spacing:0.5px;">{{ r.site_name }} · rapport {{ r.month_label matches '/^[aeiouyéè]/' ? "d'" : 'de ' }}{{ r.month_label }}</p>
    <h1 style="font-size:23px; line-height:1.3; margin:8px 0 22px; color:{{ encre }};">{{ r.summary }}</h1>

    <table role="presentation" width="100%" style="border-collapse:separate; border-spacing:0;">
        <tr>
            <td style="width:50%; padding:16px 18px; background:#EEF4FF; border-radius:10px; border-top:4px solid {{ bleu }};">
                <div style="font-size:30px; font-weight:bold; color:{{ bleu }};">{{ r.visitors.current|number_format(0, ',', ' ') }}</div>
                <div style="color:{{ encre }};">visiteurs {{ _self.fleche(r.visitors.trend) }}</div>
            </td>
            <td style="width:12px;"></td>
            <td style="width:50%; padding:16px 18px; background:#FFF5E8; border-radius:10px; border-top:4px solid {{ orange }};">
                <div style="font-size:30px; font-weight:bold; color:#C26A00;">{{ r.contacts.total }}</div>
                <div style="color:{{ encre }};">prise{{ r.contacts.total > 1 ? 's' }} de contact {{ _self.fleche(r.contacts.trend) }}</div>
            </td>
        </tr>
    </table>

    {# 6. Visiteurs et contacts #}
    {{ _self.titre('Vos visiteurs et vos contacts') }}
    <p style="margin:0 0 6px;">
        <strong>{{ r.visitors.current|number_format(0, ',', ' ') }} visiteurs</strong>{% if r.visitors.current > 0 %}, dont {{ _self.pourcent(r.google_share) }} via Google · {{ _self.pourcent(r.mobile_share) }} sur mobile{% endif %}
    </p>
    {% if r.sources is not empty %}
        <p style="margin:0 0 10px; color:#6B7280; font-size:14px;">
            {% for groupe, part in r.sources %}{{ groupe }} {{ _self.pourcent(part) }}{% if not loop.last %} · {% endif %}{% endfor %}
        </p>
    {% endif %}
    {% set c = r.contacts.current %}
    <p style="margin:0; padding:10px 14px; background:#F7F8FA; border-radius:8px;">
        <strong>{{ c.phone }} appel{{ c.phone > 1 ? 's' }} · {{ c.form }} formulaire{{ c.form > 1 ? 's' }} · {{ c.email }} e-mail{{ c.email > 1 ? 's' }} · {{ c.directions }} itinéraire{{ c.directions > 1 ? 's' }}</strong>
    </p>

    {# 4. Pages qui marchent #}
    {% if r.top_pages is not empty %}
        {{ _self.titre('Vos pages qui marchent') }}
        <table role="presentation" width="100%" style="border-collapse:collapse;">
            {% for page in r.top_pages %}
                <tr>
                    <td style="padding:9px 0; border-bottom:1px solid #E5E7EB;">
                        <span style="display:inline-block; width:22px; color:#9CA3AF; font-size:13px;">{{ loop.index }}.</span>
                        {%- if r.site_url %}<a href="{{ r.site_url ~ page.url }}" style="color:{{ bleu }}; text-decoration:none;">{{ page.url == '/' ? 'Accueil' : page.url }}</a>{% else %}{{ page.url == '/' ? 'Accueil' : page.url }}{% endif %}
                    </td>
                    <td style="padding:9px 0; border-bottom:1px solid #E5E7EB; text-align:right; white-space:nowrap; color:{{ encre }};"><strong>{{ page.views|number_format(0, ',', ' ') }}</strong> vues</td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {% if r.article %}
        <p style="margin:16px 0 0; padding:12px 14px; border-left:3px solid {{ bleu }}; background:#F7F9FD;">
            Article du mois : <strong>{{ r.article.title }}</strong>, lu {{ r.article.views|number_format(0, ',', ' ') }} fois depuis sa publication.
        </p>
    {% endif %}

    {# 7. Sante du site #}
    {% set feux = {green: ['#15803D', 'Tout va bien'], orange: ['#C2410C', 'À surveiller'], red: ['#B91C1C', 'À corriger rapidement']} %}
    {% set feu = feux[r.health.status] %}
    {{ _self.titre('Santé du site') }}
    <p style="margin:0;">
        <span style="display:inline-block; width:12px; height:12px; border-radius:6px; background:{{ feu[0] }}; vertical-align:middle;"></span>
        <strong style="color:{{ feu[0] }};">{{ feu[1] }}</strong>
    </p>
    {% if r.health.status != 'green' %}
        <ul style="margin:8px 0 0; padding-left:20px;">
            {% if r.health.ssl_days_left is not null and r.health.ssl_days_left < 21 %}
                <li>Le certificat de sécurité expire dans {{ r.health.ssl_days_left }} jours.</li>
            {% endif %}
            {% if r.health.days_since_last_article is not null and r.health.days_since_last_article > 60 %}
                <li>Aucun article depuis {{ r.health.days_since_last_article }} jours.</li>
            {% endif %}
        </ul>
    {% endif %}

    {# 8. Le mois prochain #}
    {% if r.next_actions is not empty %}
        {{ _self.titre('Le mois prochain') }}
        <ul style="margin:0; padding-left:20px;">
            {% for action in r.next_actions %}<li style="margin-bottom:4px;">{{ action }}</li>{% endfor %}
        </ul>
    {% endif %}

    {% if contact_email %}
        <p style="margin:26px 0 0;">
            <a href="mailto:{{ contact_email }}?subject={{ ('Rapport ' ~ r.month_label ~ ' — ' ~ r.site_name)|url_encode }}"
               style="display:inline-block; padding:12px 24px; background:{{ bleu }}; color:#FFFFFF; text-decoration:none; border-radius:8px; font-weight:bold;">Me contacter</a>
        </p>
    {% endif %}

    </div>

    <div style="padding:16px 24px; background:#F7F8FA; border-top:1px solid #E5E7EB; color:#9CA3AF; font-size:12px; line-height:1.5;">
        Statistiques mesurées par votre site lui-même, sans outil publicitaire. Les robots ne sont pas comptés, ni vos visites quand vous êtes connecté à l'administration.
    </div>
</div>
</div>
</body>
</html>
