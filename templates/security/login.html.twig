{% extends 'base.html.twig' %}

{% block title %}Connexion !{% endblock %}

{% block body %}
    <div class="container">
        <div class="security mb-5">
            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        Vous êtes identifiés comme  {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="link_text">Se déconnecter</a>
                    </div>
                {% endif %}

                <h1 class="title_form mb-3">Connectez-vous</h1>
                <div class="mb-3">
                    <label for="inputEmail">Votre adresse e-mail</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                </div>
                <div class="mb-3">
                    <label for="inputPassword">Votre mot de passe</label>
                    <div class="input-group">
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                        <button class="btn btn-outline-secondary d-flex align-items-center" type="button" id="togglePassword" aria-label="Afficher le mot de passe">
                            <span id="iconEye">{{ bi('eye') }}</span>
                            <span id="iconEyeSlash" style="display:none;">{{ bi('eye-slash') }}</span>
                        </button>
                    </div>
                </div>
                <input type="hidden" name="_csrf_token"
                       value="{{ csrf_token('authenticate') }}"
                >

                <div class="login_action d-flex flex-lg-row flex-column pt-3">
                    <button class="btn-font btn btn-primary mb-3 me-lg-3" type="submit">
                        Se connecter
                    </button>
                    <a href="{{ path('app_forgot_password_request') }}" class="btn-font btn btn-outline-secondary mb-3">Mot de passe oublié</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            var input = document.getElementById('inputPassword');
            var iconEye = document.getElementById('iconEye');
            var iconEyeSlash = document.getElementById('iconEyeSlash');
            if (input.type === 'password') {
                input.type = 'text';
                iconEye.style.display = 'none';
                iconEyeSlash.style.display = '';
            } else {
                input.type = 'password';
                iconEye.style.display = '';
                iconEyeSlash.style.display = 'none';
            }
        });
    </script>
{% endblock %}
