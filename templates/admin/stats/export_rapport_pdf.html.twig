<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: DejaVu Sans, sans-serif; font-size: 10px; color: #1e293b; padding: 25px 30px; }

        /* --- En-tete --- */
        h1 { font-size: 20px; color: #0f172a; margin-bottom: 2px; }
        .subtitle { font-size: 10px; color: #64748b; margin-bottom: 18px; }

        /* --- Sections --- */
        .section { margin-bottom: 16px; page-break-inside: avoid; }
        .section-title {
            font-size: 12px; font-weight: bold; color: #0f172a;
            margin-bottom: 6px; padding-bottom: 3px;
            border-bottom: 2px solid #3b82f6;
        }
        .section-title i { margin-right: 4px; }

        /* --- KPI --- */
        .kpi-row { width: 100%; margin-bottom: 14px; }
        .kpi-row td { padding: 8px 10px; text-align: center; border: 1px solid #e2e8f0; background: #f8fafc; }
        .kpi-label { font-size: 8px; color: #64748b; text-transform: uppercase; letter-spacing: 0.4px; }
        .kpi-value { font-size: 18px; font-weight: bold; color: #0f172a; }
        .kpi-value--blue { color: #2563eb; }
        .kpi-value--orange { color: #d97706; }
        .kpi-value--purple { color: #7c3aed; }
        .kpi-value--green { color: #16a34a; }

        /* --- Tableaux --- */
        table.data { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        table.data th {
            background: #f1f5f9; color: #475569; font-size: 9px;
            text-transform: uppercase; letter-spacing: 0.3px;
            padding: 5px 6px; text-align: left; border-bottom: 2px solid #cbd5e1;
        }
        table.data td { padding: 4px 6px; border-bottom: 1px solid #e2e8f0; font-size: 9px; }
        table.data tr:nth-child(even) td { background: #f8fafc; }

        /* --- Utilitaires --- */
        .text-end { text-align: right; }
        .text-center { text-align: center; }
        .fw-bold { font-weight: bold; }
        .muted { color: #94a3b8; }
        .text-nowrap { white-space: nowrap; }

        /* --- Types conversion --- */
        .type-phone { color: #2563eb; }
        .type-email { color: #d97706; }
        .type-form { color: #16a34a; }

        /* --- Source badges --- */
        .badge { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 8px; font-weight: bold; }
        .badge--seo { background: #dbeafe; color: #1d4ed8; }
        .badge--social { background: #fef3c7; color: #b45309; }
        .badge--direct { background: #f3e8ff; color: #6d28d9; }
        .badge--email { background: #dcfce7; color: #15803d; }
        .badge--referral { background: #fee2e2; color: #b91c1c; }
        .badge--other { background: #f1f5f9; color: #475569; }

        /* --- Barres horizontales --- */
        .bar-row { margin-bottom: 3px; position: relative; }
        .bar-bg { height: 16px; background: #e2e8f0; border-radius: 2px; width: 100%; }
        .bar-fill { height: 16px; background: #3b82f6; border-radius: 2px; min-width: 2px; }
        .bar-fill--green { background: #16a34a; }

        /* --- Engagement star --- */
        .star { color: #d97706; font-weight: bold; }

        /* --- Saut de page --- */
        .page-break { page-break-before: always; }

        /* --- Footer --- */
        .footer { margin-top: 20px; padding-top: 8px; border-top: 1px solid #e2e8f0; font-size: 8px; color: #94a3b8; text-align: center; }
    </style>
</head>
<body>

    {# ============================== #}
    {# PAGE 1 : VUE D'ENSEMBLE       #}
    {# ============================== #}

    <h1>Rapport statistiques</h1>
    <div class="subtitle">Periode : {{ periodLabel }} — Genere le {{ "now"|date("d/m/Y H:i") }}</div>

    {# --- KPI Comportement --- #}
    <div class="section">
        <div class="section-title">Indicateurs comportementaux</div>
        <table class="kpi-row" cellspacing="0">
            <tr>
                <td style="width: 25%;">
                    <div class="kpi-value kpi-value--blue">{{ behavior.avg_duration ? (behavior.avg_duration // 60 ~ 'm' ~ '%02d'|format(behavior.avg_duration % 60) ~ 's') : '—' }}</div>
                    <div class="kpi-label">Duree moyenne</div>
                </td>
                <td style="width: 25%;">
                    <div class="kpi-value kpi-value--orange">{{ behavior.bounce_rate is not null ? behavior.bounce_rate ~ '%' : '—' }}</div>
                    <div class="kpi-label">Taux de rebond</div>
                </td>
                <td style="width: 25%;">
                    <div class="kpi-value kpi-value--purple">{{ behavior.avg_depth ?? '—' }}</div>
                    <div class="kpi-label">Pages / session</div>
                </td>
                <td style="width: 25%;">
                    <div class="kpi-value kpi-value--green">{{ behavior.avg_scroll is not null ? behavior.avg_scroll ~ '%' : '—' }}</div>
                    <div class="kpi-label">Scroll moyen</div>
                </td>
            </tr>
        </table>
    </div>

    {# --- Entonnoir de conversion --- #}
    <div class="section">
        <div class="section-title">Entonnoir de conversion</div>
        {% set max = funnel.visitors > 0 ? funnel.visitors : 1 %}
        <table class="data">
            <thead>
                <tr>
                    <th>Etape</th>
                    <th class="text-end" style="width: 80px;">Nombre</th>
                    <th class="text-end" style="width: 70px;">Taux</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Visiteurs uniques</td>
                    <td class="text-end fw-bold">{{ funnel.visitors }}</td>
                    <td class="text-end">100%</td>
                </tr>
                <tr>
                    <td>> 1 page visitee</td>
                    <td class="text-end fw-bold">{{ funnel.engaged }}</td>
                    <td class="text-end">{{ (funnel.engaged / max * 100)|round(1) }}%</td>
                </tr>
                <tr>
                    <td>Vu page contact</td>
                    <td class="text-end fw-bold">{{ funnel.saw_contact }}</td>
                    <td class="text-end">{{ (funnel.saw_contact / max * 100)|round(1) }}%</td>
                </tr>
                <tr>
                    <td class="fw-bold">Conversions</td>
                    <td class="text-end fw-bold type-form">{{ funnel.converted }}</td>
                    <td class="text-end fw-bold type-form">{{ funnel.rate ?? 0 }}%</td>
                </tr>
            </tbody>
        </table>
    </div>

    {# --- KPI Conversions --- #}
    <div class="section">
        <div class="section-title">Conversions par type</div>
        <table class="kpi-row" cellspacing="0">
            <tr>
                <td style="width: 25%;">
                    <div class="kpi-value type-phone">{{ counts.phone_click }}</div>
                    <div class="kpi-label">Appels</div>
                </td>
                <td style="width: 25%;">
                    <div class="kpi-value type-email">{{ counts.email_click }}</div>
                    <div class="kpi-label">Emails</div>
                </td>
                <td style="width: 25%;">
                    <div class="kpi-value type-form">{{ counts.form_submit }}</div>
                    <div class="kpi-label">Formulaires</div>
                </td>
                <td style="width: 25%;">
                    <div class="kpi-value">{{ counts.total }}</div>
                    <div class="kpi-label">Total</div>
                </td>
            </tr>
        </table>
    </div>

    {# ============================== #}
    {# PAGE 2 : ACQUISITION           #}
    {# ============================== #}

    <div class="page-break"></div>

    {# --- Sources de trafic --- #}
    <div class="section">
        <div class="section-title">Acquisition — Sources de trafic</div>
        {% if sources|length > 0 %}
            {% set totalSrc = sources|reduce((c, s) => c + s.cnt, 0) %}
            <table class="data">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="text-end" style="width: 80px;">Sessions</th>
                        <th class="text-end" style="width: 70px;">Part</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in sources %}
                    <tr>
                        <td>
                            {% set srcType = s.source starts with 'seo' ? 'seo' : (s.source starts with 'social' ? 'social' : s.source) %}
                            <span class="badge badge--{{ srcType }}">{{ s.source|replace({'_': ' '})|capitalize }}</span>
                        </td>
                        <td class="text-end fw-bold">{{ s.cnt }}</td>
                        <td class="text-end">{{ totalSrc > 0 ? (s.cnt / totalSrc * 100)|round(1) : 0 }}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="muted">Aucune donnee.</p>
        {% endif %}
    </div>

    {# --- Appareils --- #}
    <div class="section">
        <div class="section-title">Acquisition — Appareils</div>
        {% if devices|length > 0 %}
            {% set devTotal = devices|reduce((c, d) => c + d.cnt, 0) %}
            {% set deviceLabels = { desktop: 'Desktop', mobile: 'Mobile', tablet: 'Tablette', unknown: 'Inconnu' } %}
            <table class="data">
                <thead>
                    <tr>
                        <th>Appareil</th>
                        <th class="text-end" style="width: 80px;">Sessions</th>
                        <th class="text-end" style="width: 70px;">Part</th>
                    </tr>
                </thead>
                <tbody>
                    {% for d in devices %}
                    <tr>
                        <td>{{ deviceLabels[d.device_type] ?? d.device_type }}</td>
                        <td class="text-end fw-bold">{{ d.cnt }}</td>
                        <td class="text-end">{{ devTotal > 0 ? (d.cnt / devTotal * 100)|round(1) : 0 }}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="muted">Aucune donnee.</p>
        {% endif %}
    </div>

    {# --- Pages d'entree --- #}
    <div class="section">
        <div class="section-title">Acquisition — Pages d'entree</div>
        {% if landingPages|length > 0 %}
            <table class="data">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th class="text-end" style="width: 80px;">Sessions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for lp in landingPages %}
                    <tr>
                        <td>{{ lp.landing_page }}</td>
                        <td class="text-end fw-bold">{{ lp.cnt }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="muted">Aucune donnee.</p>
        {% endif %}
    </div>

    {# ============================== #}
    {# PAGE 3 : COMPORTEMENT          #}
    {# ============================== #}

    <div class="page-break"></div>

    {# --- Detail par page --- #}
    <div class="section">
        <div class="section-title">Comportement — Detail par page</div>
        {% if topPages|length > 0 %}
            <table class="data">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th class="text-end" style="width: 50px;">Vues</th>
                        <th class="text-end" style="width: 65px;">Duree moy.</th>
                        <th class="text-end" style="width: 50px;">Scroll</th>
                        <th class="text-end" style="width: 55px;">Rebond</th>
                        <th class="text-center" style="width: 20px;"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for page in topPages %}
                    <tr>
                        <td>{{ page.url }}</td>
                        <td class="text-end fw-bold">{{ page.views }}</td>
                        <td class="text-end">{{ page.avg_duration ? (page.avg_duration // 60 ~ ':' ~ '%02d'|format(page.avg_duration % 60)) : '—' }}</td>
                        <td class="text-end">{{ page.avg_scroll ? page.avg_scroll ~ '%' : '—' }}</td>
                        <td class="text-end">{{ page.bounce_rate is not null ? page.bounce_rate ~ '%' : '—' }}</td>
                        <td class="text-center">
                            {% if page.avg_duration is not null and page.avg_duration > 120 and page.avg_scroll is not null and page.avg_scroll > 70 %}
                                <span class="star">&#9733;</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p style="font-size: 8px; color: #94a3b8; margin-top: 2px;">&#9733; = Bon engagement (duree > 2min et scroll > 70%)</p>
        {% else %}
            <p class="muted">Aucune donnee.</p>
        {% endif %}
    </div>

    {# --- Pages de sortie --- #}
    <div class="section">
        <div class="section-title">Comportement — Pages de sortie</div>
        {% if exitPages|length > 0 %}
            <table class="data">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th class="text-end" style="width: 80px;">Sorties</th>
                        <th class="text-end" style="width: 80px;">Taux sortie</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ep in exitPages %}
                    <tr>
                        <td>{{ ep.exit_page }}</td>
                        <td class="text-end fw-bold">{{ ep.exit_sessions }}</td>
                        <td class="text-end">{{ ep.exit_rate }}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="muted">Aucune donnee.</p>
        {% endif %}
    </div>

    {# ============================== #}
    {# PAGE 4 : CONVERSIONS DETAIL    #}
    {# ============================== #}

    <div class="page-break"></div>

    {# --- Pages qui convertissent --- #}
    {% if conversionPages|length > 0 %}
    <div class="section">
        <div class="section-title">Conversions — Pages moteur</div>
        <table class="data">
            <thead>
                <tr>
                    <th>Page</th>
                    <th class="text-end" style="width: 80px;">Conversions</th>
                </tr>
            </thead>
            <tbody>
                {% for cp in conversionPages %}
                <tr>
                    <td>{{ cp.page_url }}</td>
                    <td class="text-end fw-bold">{{ cp.cnt }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {# --- Detail des conversions --- #}
    <div class="section">
        <div class="section-title">Conversions — Detail</div>
        {% if conversions|length > 0 %}
            <table class="data">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Page</th>
                        <th>Source</th>
                        <th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in conversions %}
                    <tr>
                        <td class="text-nowrap">{{ row.date }}</td>
                        <td>
                            {% if row.type == 'phone_click' %}<span class="type-phone">Appel</span>
                            {% elseif row.type == 'email_click' %}<span class="type-email">Email</span>
                            {% else %}<span class="type-form">Formulaire</span>
                            {% endif %}
                        </td>
                        <td>{{ row.page_url }}</td>
                        <td>{{ (row.source ?? 'direct')|replace({'_': ' '})|capitalize }}</td>
                        <td>{{ row.detail ?? '—' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="muted text-center">Aucune conversion sur cette periode.</p>
        {% endif %}
    </div>

    <div class="footer">
        BlogWeb CMS — Rapport statistiques complet — Genere automatiquement le {{ "now"|date("d/m/Y a H:i") }}
    </div>

</body>
</html>
