{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Accueil{% endblock %}

{% block content_header %}
    <div class="bw-page-head">
        <div>
            <h1 class="bw-page-head__title">Bonjour{{ app.user.firstName ? ' ' ~ app.user.firstName : '' }}</h1>
            <p class="bw-page-head__text">Voici ce qui demande votre attention.</p>
        </div>
        {% if types is not empty %}
            {% include 'admin/hub/_create_menu.html.twig' %}
        {% endif %}
    </div>
{% endblock %}

{% block main %}
<div class="bw-dashboard bw-simple"
     data-walkthrough-steps="{{ tourSteps|json_encode|e('html_attr') }}"
     data-walkthrough-complete-url="{{ path('admin_tour_complete') }}">

    {% if not tourCompleted %}
    <div class="bw-banner" data-tour="banner">
        <div>
            <strong>Première visite ?</strong>
            <span>Découvrez l'administration en 2 minutes.</span>
        </div>
        <button type="button" class="bw-btn" data-action="walkthrough-start">
            <i class="fas fa-play" aria-hidden="true"></i> Lancer la visite
        </button>
    </div>
    {% endif %}

    {# --- A faire --- #}
    <section class="bw-panel" aria-label="À faire">
        {% for todo in todos %}
            <div class="bw-todo">
                <span class="bw-todo__dot bw-todo__dot--{{ todo.tone }}" aria-hidden="true"></span>
                <span class="bw-todo__label">{{ todo.label }}</span>
                <a class="bw-btn bw-btn--small" href="{{ todo.url }}">{{ todo.action }}</a>
            </div>
        {% else %}
            <p class="bw-todo__done"><i class="fas fa-check" aria-hidden="true"></i> Tout est à jour, rien ne vous attend.</p>
        {% endfor %}
    </section>

    {# --- Chiffres cles (administrateurs) --- #}
    {% if figures is not null %}
    <div class="bw-figures">
        <div class="bw-figure">
            <span class="bw-figure__label">Visites ce mois</span>
            <span class="bw-figure__value">{{ figures.visitsMonth|number_format(0, ',', ' ') }}</span>
        </div>
        <div class="bw-figure">
            <span class="bw-figure__label">Demandes de contact ce mois</span>
            <span class="bw-figure__value">{{ figures.contactsMonth }}</span>
        </div>
        <div class="bw-figure">
            <span class="bw-figure__label">Page la plus vue ce mois</span>
            {% if figures.topPage %}
                <span class="bw-figure__value bw-figure__value--text" title="{{ figures.topPage.url }}">{{ figures.topPage.url }}</span>
                <span class="bw-figure__sub">{{ figures.topPage.views }} visites</span>
            {% else %}
                <span class="bw-figure__value bw-figure__value--text">—</span>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# --- Derniers contenus modifies --- #}
    {% if recent is not empty %}
    <section class="bw-panel" aria-label="Modifiés récemment">
        <div class="bw-panel__head">
            <h2 class="bw-panel__title">Modifiés récemment</h2>
            <a href="{{ path('admin_contents') }}">Tous les contenus</a>
        </div>
        <div class="bw-list bw-list--flat">
            {% for item in recent %}
                <a class="bw-list__row" href="{{ item.editUrl }}">
                    <span class="bw-type bw-type--{{ item.type }}">{{ item.typeLabel }}</span>
                    <span class="bw-list__title">{{ item.title }}</span>
                    <span class="bw-list__date">{{ item.date ? item.date|format_date('medium', locale='fr') : '' }}</span>
                    {% if item.published %}
                        <span class="bw-status bw-status--on">En ligne</span>
                    {% else %}
                        <span class="bw-status bw-status--off">Brouillon</span>
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# --- Ventes (module e-commerce) --- #}
    {% if ecommerceStats is not null %}
    <section class="bw-panel" aria-label="Ventes du mois">
        <div class="bw-panel__head">
            <h2 class="bw-panel__title">Ventes du mois</h2>
        </div>
        <div class="bw-figures bw-figures--inline">
            <div class="bw-figure">
                <span class="bw-figure__label">Chiffre d'affaires</span>
                <span class="bw-figure__value">{{ ecommerceStats.revenueThisMonth|number_format(2, ',', ' ') }} €</span>
            </div>
            <div class="bw-figure">
                <span class="bw-figure__label">Commandes payées</span>
                <span class="bw-figure__value">{{ ecommerceStats.countPaidThisMonth }}</span>
            </div>
        </div>
        {% if ecommerceStats.recentOrders|length > 0 %}
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Réf.</th><th>Client</th><th>Total</th><th>Statut</th><th>Date</th></tr>
                </thead>
                <tbody>
                    {% for order in ecommerceStats.recentOrders %}
                    <tr>
                        <td><code>{{ order.reference }}</code></td>
                        <td>{{ order.customerFirstName }} {{ order.customerLastName }}</td>
                        <td>{{ order.totalTTC|number_format(2, ',', ' ') }} €</td>
                        <td><span class="badge {{ order.status.cssClass }}">{{ order.status.label }}</span></td>
                        <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </section>
    {% endif %}

    {% if tourCompleted %}
        <p class="bw-hint">
            <button type="button" class="bw-link-button" data-action="walkthrough-start">Revoir la visite guidée</button>
        </p>
    {% endif %}

</div>
{% endblock %}
