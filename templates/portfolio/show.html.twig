{% extends 'base.html.twig' %}

{# SEO gere par SeoService via la variable seo (base.html.twig) #}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": {{ item.title|json_encode|raw }},
    "description": {{ seo.description|default(item.shortDescription|default(''))|json_encode|raw }}
    {%- if item.image %},
    "image": "{{ absolute_url(asset('documents/medias/' ~ item.image.fileName)) }}"
    {%- endif %}
    {%- if item.category %},
    "genre": {{ item.category.name|json_encode|raw }}
    {%- endif %}
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ absolute_url(path('app_home')) }}"},
        {"@type": "ListItem", "position": 2, "name": "Réalisations", "item": "{{ absolute_url(path('app_portfolio_index')) }}"},
        {"@type": "ListItem", "position": 3, "name": {{ item.title|json_encode|raw }}}
    ]
}
</script>
{% endblock %}

{% block body %}
    {# Corps delegue : une surcouche client, sinon le rendu commun #}
    {% include [
        'client/portfolio/show.html.twig',
        'portfolio/_show_generic.html.twig'
    ] %}
{% endblock %}
