{% extends 'base.html.twig' %}

{% block seo %}
    {# Valeurs par defaut, puis le bloc commun : robots (noindex d'une liste vide), canonical, Open Graph #}
    {% set seo = (seo|default({}))|merge({ title: seo.title|default('Nos réalisations'), description: seo.description|default('Découvrez nos réalisations') }) %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {# Corps delegue : une surcouche client, sinon le rendu commun #}
    {% include [
        'client/portfolio/index.html.twig',
        'portfolio/_index_generic.html.twig'
    ] %}
{% endblock %}
