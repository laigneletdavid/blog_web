{# Widget "Dernier article" — card verticale #}
{% if widget_article %}
<div class="p-4 widget_article">
    <h4>Dernier article</h4>
    <a href="{{ path('app_article_show', { 'slug': widget_article.slug}) }}" class="widget_article__link">
        {% if widget_article.featuredMedia %}
            <div class="widget_article__img">
                <img src="{{ asset('documents/medias/' ~ widget_article.featuredMedia.fileName) }}"
                     alt="{{ widget_article.featuredMedia.name }}"
                     loading="lazy"/>
            </div>
        {% endif %}
        <div class="widget_article__body">
            <h5 class="widget_article__title">{{ widget_article.title }}</h5>
            <div class="widget_article__meta">
                {% for cat in widget_article.categories %}
                    <span class="widget_article__cat">{{ cat.name }}</span>
                {% endfor %}
                <span class="widget_article__date">{{ widget_article.createdAt|date('d/m/Y') }}</span>
            </div>
            {% if widget_article.featuredText %}
                <p class="widget_article__excerpt">{{ widget_article.featuredText }}</p>
            {% endif %}
        </div>
    </a>
</div>
{% endif %}
