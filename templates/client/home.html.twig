{# ====== HOME CLIENT — Override bw_front (BlogWeb) ====== #}
{# Surcharge de home/_home_generic.html.twig #}

{# Motif « vague » de la charte : un seul trace, couleur portee par currentColor.
   Usage : <span class="vague">mots<svg class="vague__trait" aria-hidden="true"
   viewBox="0 0 200 20" preserveAspectRatio="none"><use href="#bw-vague"/></svg></span> #}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="bw-vague" viewBox="0 0 200 20">
        {# Trace du logo couche a plat : descente, creux et rebond du W, double bosse du M, longue traine #}
        <path d="M3 8 C 30 10, 50 19, 61 19 C 67 19, 68 12, 72 12 C 77 12, 79 17, 85 17 C 93 17, 97 11, 101 8 C 105 4, 109 3, 114 3 C 121 3, 123 8, 129 8 C 135 8, 135 1, 140 1 C 155 1, 176 8, 197 11"
              fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"
              vector-effect="non-scaling-stroke"/>
    </symbol>
</svg>

{% macro vague(mots) %}<span class="vague">{{ mots }}<svg class="vague__trait" aria-hidden="true" viewBox="0 0 200 20" preserveAspectRatio="none"><use href="#bw-vague"/></svg></span>{% endmacro %}

{# ====== 3.2 HERO ====== #}
<section class="home-hero">
    <div class="container position-relative">
        <div class="row align-items-center home-hero__row g-4 g-lg-5">
            <div class="col-lg-6 home-hero__content">
                <p class="home-hero__overtitle">Le code c'est nous, le contenu c'est vous.</p>
                <h1 class="home-hero__title">Site internet professionnel {{ _self.vague('clé en main') }} pour TPE et artisans</h1>
                <p class="home-hero__desc">Un site professionnel livré en une demi-journée, prêt à être trouvé sur Google. Vous racontez votre métier, on s'occupe du reste.</p>
                <div class="home-hero__actions">
                    <a href="/page/offres" class="btn btn-primary btn-lg">Voir les offres</a>
                    <a href="{{ path('app_contact') }}" class="btn btn-outline-primary btn-lg">Demander un devis</a>
                </div>
                <div class="home-hero__badges">
                    <span class="home-hero__trust-badge">&#9989; Site en ligne en &#189; journée</span>
                    <span class="home-hero__trust-badge">&#128274; Sécurisé & RGPD</span>
                    <span class="home-hero__trust-badge">&#127467;&#127479; Hébergé en France</span>
                </div>
            </div>
            <div class="col-lg-6">
                {# TODO CONTENU : capture de l'éditeur (servie en WebP via responsive_img, width/height,
                   alt descriptif). En attendant, maquette HTML de l'éditeur, base de la démo animée. #}
                <figure class="cw-browser hero-demo" role="img"
                        aria-label="L'éditeur du site : vous tapez votre titre et votre texte, l'aperçu de votre site se met à jour à côté.">
                    <div class="cw-browser__bar" aria-hidden="true">
                        <span class="cw-browser__dots"><i></i><i></i><i></i></span>
                        <span class="cw-browser__url">votre-site.fr/admin</span>
                    </div>
                    <div class="hero-demo__body" aria-hidden="true">
                        <div class="hero-demo__editor">
                            <span class="hero-demo__label">Titre</span>
                            <div class="hero-demo__field hero-demo__field--title" data-demo-texte="titre">Atelier de menuiserie</div>
                            <span class="hero-demo__label">Texte</span>
                            <div class="hero-demo__field" data-demo-texte="texte">Fabrication sur mesure, pose et conseil près de chez vous.</div>
                            <span class="hero-demo__publish">Publier</span>
                        </div>
                        <div class="hero-demo__preview">
                            <span class="hero-demo__preview-bar"></span>
                            <strong class="hero-demo__preview-title" data-demo-apercu="titre">Atelier de menuiserie</strong>
                            <span class="hero-demo__preview-text" data-demo-apercu="texte">Fabrication sur mesure, pose et conseil près de chez vous.</span>
                            <span class="hero-demo__preview-btn"></span>
                        </div>
                    </div>
                </figure>
            </div>
        </div>
    </div>
</section>

{# ====== 3.3 PREUVE RAPIDE ====== #}
{# TODO CONTENU : 3 captures de sites clients (capture WebP + nom + métier, avec l'accord des clients).
   Remplir la liste : { image: 'fichier.webp', nom: '...', metier: '...', url: 'https://...' }.
   La section reste masquée tant que la liste est vide. #}
{% set sitesClients = [] %}
{% if sitesClients|length > 0 %}
<section class="home-proof">
    <div class="container">
        <p class="home-proof__title">Ils ont leur site avec nous</p>
        <div class="home-proof__grid">
            {% for client in sitesClients %}
            <a class="home-proof__card" href="{{ client.url }}" target="_blank" rel="noopener">
                <img src="{{ asset('documents/medias/' ~ client.image) }}" alt="Site de {{ client.nom }}, {{ client.metier }}" loading="lazy" width="480" height="300">
                <span class="home-proof__name">{{ client.nom }}</span>
                <span class="home-proof__job">{{ client.metier }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 3.4 POURQUOI PAS WORDPRESS ====== #}
<section class="home-wordpress-compare">
    <div class="container">
        <div class="home-wordpress-compare__inner">
            <h2 class="home-section-title">Pourquoi pas un WordPress comme tout le monde ?</h2>
            <p class="home-wordpress-compare__text">WordPress, c'est l'illusion de la simplicité. En réalité : des plugins à empiler, des mises à jour qui cassent tout, des failles de sécurité tous les mois, et un site qui ralentit avec le temps. BlogWeb fait l'inverse : tout est intégré, sécurisé, optimisé dès le premier jour. Rien à installer, rien à maintenir, rien à craindre.</p>
            <a href="/page/site-sur-mesure-vs-cms-classique" class="btn btn-outline-light btn-lg">Voir la comparaison complète</a>
        </div>
    </div>
</section>

{# ====== 3.5 FONCTIONNALITES : 3 rangees texte / capture ====== #}
{% set rangees = [
    { titre: 'Éditeur visuel', texte: 'Rédigez vos articles avec un éditeur moderne. Texte, images, vidéos, code — tout en un.', icone: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>' },
    { titre: 'SEO intégré', texte: 'Meta tags, sitemap XML, Open Graph — votre site est optimisé pour les moteurs de recherche.', icone: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' },
    { titre: 'Personnalisation sans code', texte: 'Couleurs, polices et logo — personnalisez votre site sans toucher au code.', icone: '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>' },
] %}
<section class="home-features">
    <div class="container">
        <h2 class="home-section-title text-center">Une plateforme pensée pour vous faire gagner du temps</h2>
        {% for r in rangees %}
        <div class="home-feature-row{{ loop.index is even ? ' home-feature-row--inverse' }}">
            <div class="home-feature-row__text">
                <span class="home-feature-row__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">{{ r.icone|raw }}</svg></span>
                <h3 class="home-feature-row__title">{{ r.titre }}</h3>
                <p class="home-feature-row__desc">{{ r.texte }}</p>
            </div>
            <div class="home-feature-row__visual">
                {# TODO CONTENU : capture admin « {{ r.titre }} » (WebP, width/height, alt descriptif) #}
                <div class="cw-browser cw-browser--maquette" aria-hidden="true">
                    <div class="cw-browser__bar"><span class="cw-browser__dots"><i></i><i></i><i></i></span></div>
                    <div class="cw-browser__maquette">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">{{ r.icone|raw }}</svg>
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
        <ul class="home-features__more">
            <li><strong>Pages & Layouts</strong> — créez des pages vitrine avec différents layouts pour présenter vos services et votre activité.</li>
            <li><strong>Navigation flexible</strong> — organisez votre menu par glisser-déposer, avec sous-menus et liens personnalisés.</li>
            <li><strong>Contact & Notifications</strong> — formulaire de contact, commentaires et notifications email pour rester connectés à vos visiteurs.</li>
        </ul>
    </div>
</section>

{# ====== 3.6 COMMENT CA MARCHE : 4 etapes ====== #}
{# Textes repris des cartes de service (table service) ; les pages /service/* restent en ligne. #}
{% set etapes = [
    { titre: 'Vous remplissez le questionnaire', texte: 'Un questionnaire guidé : vous nous dites ce que vous voulez, on s’occupe de la technique.', lien: '/service/votre-site-est-pret-en-une-demi-journee' },
    { titre: 'On installe en ½ journée', texte: 'On installe, on personnalise, on met en ligne : nom de domaine, hébergement, sécurité compris.', lien: null },
    { titre: 'Vous écrivez, simplement', texte: 'Vous racontez votre métier, vos services, avec un éditeur simple comme Word. Pas besoin de coder.', lien: '/service/vous-gerez-votre-contenu-en-toute-autonomie' },
    { titre: 'En ligne, et on reste là', texte: 'Formation de 30 min, guide écrit et support continu : un seul interlocuteur pour vos questions.', lien: '/service/on-ne-vous-laisse-pas-seul-apres-la-livraison' },
] %}
<section class="home-steps">
    <div class="container">
        <div class="text-center">
            <h2 class="home-section-title">Comment ça se passe concrètement</h2>
            <p class="home-section-subtitle">De votre premier message à votre site en ligne, voici ce que vous allez vivre.</p>
        </div>
        <ol class="home-steps__list">
            {% for e in etapes %}
            <li class="home-steps__item">
                <span class="home-steps__num" aria-hidden="true">{{ loop.index }}</span>
                <h3 class="home-steps__title">{{ e.titre }}</h3>
                <p class="home-steps__text">{{ e.texte }}</p>
                {% if e.lien %}
                <a href="{{ e.lien }}" class="home-steps__link">En savoir plus<span class="visually-hidden"> : {{ e.titre|lower }}</span> &rarr;</a>
                {% endif %}
            </li>
            {% endfor %}
        </ol>
    </div>
</section>

{# ====== 3.7 TARIFS ====== #}
{# Prix valides par le brief du 2/11/2026. Puces reprises du tableau de /page/offres. #}
{% set offres = [
    { nom: 'Vitrine', accroche: 'Vos clients vous trouvent enfin sur Google', mois_ht: 30, mois_ttc: 36, install_ht: 450, install_ttc: 540, vedette: false,
      inclus: ['Pages personnalisées', 'SEO intégré', 'Formulaire de contact sécurisé', '6 thèmes + personnalisation', 'Hébergement + maintenance'] },
    { nom: 'Blog', accroche: 'Montrez votre expertise et attirez des clients', mois_ht: 35, mois_ttc: 42, install_ht: 550, install_ttc: 660, vedette: true,
      inclus: ['Toute l’offre Vitrine', 'Module Blog — articles, catégories, tags', 'Modules Services, FAQ et Réalisations', 'Hébergement + maintenance'] },
    { nom: 'Complet', accroche: 'Vendez en ligne sans aucune limite technique', mois_ht: 50, mois_ttc: 60, install_ht: 1250, install_ttc: 1500, vedette: false,
      inclus: ['Toute l’offre Blog', 'Module Catalogue', 'E-commerce Stripe — paiement sécurisé', 'Module Marketing'] },
] %}
<section class="home-pricing">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="home-section-title">Trois offres, trois prix, {{ _self.vague('zéro mauvaise surprise') }}</h2>
            <p class="home-pricing__subtitle">Pas de devis opaque, pas de coûts cachés. Vous savez exactement ce que vous payez et ce que vous obtenez.</p>
        </div>
        <div class="home-pricing__grid">
            {% for o in offres %}
            <div class="home-pricing__card{{ o.vedette ? ' home-pricing__card--popular' }}">
                {% if o.vedette %}<span class="home-pricing__badge">Le plus choisi</span>{% endif %}
                <div class="home-pricing__card-header">
                    <h3 class="home-pricing__card-title">{{ o.nom }}</h3>
                    <p class="home-pricing__card-audience">{{ o.accroche }}</p>
                </div>
                <div class="home-pricing__card-body">
                    <p class="home-pricing__amount">
                        <span class="home-pricing__amount-value">{{ o.mois_ht }} €</span>
                        <span class="home-pricing__amount-unit">HT / mois</span>
                        <span class="home-pricing__amount-ttc">soit {{ o.mois_ttc }} € TTC / mois</span>
                    </p>
                    <p class="home-pricing__setup">Installation : {{ o.install_ht }} € HT <span>({{ o.install_ttc }} € TTC)</span></p>
                    <ul class="home-pricing__list">
                        {% for i in o.inclus %}<li>{{ i }}</li>{% endfor %}
                    </ul>
                </div>
                <div class="home-pricing__card-footer">
                    <a href="/page/offres" class="btn {{ o.vedette ? 'btn-primary' : 'btn-outline-primary' }} w-100">Voir le détail<span class="visually-hidden"> de l'offre {{ o.nom }}</span></a>
                </div>
            </div>
            {% endfor %}
        </div>
        <div class="text-center mt-4">
            <a href="/page/offres" class="home-pricing__compare">Comparer toutes les offres &rarr;</a>
        </div>
    </div>
</section>

