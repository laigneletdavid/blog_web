{# ======================================================================
   ACCUEIL — LintellO
   Surcouche client, prioritaire sur le theme (voir home/index.html.twig).

   La home sert a decider : six blocs, chacun renvoie vers sa rubrique.
     1. Heros : promettre et faire commencer
     2. Ligne de preuves : rassurer, le detail est sur la page Confiance
     3. Trois outils
     4. Pour qui : trois publics, trois prix
     5. Apprendre et actualites : derniers articles, un par categorie
     6. FAQ : quatre questions, lues depuis le module FAQ

   Regles (spec vitrine) : une seule couleur, le bleu primaire ; aucun
   degrade ; le tricolore n'apparait que dans la pastille du heros.
   N'ecrire que ce qui est [livre] dans REFERENCE-LINTELLO.md.
   ====================================================================== #}
{% set lt_app = 'https://www.lintello.ai' %}

<div class="lt-home">

{# ====== 1. HEROS ====== #}
<section class="lt-hero">
    <div class="lt-container lt-hero__grid">
        <div class="lt-hero__text">
            <p class="lt-pill">
                <span class="lt-flag" aria-hidden="true"><span></span><span></span><span></span></span>
                Assistant IA français, hébergé à Strasbourg
            </p>
            <h1 class="lt-hero__title">Une IA simple et efficace. <span>Vos données restent en France.</span></h1>
            <p class="lt-hero__lead">Posez votre question, LintellO s'occupe du reste : il choisit seul le bon modèle, écrit avec vous et cherche sur le web sans vous pister.</p>
            <div class="lt-hero__actions">
                <a href="{{ lt_app }}/register" class="lt-btn lt-btn--primary lt-btn--lg">Commencer gratuitement</a>
                <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link">Voir les offres</a>
            </div>
            <p class="lt-hero__note">Offre Gratuite : 20 messages par jour avec l'IA du quotidien.</p>
        </div>

        <div class="lt-hero__visual">
            <div class="lt-chat" aria-label="Exemple de conversation avec LintellO" role="img">
                <div class="lt-chat__head">
                    <img src="{{ asset('images/lintello/icone-lintello.png') }}" alt="" width="22" height="22">
                    <span>Nouvelle conversation</span>
                </div>
                <div class="lt-chat__body" aria-hidden="true">
                    <div class="lt-chat__user">Mon fils ne comprend pas pourquoi le ciel est bleu. Tu peux lui expliquer simplement ?</div>
                    <div class="lt-chat__bot">
                        <p>Imagine que la lumière du Soleil est une boîte de crayons de toutes les couleurs.</p>
                        <p>En traversant l'air, le bleu rebondit beaucoup plus que le rouge. Il nous arrive alors de partout dans le ciel : c'est pour ça qu'on le voit bleu.</p>
                    </div>
                </div>
                <div class="lt-chat__foot" aria-hidden="true">
                    <div class="lt-chat__input">
                        <span>Écrivez votre message…</span>
                        <span class="lt-chat__send">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ====== 2. LIGNE DE PREUVES ====== #}
{% set proofs = [
    {label: 'Hébergé à Strasbourg', icon: 'M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z'},
    {label: 'IA française Mistral', icon: 'M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16M12 8v4l3 2'},
    {label: 'Chiffré en base', icon: 'M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3'},
    {label: 'Aucun pistage', icon: 'M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6zM4 4l16 16'},
] %}
<section class="lt-proofs" aria-label="Vos données">
    <div class="lt-container lt-proofs__inner">
        {% for p in proofs %}
            <div class="lt-proofs__item">
                <span class="lt-proofs__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ p.icon }}"/></svg>
                </span>
                <span>{{ p.label }}</span>
            </div>
        {% endfor %}
        <a href="{{ path('app_page_show', {slug: 'confiance'}) }}" class="lt-link">Tout savoir sur vos données →</a>
    </div>
</section>

{# ====== 3. TROIS OUTILS ====== #}
{% set tools = [
    {title: 'Le chat', lead: 'Il comprend le sens de votre demande et choisit seul le bon modèle.', icon: 'M5 5h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-5 4V6a1 1 0 0 1 1-1z'},
    {title: 'Les documents', lead: 'Une réponse devient un document que l’IA sait modifier avec vous.', icon: 'M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5M9 13h6M9 17h6'},
    {title: 'La recherche', lead: 'Une synthèse sourcée, sans que le site visité sache qui vous êtes.', icon: 'M11 5a6 6 0 1 0 0 12a6 6 0 1 0 0-12M20 20l-4.5-4.5'},
] %}
<section class="lt-section" id="outils">
    <div class="lt-container">
        <h2 class="lt-h2 lt-h2--narrow">Un chat, un éditeur, une recherche. Rien à régler.</h2>
        <div class="lt-cards lt-cards--300">
            {% for t in tools %}
                <div class="lt-card">
                    <span class="lt-card__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ t.icon }}"/></svg>
                    </span>
                    <h3 class="lt-card__title">{{ t.title }}</h3>
                    <p class="lt-card__lead">{{ t.lead }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ====== 4. POUR QUI ====== #}
{% set audiences = [
    {who: 'Étudiants', title: 'Comprendre ses cours, réviser, rédiger.', price: '4,99 €', per: 'TTC / mois', cta: 'LintellO pour les études', slug: 'etudiants'},
    {who: 'À la maison', title: 'Les démarches, les devoirs, les projets.', price: '9,90 €', per: 'TTC / mois', cta: 'LintellO à la maison', slug: 'particuliers'},
    {who: 'Pros', title: 'Écrire, analyser, coder au quotidien.', price: '19,90 €', per: 'HT / mois', cta: 'LintellO pour les pros', slug: 'professionnels'},
] %}
<section class="lt-section lt-section--grey">
    <div class="lt-container">
        <div class="lt-section__head">
            <h2 class="lt-h2">Pour vous, à votre prix.</h2>
            <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link">Comparer toutes les offres →</a>
        </div>
        <div class="lt-cards lt-cards--280">
            {% for a in audiences %}
                <a href="{{ path('app_page_show', {slug: a.slug}) }}" class="lt-card lt-card--link">
                    <span class="lt-eyebrow">{{ a.who }}</span>
                    <span class="lt-card__title lt-card__title--lg">{{ a.title }}</span>
                    <span class="lt-price">
                        <span class="lt-price__from">dès</span>
                        <span class="lt-price__amount">{{ a.price }}</span>
                        <span class="lt-price__per">{{ a.per }}</span>
                    </span>
                    <span class="lt-card__more">{{ a.cta }} →</span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

{# ====== 5. APPRENDRE ET ACTUALITES ======
   Un article par categorie, trois au plus, parmi ceux que fournit le
   controleur de la home. #}
{% set posts = [] %}
{% set seenCats = [] %}
{% for article in articles|default([]) %}
    {% set cat = article.categories|first %}
    {% set catKey = cat ? cat.id : 'sans-categorie' %}
    {% if catKey not in seenCats and posts|length < 3 %}
        {% set posts = posts|merge([article]) %}
        {% set seenCats = seenCats|merge([catKey]) %}
    {% endif %}
{% endfor %}
{% if posts|length > 0 %}
<section class="lt-section">
    <div class="lt-container">
        <div class="lt-section__head">
            <h2 class="lt-h2">Apprendre et actualités</h2>
            <a href="{{ path('app_article_show_all') }}" class="lt-link">Tous les contenus →</a>
        </div>
        <div class="lt-cards lt-cards--280">
            {% for article in posts %}
                {% set cat = article.categories|first %}
                <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="lt-post">
                    <span class="lt-post__media">
                        {% if article.featuredMedia %}
                            {{ responsive_img(article.featuredMedia, '(max-width: 768px) 100vw, 33vw', 'lt-post__img', null, false, article) }}
                        {% endif %}
                    </span>
                    <span class="lt-post__body">
                        {% if cat %}<span class="lt-eyebrow">{{ cat.name }}</span>{% endif %}
                        <span class="lt-post__title">{{ article.title }}</span>
                        <span class="lt-post__meta">{{ (article.publishedAt ?? article.createdAt)|format_date('long', locale='fr') }}</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 6. FAQ ======
   Les quatre premieres questions actives du module FAQ (ordre de l'admin). #}
{% set homeFaqs = faqs|default([])|slice(0, 4) %}
{% if homeFaqs|length > 0 %}
<section class="lt-section lt-faq" id="faq">
    <div class="lt-container lt-container--narrow">
        <h2 class="lt-h2">Questions fréquentes</h2>
        <div class="lt-faq__list">
            {% for faq in homeFaqs %}
                <details class="lt-faq__item"{% if loop.first %} open{% endif %}>
                    <summary class="lt-faq__q">
                        <span>{{ faq.question }}</span>
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <div class="lt-faq__a">{{ faq.content|raw }}</div>
                </details>
            {% endfor %}
        </div>
        <p class="lt-faq__more">D'autres questions ? <a href="{{ path('app_faq_index') }}">Toutes les questions</a> ou <a href="{{ path('app_article_show_all') }}">les guides</a>.</p>
    </div>
</section>
{% endif %}

</div>
