{# ====== HOME — Com Web Solutions (brief du 05/11/2026, Lot 3) ======
   Voix : « je », vouvoiement du lecteur. Charte et composants : client/theme.css.
   Choix de David (05/11/2026) :
   - pas de section chiffres (section 6 du brief) : aucun chiffre assez solide ;
   - appels d'offres gardes en offre 03 (« ça existe », David, 05/11/2026) ;
   - hero : « Je vends depuis 2000, je code depuis 2016 » (aligne sur la frise de Studio) ;
   - H1 : « Site internet et prospection commerciale » (le web d abord) = les mots que la cible cherche
     (« site internet » plutot que « web » ou « digital »).
   Positionnement du 09/11/2026 : trois piliers dans l'ordre Com, Web, Commerce.
   - H1 : « Site internet et visibilité locale » ;
   - section Com (4 modules) avant le web, commerce reduit a un bandeau Enleys ;
   - FAQ : 3 questions com a la place des 3 questions commerce (gardees sur /faq). #}
{% import 'client/_macros.html.twig' as m %}
{% set lienRdv = m.lien_rdv() %}
{# FAQ de la home : com + web, reponses reprises de /faq (ids en base) #}
{% set faqHomeIds = [13, 14, 15, 8, 12] %}
{% set lienCom = m.lien_com()|trim %}
{% set faqHome = [] %}
{% for id in faqHomeIds %}
    {% for faq in faqs|default([]) %}{% if faq.id == id %}{% set faqHome = faqHome|merge([faq]) %}{% endif %}{% endfor %}
{% endfor %}

{{ m.symbole_vague() }}

{# ====== 1. HERO ====== #}
<section class="home-hero cws-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <p class="home-hero__overtitle">Un seul interlocuteur · Comminges, Toulouse, Montpellier et toute l'Occitanie</p>
                <h1 class="home-hero__title">Site internet et visibilité locale&nbsp;: un seul objectif, vos nouveaux {{ m.vague('clients') }}.</h1>
                <p class="home-hero__desc">Je vends depuis 2000, je code depuis 2016. Aujourd'hui je mets les deux au service de votre entreprise&nbsp;: un site pensé pour être trouvé et pour faire venir des clients, pas seulement pour exister. Pas de jargon, pas de chargé de compte : un seul interlocuteur, du premier appel à la mise en ligne.</p>
                <div class="home-hero__actions">
                    <a href="{{ lienRdv }}" target="_blank" rel="noopener" class="btn btn-accent btn-lg">Prendre rendez-vous (gratuit)<span class="visually-hidden"> (nouvel onglet)</span></a>
                    <a href="#com" class="btn btn-outline-primary btn-lg">Voir ce que je fais</a>
                </div>
            </div>
            {% if site.heroImage %}
            <div class="col-lg-5">
                <div class="cws-hero__photo">
                    {{ responsive_img(site.heroImage, '(max-width: 991px) 100vw, 40vw', 'cws-hero__img', 'David Laignelet, Com Web Solutions', true) }}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</section>

{# ====== 2. ÇA VOUS PARLE ? ====== #}
<section class="home-features">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Les problèmes que je résous</span>
            <h2 class="home-section-title">Ça vous parle&nbsp;?</h2>
        </div>
        <div class="home-features__grid home-features__grid--3" data-controller="reveal" data-reveal-stagger-value="90">
            <a href="{{ lienCom }}" class="home-features__card home-features__card--link">
                <h3 class="home-features__title">«&nbsp;Personne ne nous trouve sur Google&nbsp;»</h3>
                <p class="home-features__desc">Votre fiche Google est vide ou pas à jour, votre site ne remonte pas, et vos concurrents apparaissent avant vous. Vos clients vous cherchent, mais ils trouvent les autres.</p>
                <span class="home-features__link">La com, dès {{ m.prix_com_fiche() }}&nbsp;€&nbsp;HT/mois →</span>
            </a>
            <a href="{{ lienCom }}" class="home-features__card home-features__card--link">
                <h3 class="home-features__title">«&nbsp;Notre site ne nous rapporte rien&nbsp;»</h3>
                <p class="home-features__desc">Il est en ligne, il est «&nbsp;joli&nbsp;», mais personne ne vous contacte depuis. Un site sans contenu ni animation reste invisible&nbsp;: il ne fait pas venir de clients tout seul.</p>
                <span class="home-features__link">Le faire vivre →</span>
            </a>
            <a href="/page/pourquoi-un-seul-interlocuteur" class="home-features__card home-features__card--link">
                <h3 class="home-features__title">«&nbsp;Notre agence web ne comprend pas notre business&nbsp;»</h3>
                <p class="home-features__desc">Votre agence parle pixels et responsive. Vous, vous parlez clients et chiffre d'affaires. Personne ne fait le lien entre ce que vous vendez et ce que votre site raconte. Résultat&nbsp;: un joli site qui ne vous amène personne.</p>
                <span class="home-features__link">Pourquoi un seul interlocuteur →</span>
            </a>
        </div>
    </div>
</section>

{# ====== 3. BLOC SIGNATURE (fonce) ====== #}
<section class="cws-section cws-section--dark cws-signature">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Pourquoi un seul interlocuteur</span>
            <h2 class="home-section-title">Votre site et ce qui le fait vivre, pensés ensemble.</h2>
        </div>
        <div class="cws-signature__grid">
            <div class="cws-signature__col">
                <h3>La com</h3>
                <p>Faire vivre votre présence en ligne chaque mois&nbsp;: fiche Google, blog, réseaux, Google et les IA. Avec un vrai suivi des résultats.</p>
            </div>
            <div class="cws-signature__lien" data-controller="wave-draw">
                <span class="cws-signature__axe" aria-hidden="true"><span class="vague__clip"><svg class="vague__trait" viewBox="0 0 200 20" preserveAspectRatio="none"><use href="#bw-vague"/></svg></span></span>
                <span class="cws-signature__label">Un seul interlocuteur</span>
            </div>
            <div class="cws-signature__col">
                <h3>Le web</h3>
                <p>Des sites et des outils qui servent à vendre, pas à faire joli. Je les conçois et je les code moi-même.</p>
            </div>
        </div>
        {# Chargee de com : emplacement pret, affiche quand David le decide
           (m.chargee_com_presentee). Photo, prenom et deux lignes a fournir : rien d'invente. #}
        {% if m.chargee_com_presentee()|trim is not empty %}
        <div class="cws-equipe">
            {# TODO CONTENU : photo (public/images/equipe/chargee-com.webp), prenom, deux lignes #}
            <p class="cws-equipe__texte"><strong>[Prénom]</strong>, chargée de communication&nbsp;: [deux lignes de présentation].</p>
        </div>
        {% endif %}
        <p class="cws-signature__more"><a href="/page/pourquoi-un-seul-interlocuteur">Pourquoi c'est plus efficace <span class="cw-arrow" aria-hidden="true">→</span></a></p>
    </div>
</section>

{# ====== 3 bis. LA COM (brief du 09/11/2026) ======
   Avant le web. Memes cartes que les marches du web, sur une grille plate :
   les modules se combinent, ce ne sont pas des paliers. Prix : client/_macros. #}
{% set modulesCom = [
    { nom: 'Fiche Google', titre: 'Être trouvé sur Google', texte: 'Publications, réponses aux avis, informations à jour.', prix: m.prix_com_fiche(), engagement: 'Sans engagement' },
    { nom: 'Blog', titre: 'Publier des articles qui attirent', texte: '2 articles par mois, écrits pour Google et pour les IA.', prix: m.prix_com_blog(), engagement: 'Engagement 3 mois' },
    { nom: 'Réseaux', titre: 'Animer vos réseaux', texte: '8 à 12 posts par mois sur 2 réseaux, textes et visuels fournis.', prix: m.prix_com_reseaux(), engagement: 'Engagement 3 mois' },
    { nom: 'SEO + GEO', titre: 'Être visible sur Google et dans les IA', texte: 'Audit, optimisations, suivi des positions et des citations dans ChatGPT, Perplexity…', prix: m.prix_com_seo(), engagement: 'Engagement 6 mois' },
] %}
<section class="cws-section cws-section--alt" id="com">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">La com</span>
            <h2 class="home-section-title">Être trouvé, publier, animer&nbsp;: on fait vivre votre présence en ligne</h2>
            <p>Vous choisissez les modules dont vous avez besoin, on s'occupe du reste chaque mois, avec un rapport clair.</p>
            <p class="cws-section__prix">Dès {{ m.prix_com_fiche() }}&nbsp;€&nbsp;HT/mois</p>
        </div>
        <ul class="cws-cartes cws-cartes--4 cws-modules" data-controller="reveal" data-reveal-stagger-value="90">
            {% for mod in modulesCom %}
            <li class="cws-marche cws-module">
                <span class="cws-marche__etiquette">{{ mod.nom }}</span>
                <h3 class="cws-marche__titre">{{ mod.titre }}</h3>
                <p>{{ mod.texte|insecables }}</p>
                <ul class="cws-puces">
                    <li>{{ mod.prix }}&nbsp;€&nbsp;HT/mois</li>
                    <li>{{ mod.engagement }}</li>
                </ul>
            </li>
            {% endfor %}
        </ul>
        <p class="cws-signature__more"><a href="{{ lienCom }}" class="cws-offre__lien">Composer mon offre <span class="cw-arrow" aria-hidden="true">→</span></a></p>
    </div>
</section>

{# ====== 4. OFFRES WEB EN ESCALIER (brief du 05/11/2026) ======
   Trois marches d'un parcours : un site, puis une application, puis l'IA, avec le
   meme interlocuteur. Premiere section d'offres : ancre #offres du hero.
   Desktop : marches decalees de 0 / 40 / 80 px par la grille (meme hauteur pour
   les trois, aucun transform : reveal reste libre), vague en diagonale derriere.
   Mobile : marches empilees, trait vertical orange a gauche. #}
{% set iaApiDisponible = m.ia_api_disponible()|trim is not empty %}
{% set chatbotDisponible = m.chatbot_disponible()|trim is not empty %}
<section class="cws-section" id="offres">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Le web</span>
            <h2 class="home-section-title">On commence simple, on va plus loin quand vous êtes prêt</h2>
            <p>Un site pour être trouvé, une application quand vos outils ne suivent plus, l'IA pour gagner du temps. Vous avancez à votre rythme, avec le même interlocuteur.</p>
        </div>
        <div class="cws-escalier">
            <div class="cws-escalier__vague" data-controller="wave-draw" aria-hidden="true">
                <span class="vague__clip"><svg class="vague__trait" viewBox="0 0 200 20" preserveAspectRatio="none"><use href="#bw-vague"/></svg></span>
                {% for i in 1..2 %}<svg class="cws-pointe cws-pointe--{{ i }}" viewBox="0 0 12 16"><path d="M2 2 L10 8 L2 14" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>{% endfor %}
            </div>
            <ol class="cws-escalier__marches" data-controller="reveal" data-reveal-stagger-value="120">
                <li class="cws-marche cws-marche--1">
                    <span class="cws-marche__etiquette">01 · Démarrer</span>
                    <h3 class="cws-marche__titre">Votre site professionnel</h3>
                    <p>Un site vitrine, un blog ou la vente en ligne sur ComWeb Studio, le CMS que j'ai conçu. En ligne en 48 h, hébergé en France, sans WordPress.</p>
                    <ul class="cws-puces">
                        <li>Prix fixe, dès 450 € HT</li>
                        <li>Vous modifiez vos textes vous-même</li>
                        <li>Prêt pour Google</li>
                        <li>Option&nbsp;: <a href="{{ lienCom }}">on le fait vivre pour vous</a></li>
                    </ul>
                    <a href="/service/votre-site-web" class="cws-carte__lien">Votre site web <span class="cw-arrow" aria-hidden="true">→</span></a>
                </li>
                <li class="cws-marche cws-marche--2">
                    <span class="cws-marche__etiquette">02 · Aller plus loin</span>
                    <h3 class="cws-marche__titre">Votre application sur mesure</h3>
                    <p>Quand aucun logiciel du marché ne colle à votre façon de travailler&nbsp;: CRM métier, outil de gestion, plateforme interne. Je la conçois et je la code pour vous.</p>
                    <ul class="cws-puces">
                        <li>Développée sur mesure</li>
                        <li>Évolutive avec votre activité</li>
                        <li>Référence&nbsp;: Kayre</li>
                    </ul>
                    <a href="/service/applications-sur-mesure" class="cws-carte__lien">Applications sur mesure <span class="cw-arrow" aria-hidden="true">→</span></a>
                </li>
                <li class="cws-marche cws-marche--3">
                    <span class="cws-marche__etiquette">03 · Automatiser</span>
                    <h3 class="cws-marche__titre">L'IA dans votre entreprise</h3>
                    <p>{% if chatbotDisponible %}Une IA française et confidentielle pour votre équipe, un assistant sur votre site, puis l'IA connectée directement à vos outils.{% else %}Une IA française et confidentielle pour votre équipe, puis l'IA connectée directement à vos outils.{% endif %}</p>
                    <ul class="cws-puces">
                        <li>Hébergée en France</li>
                        <li>Équipe formée sur vos cas réels</li>
                        <li>Connexion à vos outils{% if not iaApiDisponible %} <span class="cws-badge">Début 2027</span>{% endif %}</li>
                    </ul>
                    <a href="/service/integration-ia-entreprise" class="cws-carte__lien">L'IA en entreprise <span class="cw-arrow" aria-hidden="true">→</span></a>
                </li>
            </ol>
        </div>
    </div>
</section>

{# ====== 7. OUTILS DE LA MAISON (fonce) ======
   Logos a fournir : en attendant, les noms en texte. #}
<section class="cws-section cws-section--dark">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Conçus ici</span>
            <h2 class="home-section-title">Les outils de la maison</h2>
            <p>Je développe mes propres outils, et mes clients en profitent les premiers.</p>
        </div>
        <div class="cws-cartes" data-controller="reveal" data-reveal-stagger-value="90">
            <a href="{{ m.lien_studio() }}" target="_blank" rel="noopener" class="cws-carte cws-card-dark">
                <h3>ComWeb Studio</h3>
                <p>Le CMS français pour les artisans, commerçants et indépendants. Votre site en 48 h, sans WordPress.</p>
                <span class="cws-carte__lien">Découvrir ComWeb Studio<span class="visually-hidden"> (nouvel onglet)</span> <span class="cw-arrow" aria-hidden="true">→</span></span>
            </a>
            <a href="{{ m.lien_lintello() }}" target="_blank" rel="noopener" class="cws-carte cws-card-dark">
                <h3>LintellO</h3>
                <p>L'IA française et confidentielle. Hébergée en France, vos données ne servent jamais à entraîner les modèles.</p>
                <span class="cws-carte__lien">Découvrir LintellO<span class="visually-hidden"> (nouvel onglet)</span> <span class="cw-arrow" aria-hidden="true">→</span></span>
            </a>
        </div>
    </div>
</section>

{# ====== 5. LE COMMERCE, EN RETRAIT (09/11/2026) ======
   Bandeau apres le web : Enleys a sa propre com. Les 3 fiches commerce restent
   en ligne, accessibles par la page Developpement commercial et le pied de page.
   Ancre #commerce gardee : fil d'Ariane des pages commerce. #}
<section class="cws-section cws-section--bandeau" id="commerce">
    <div class="container">
        <div class="cws-bandeau">
            <div>
                <p class="cws-bandeau__titre">Besoin de prospection B2B&nbsp;?</p>
                <p>En Occitanie, je travaille en partenariat avec le réseau <a href="{{ m.lien_enleys() }}" target="_blank" rel="noopener">Enleys <span aria-hidden="true">&#x2197;&#xFE0E;</span><span class="visually-hidden"> (nouvel onglet)</span></a>&nbsp;: prospection, direction commerciale externalisée, appels d'offres.</p>
            </div>
            <a href="/page/developpement-commercial" class="cws-offre__lien">Développement commercial <span class="cw-arrow" aria-hidden="true">→</span></a>
        </div>
    </div>
</section>

{# ====== 6. CHIFFRES : retiree (decision David, 05/11/2026) ====== #}

{# ====== 8. TEMOIGNAGES ======
   Titre en base : « Nom — Entreprise » (entreprise facultative).
   Jusqu'a 6 (09/11/2026) : de la place pour les futurs temoignages com,
   a ajouter en base (galerie, emplacement testimonial). Rien d'invente. #}
{% set testimonials = site.getGalleryBySlot('testimonial') %}
{% if testimonials|length > 0 %}
<section class="home-testimonials">
    <div class="container">
        <div class="cws-section__head">
            <h2 class="home-section-title">Ils ont travaillé avec moi</h2>
        </div>
        <div class="cws-temoignages" data-controller="reveal" data-reveal-stagger-value="90">
            {% for item in testimonials|slice(0, 6) %}
            {% set parts = item.title|default('')|split(' — ', 2) %}
            <figure class="cws-temoignage">
                <span class="cws-temoignage__guillemet" aria-hidden="true">“</span>
                <blockquote class="cws-temoignage__texte"><p>{{ item.content }}</p></blockquote>
                <figcaption class="cws-temoignage__auteur">
                    <strong>{{ parts|first }}</strong>
                    {% if parts|length > 1 %}<span>{{ parts|last }}</span>{% endif %}
                </figcaption>
            </figure>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 9. FAQ COURTE ====== #}
{% if faqHome|length > 0 %}
<section class="home-faq cws-section">
    <div class="container">
        <div class="cws-section__head cws-section__head--centre">
            <h2 class="home-section-title">Questions fréquentes</h2>
        </div>
        <div class="cws-faq">
            <div class="accordion faq-accordion" id="faq-home">
                {% for faq in faqHome %}
                <div class="accordion-item">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-home-{{ faq.id }}" aria-expanded="false" aria-controls="faq-home-{{ faq.id }}">{{ faq.question|insecables }}</button>
                    </h3>
                    <div id="faq-home-{{ faq.id }}" class="accordion-collapse collapse" data-bs-parent="#faq-home">
                        <div class="accordion-body content-body">{{ faq.content|raw }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
            <p class="cws-faq__plus"><a href="{{ path('app_faq_index') }}">Voir toutes les questions <span class="cw-arrow" aria-hidden="true">→</span></a></p>
        </div>
    </div>
</section>
{% set faqJson = [] %}
{% for faq in faqHome %}
    {% set faqJson = faqJson|merge([{ '@type': 'Question', 'name': faq.question, 'acceptedAnswer': { '@type': 'Answer', 'text': faq.content|striptags|replace({'&#039;': "'", '&nbsp;': ' '})|trim } }]) %}
{% endfor %}
<script type="application/ld+json">{{ { '@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faqJson }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endif %}

{# ====== 9 bis. DERNIER ARTICLE (06/11/2026) ======
   Affiche le dernier article publie (un article « à la une » passe devant).
   Rien tant qu'aucun article n'est publie. Fond gris entre la FAQ (blanche) et
   l'appel final (fonce). #}
{% set dernier = articles|default([])|first %}
{% if dernier %}
{% set dateArticle = dernier.publishedAt ?? dernier.createdAt %}
<section class="cws-section cws-section--alt cws-dernier-article">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Le blog</span>
            <h2 class="home-section-title">Le dernier article</h2>
        </div>
        <article class="cws-article-carte">
            {% if dernier.featuredMedia %}
            <a href="{{ path('app_article_show', { slug: dernier.slug }) }}" class="cws-article-carte__image" tabindex="-1" aria-hidden="true">
                {{ responsive_img(dernier.featuredMedia, '(max-width: 767px) 100vw, 40vw', 'cws-article-carte__img', dernier.featuredMedia.alt|default(dernier.title)) }}
            </a>
            {% endif %}
            <div class="cws-article-carte__corps">
                <p class="cws-article-carte__meta">
                    {% if dernier.categories|length > 0 %}<span>{{ dernier.categories|first.name }}</span> · {% endif %}
                    <time datetime="{{ dateArticle|date('Y-m-d') }}">{{ dateArticle|format_date('long', locale='fr') }}</time>
                    · {{ dernier.content|readingTime }} min de lecture
                </p>
                <h3 class="cws-article-carte__titre"><a href="{{ path('app_article_show', { slug: dernier.slug }) }}">{{ dernier.title|insecables }}</a></h3>
                {% if dernier.featuredText %}<p class="cws-article-carte__resume">{{ dernier.featuredText|striptags|u.truncate(220, '…', false) }}</p>{% endif %}
                <p class="cws-article-carte__liens">
                    <a href="{{ path('app_article_show', { slug: dernier.slug }) }}" class="cws-offre__lien">Lire l'article<span class="visually-hidden"> : {{ dernier.title }}</span> <span class="cw-arrow" aria-hidden="true">→</span></a>
                    <a href="{{ path('app_article_show_all') }}" class="cws-article-carte__tous">Tous les articles</a>
                </p>
            </div>
        </article>
    </div>
</section>
{% endif %}

{# ====== 10. CTA FINAL (partiel commun avec les fiches services) ====== #}
{% include 'client/_cta_final.html.twig' %}
