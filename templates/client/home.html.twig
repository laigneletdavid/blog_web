{# ====== 6. OFFRES ======
   Le public titre la carte, le nom d'offre accompagne le prix.
   "des" seulement quand la carte regroupe plusieurs offres (Pros).
   La carte Pros est mise en avant (cible prioritaire de l'accueil : TPE/PME). #}
{% set audiences = [
    {who: 'Pros', title: 'Rédiger, analyser, gérer vos dossiers clients.', offer: 'Offres Pro et LintellO', benefit: '9 modes métier, modèles Compte rendu et Fiche produit, export Word et PDF.', from: true, highlight: true, price: '19,90 €', per: 'HT / mois', cta: 'LintellO pour les pros', slug: 'professionnels'},
    {who: 'À la maison', title: 'Les démarches, les devoirs, les projets.', offer: 'Offre Perso', benefit: 'Les modes du quotidien et l’aide aux devoirs, pour toute la maison.', from: false, price: '9,90 €', per: 'TTC / mois', cta: 'LintellO à la maison', slug: 'particuliers'},
    {who: 'Études', title: 'Comprendre ses cours, réviser, rédiger.', offer: 'Offre Étudiant', benefit: '5 modes pour apprendre, sans faire le devoir à votre place.', from: false, price: '4,99 €', per: 'TTC / mois', cta: 'LintellO pour les études', slug: 'etudiants'},
] %}
<section class="lt-section lt-section--grey">
    <div class="lt-container">
        <div class="lt-section__head">
            <h2 class="lt-h2">Une offre pour chaque usage.</h2>
            <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link">Comparer toutes les offres →</a>
        </div>
        <div class="lt-cards lt-cards--280">
            {% for a in audiences %}
                <a href="{{ path('app_page_show', {slug: a.slug}) }}" class="lt-card lt-card--link{{ a.highlight|default(false) ? ' lt-card--highlight' }}">
                    <span class="lt-eyebrow">{{ a.who }}</span>
                    <span class="lt-card__title lt-card__title--lg">{{ a.title }}</span>
                    <span class="lt-card__offer">{{ a.offer }}</span>
                    <span class="lt-card__benefit">{{ a.benefit }}</span>
                    <span class="lt-price">
                        {% if a.from %}<span class="lt-price__from">dès</span>{% endif %}
                        <span class="lt-price__amount">{{ a.price }}</span>
                        <span class="lt-price__per">{{ a.per }}</span>
                    </span>
                    <span class="lt-card__more">{{ a.cta }} →</span>
                </a>
            {% endfor %}
        </div>
        <p class="lt-offers__free">Pas encore décidé ? <a href="{{ lt_app }}/register">Commencez gratuitement</a> : 20 messages par jour, sans engagement.</p>
    </div>
</section>

{# ====== 7. APPRENDRE ET ACTUALITES ======
   Un article par categorie, trois au plus, parmi ceux que fournit le
   controleur de la home. #}
{% set posts = [] %}
{% set seenCats = [] %}
{% for article in articles|default([]) %}
    {% set cat = article.categories|first %}
    {% set catKey = cat ? cat.id : 'sans-categorie' %}
    {% if catKey not in seenCats and posts|length < 3 %}
        {% set posts = posts|merge([article]) %}
        {% set seenCats = seenCats|merge([catKey]) %}
    {% endif %}
{% endfor %}
{% if posts|length > 0 %}
<section class="lt-section">
    <div class="lt-container">
        <div class="lt-section__head">
            <h2 class="lt-h2">Apprendre et actualités</h2>
            <a href="{{ path('app_article_show_all') }}" class="lt-link">Tous les contenus →</a>
        </div>
        <div class="lt-cards lt-cards--280">
            {% for article in posts %}
                {% set cat = article.categories|first %}
                <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="lt-post">
                    <span class="lt-post__media">
                        {% if article.featuredMedia %}
                            {{ responsive_img(article.featuredMedia, '(max-width: 768px) 100vw, 33vw', 'lt-post__img', null, false, article) }}
                        {% endif %}
                    </span>
                    <span class="lt-post__body">
                        {% if cat %}<span class="lt-eyebrow">{{ cat.name }}</span>{% endif %}
                        <span class="lt-post__title">{{ article.title }}</span>
                        <span class="lt-post__meta">{{ lt.date_fr(article.publishedAt ?? article.createdAt) }}</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 8. FAQ ======
   Les cinq premieres questions actives du module FAQ (ordre de l'admin). #}
{% set homeFaqs = faqs|default([])|slice(0, 5) %}
{% if homeFaqs|length > 0 %}
<section class="lt-section lt-faq" id="faq">
    <div class="lt-container lt-container--narrow">
        <h2 class="lt-h2">Questions fréquentes</h2>
        <div class="lt-faq__list">
            {% for faq in homeFaqs %}
                <details class="lt-faq__item"{% if loop.first %} open{% endif %}>
                    <summary class="lt-faq__q">
                        <span>{{ faq.question }}</span>
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <div class="lt-faq__a">{{ faq.content|raw }}</div>
                </details>
            {% endfor %}
        </div>
        <p class="lt-faq__more">D'autres questions ? <a href="{{ path('app_faq_index') }}">Toutes les questions</a> ou <a href="{{ path('app_article_show_all') }}">les guides</a>.</p>
    </div>
</section>
{% endif %}

