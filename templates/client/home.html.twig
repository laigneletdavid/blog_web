{# ======================================================================
   HOME — Maître Mainguy, notaire à Saint-Martory
   Override client : ce fichier est prioritaire sur themes/*/home.html.twig
   et sur home/_home_generic.html.twig (voir templates/home/index.html.twig).

   Structure transposée de blnotaires.fr (site de référence du client) :
     1. Hero        — visuel plein écran, titre display, « Continuer »
     2. Expertises  — chapô + 2 portes d'entrée
     3. L'Office    — présentation + ancrage territorial
     4. Valeurs     — bande sombre pleine largeur
     5. Le notaire  — portrait + accroche (remplace l'équipe : office individuel)
     6. Actualités  — module blog
     7. Contact     — bande finale

   Les textes proviennent du verbatim de l'ancien site bm-notaire.fr, recupere
   via son API WordPress. Profession reglementee : a faire revalider par
   l'office avant mise en ligne.
   ====================================================================== #}

{# ====== 1. HERO ====== #}
<section class="home-hero bw-hero"
    {% if site.heroImage %}
    style="--hero-bg-image: url('{{ asset('documents/medias/' ~ (site.heroImage.webpFileName ?? site.heroImage.fileName)) }}')"
    {% endif %}>
    {# Video de fond fournie par l'office. L'image hero sert d'affiche : elle
       s'affiche immediatement, la video prend le relais une fois chargee.
       Masquee sous 768px, ou elle couterait 7 Mo de donnees mobiles. #}
    <video class="bw-hero__video" autoplay muted loop playsinline preload="metadata"
           {% if site.heroImage %}poster="{{ asset('documents/medias/' ~ (site.heroImage.webpFileName ?? site.heroImage.fileName)) }}"{% endif %}
           aria-hidden="true" tabindex="-1">
        <source src="{{ asset('documents/medias/hero-bm-notaire.mp4') }}" type="video/mp4">
    </video>
    <div class="home-hero__overlay"></div>
    <div class="container position-relative">
        <div class="home-hero__content bw-hero__content">
            <h1 class="bw-hero__title">
                <span class="bw-hero__kicker">Office notarial</span>
                <span class="bw-hero__place">{{ site.town|default('Saint-Martory') }}</span>
            </h1>
            <p class="bw-hero__tagline">Anticiper les événements de votre vie en toute sérénité</p>
            <div class="bw-hero__actions">
                <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">Prendre rendez-vous</a>
                {% if services|default([])|length > 0 %}
                <a href="{{ path('app_service_index') }}" class="btn btn-outline-primary btn-lg">Nos expertises</a>
                {% else %}
                <a href="#expertises" class="btn btn-outline-primary btn-lg">Nos expertises</a>
                {% endif %}
            </div>
        </div>
    </div>
    <a href="#expertises" class="bw-hero__continue">
        <span>Continuer</span>
        <span class="bw-hero__continue-line" aria-hidden="true"></span>
    </a>
</section>

{# ====== 2. EXPERTISES ====== #}
<section class="bw-expertises" id="expertises">
    <div class="container">
        <div class="bw-section-header">
            <span class="bw-eyebrow">Expertises</span>
            <h2 class="bw-section-title">BM Notaire vous accompagne dans tous vos projets</h2>
            <p class="bw-section-intro">
                Notre raison d’être est de vous permettre d’anticiper tous les événements
                de votre vie en toute sérénité.
            </p>
        </div>

        {% if services|default([])|length > 0 %}
            {% include '_partials/_services_grid.html.twig' with { services: services } %}
        {% else %}
            {# FALLBACK — remplacé automatiquement dès que des services sont créés
               dans Admin > Services. Contenu BROUILLON issu du cache du site client. #}
            <div class="bw-doors">
                <article class="bw-door">
                    <span class="bw-door__index">01</span>
                    <h3 class="bw-door__title">Vous achetez pour la première fois</h3>
                    <p class="bw-door__text">
                        Chaque étape vous est expliquée, sans jargon, pour aborder votre acquisition
                        avec sérénité et en connaissance de cause.
                    </p>
                    <a href="{{ path('app_contact') }}" class="bw-door__link">Accéder</a>
                </article>
                <article class="bw-door">
                    <span class="bw-door__index">02</span>
                    <h3 class="bw-door__title">Vous investissez</h3>
                    <p class="bw-door__text">
                        Sécurisation de vos montages, conseil patrimonial et préparation de la
                        transmission, au service de vos objectifs de long terme.
                    </p>
                    <a href="{{ path('app_contact') }}" class="bw-door__link">Accéder</a>
                </article>
            </div>
        {% endif %}
    </div>
</section>

{# ====== 3. L'OFFICE ====== #}
<section class="bw-office">
    <div class="container">
        <div class="bw-office__grid">
            <div class="bw-office__visual">
                {% if site.aboutImage %}
                    {{ responsive_img(site.aboutImage, '(max-width: 991px) 100vw, 45vw', 'bw-office__img', site.name|default(''), false, site) }}
                {% else %}
                <div class="bw-office__img bw-office__img--placeholder" aria-hidden="true"></div>
                {% endif %}
            </div>
            <div class="bw-office__content">
                <span class="bw-eyebrow">L'Office</span>
                <h2 class="bw-section-title">Sur l’Office</h2>
                <p class="bw-office__text">
                    L’Étude vous reçoit au 379 rue des Villas. L’office BM Notaire a conscience que ses
                    clients évoluent dans un environnement toujours plus complexe et mouvant. Il est
                    garant de la sécurité juridique et apporte son expertise dans l’élaboration des
                    contrats qui lui sont confiés.
                </p>
                {% if site.town %}
                <p class="bw-office__location">
                    <span class="bw-eyebrow">Implantation</span>
                    {{ site.town }}{% if site.postCode %} — {{ site.postCode }}{% endif %}
                </p>
                {% endif %}
                <a href="{{ path('app_contact') }}" class="bw-link-arrow">Nous rencontrer</a>
            </div>
        </div>
    </div>
</section>

{# ====== 4. VALEURS (bande sombre) ====== #}
<section class="bw-values">
    <div class="container">
        <p class="bw-values__quote">
            L’accompagnement avec humanité, rendre le droit accessible au plus grand nombre :
            ce sont les qualités qui traduisent notre philosophie.
        </p>
        <ul class="bw-values__list">
            <li>Humanité</li>
            <li>Écoute attentive</li>
            <li>Réactivité</li>
            <li>Empathie</li>
        </ul>
    </div>
</section>

{# ====== 5. LE NOTAIRE ====== #}
<section class="bw-notary">
    <div class="container">
        <div class="bw-section-header bw-section-header--center">
            <span class="bw-eyebrow">Le notaire</span>
            <h2 class="bw-section-title">Un office moderne</h2>
        </div>
        <div class="bw-notary__card">
            <div class="bw-notary__portrait">
                {% if site.contactImage %}
                    {{ responsive_img(site.contactImage, '(max-width: 767px) 100vw, 320px', 'bw-notary__img', site.name|default(''), false, site) }}
                {% else %}
                <div class="bw-notary__img bw-notary__img--placeholder" aria-hidden="true"></div>
                {% endif %}
            </div>
            <div class="bw-notary__body">
                <h3 class="bw-notary__name">{{ site.name|default('') }}</h3>
                <span class="bw-notary__role">Notaire{% if site.town %} à {{ site.town }}{% endif %}</span>
                <p class="bw-notary__text">
                    L’Office met à disposition ses nouvelles technologies : signature des actes sur
                    support électronique, visioconférence, procuration à distance. Soucieux de
                    l’environnement, nous privilégions une gestion dématérialisée des actes.
                </p>
                <a href="{{ path('app_contact') }}" class="bw-link-arrow">Prendre rendez-vous</a>
            </div>
        </div>
    </div>
</section>

{# ====== 6. ACTUALITES ====== #}
{% if articles|default([])|length > 0 %}
<section class="home-articles bw-news">
    <div class="container">
        <div class="bw-news__header">
            <div>
                <span class="bw-eyebrow">Actualités</span>
                <h2 class="bw-section-title">Les publications de l'Étude</h2>
            </div>
            <a href="{{ path('app_article_show_all') }}" class="bw-link-arrow">Toutes les actualités</a>
        </div>
        <div class="row">
            {% include 'article/article_liste.html.twig' with { articles } %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 7. CONTACT ====== #}
<section class="home-cta bw-contact">
    <div class="container text-center">
        <h2 class="home-cta__title">Un projet ? Une question ?</h2>
        <p class="home-cta__desc">
            N’hésitez pas à nous contacter. Le conseil est gratuit : nous avons à cœur de fournir
            un accompagnement de qualité et d’établir une relation de confiance.
        </p>
        <a href="{{ path('app_contact') }}" class="btn btn-light btn-lg">Prendre rendez-vous</a>
    </div>
</section>
