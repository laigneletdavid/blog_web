{# ======================================================================
   ACCUEIL — LintellO
   Surcouche client, prioritaire sur le theme (voir home/index.html.twig).

   Ordre des sections (handoff vitrine v0.1, partie 2, section 10) :
     1. Heros : promettre et faire commencer
     2. Nos engagements : vos donnees, le detail est sur la page Confiance
     3. Tout est relie : quatre outils autour des projets (carrousel, onglets sur mobile)
     4. (Temoignages : a venir, composant BlogWeb)
     5. Qui est derriere
     6. Offres : trois publics, trois prix
     7. Apprendre et actualites : derniers articles, un par categorie
     8. FAQ : cinq questions, lues depuis le module FAQ
     9. Appel final : aplat bleu clair, inscription et offres

   Regles : une seule couleur, le bleu primaire ; aucun degrade ; le
   tricolore n'apparait que dans la pastille du heros. Aucun fournisseur
   nomme (moteur IA, recherche, hebergeur, paiement).
   ====================================================================== #}
{% set lt_app = 'https://www.lintello.ai' %}
{% import 'client/_macros.html.twig' as lt %}

<div class="lt-home">

{# ====== 1. HEROS ====== #}
<section class="lt-hero">
    <div class="lt-container lt-hero__grid">
        <div class="lt-hero__text">
            <p class="lt-pill">
                <span class="lt-flag" aria-hidden="true"><span></span><span></span><span></span></span>
                Votre intello personnel, 100&nbsp;% français
            </p>
            <h1 class="lt-hero__title lt-hero__title--home">Une IA simple et efficace qui travaille avec vous. <span>Vos données restent chez vous.</span></h1>
            <p class="lt-hero__lead">Rédigez vos documents, répondez à vos clients, cherchez sur le web : LintellO vous fait gagner du temps, chaque jour.</p>
            <div class="lt-hero__actions">
                <a href="{{ lt_app }}/register" class="lt-btn lt-btn--primary lt-btn--lg">Commencer gratuitement</a>
                <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link">Voir les offres</a>
            </div>
            <p class="lt-hero__note">Offre Gratuite : 20 messages par jour, sans engagement.</p>
        </div>

        {# Maquette de l'editeur de documents : un cas TPE, un passage
           surligne et la demande de reprise. Decor, sans contenu lisible
           par les lecteurs d'ecran au-dela de sa description. #}
        <div class="lt-hero__visual">
            <div class="lt-editor" role="img" aria-label="Exemple : un compte rendu de réunion dans l'éditeur de LintellO, avec un paragraphe surligné et la demande « Rends ce paragraphe plus clair pour le client »">
                <div class="lt-editor__head" aria-hidden="true">
                    <img src="{{ asset('images/lintello/icone-lintello.png') }}" alt="" width="22" height="22">
                    <span class="lt-editor__file">Compte rendu — Réunion client</span>
                    <span class="lt-editor__tools">
                        <span>B</span><span><i>I</i></span><span>H2</span>
                    </span>
                </div>
                <div class="lt-editor__page" aria-hidden="true">
                    <p class="lt-editor__title">Compte rendu de réunion</p>
                    <p class="lt-editor__meta">Projet de rénovation · 14 octobre</p>
                    <p>Points abordés : planning des travaux, choix des matériaux, budget.</p>
                    <p><mark>Compte tenu des contraintes d'approvisionnement évoquées, le démarrage initialement prévu fait l'objet d'un report dont la durée reste à confirmer.</mark></p>
                    <p class="lt-editor__line"></p>
                    <p class="lt-editor__line lt-editor__line--short"></p>
                </div>
                <div class="lt-editor__ask" aria-hidden="true">
                    <span>Rends ce paragraphe plus clair pour le client</span>
                    <span class="lt-chat__send">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

{# ====== 2. NOS ENGAGEMENTS ====== #}
{% set commitments = [
    {title: 'En France, de bout en bout', text: 'Un moteur IA français, des serveurs à Strasbourg, une recherche web européenne.', icon: 'M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z'},
    {title: "Jamais d'entraînement", text: 'Vos conversations et vos documents servent à vous répondre, à rien d’autre.', icon: 'M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3'},
    {title: 'Ni pub, ni pistage, ni revente', text: 'Pas d’outil d’analyse tiers, et vos données s’exportent ou se suppriment en un clic.', icon: 'M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6zM4 4l16 16'},
] %}
<section class="lt-commit" aria-labelledby="engagements">
    <div class="lt-container">
        <h2 class="lt-h2" id="engagements">Vos données restent les vôtres.</h2>
        <div class="lt-commit__list">
            {% for c in commitments %}
                <div class="lt-commit__item">
                    <span class="lt-proofs__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ c.icon }}"/></svg>
                    </span>
                    <h3 class="lt-commit__title">{{ c.title }}</h3>
                    <p class="lt-commit__text">{{ c.text }}</p>
                </div>
            {% endfor %}
        </div>
        <a href="{{ path('app_page_show', {slug: 'confiance'}) }}" class="lt-link lt-commit__more">Voir exactement comment →</a>
    </div>
</section>

{# ====== 3. TOUT EST RELIE ======
   Handoff « Tout est relie » (21/10), maquette « C. Le carrousel »
   (Lintello/docs/vitrine/maquettes/tout-est-relie-carrousel.dc.html).
   Un seul espace, les projets, et quatre outils qui se passent ce
   que fait l'utilisateur. Six echanges, tous verifies dans LintellO :
   la recherche web n'est reliee ni au projet ni a l'editeur.

   Le HTML de base est la version empilee (sans JS, mobile, mouvement
   reduit). Le script plus bas la remplace par le carrousel quand l'ecran
   est assez large et que les animations sont permises. #}
{% set relTools = [
    {id: 'chat', label: 'Chat', lead: 'Posez vos questions comme à un collègue.', icon: 'M5 5h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-5 4V6a1 1 0 0 1 1-1z'},
    {id: 'doc', label: 'Éditeur', lead: 'Vos documents, rédigés avec l’IA.', icon: 'M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5M9 13h6M9 17h6'},
    {id: 'files', label: 'Fichiers', lead: 'Vos Word, PDF et images.', icon: 'M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7zM14 3v4h4M12 11v6M9 14l3 3 3-3'},
    {id: 'search', label: 'Recherche web', lead: 'Une synthèse sourcée, sans pistage.', icon: 'M11 5a6 6 0 1 0 0 12a6 6 0 1 0 0-12M20 20l-4.5-4.5'},
] %}
{# a, b : outils relies ('hub' = les projets, au centre) #}
{% set relEdges = [
    {a: 'chat', b: 'doc', from: 'Chat', to: 'Éditeur', arrow: '→', title: 'Une réponse devient un document', text: 'Un clic, et la réponse devient un document que vous modifiez et mettez en forme.'},
    {a: 'doc', b: 'hub', from: 'Éditeur', to: 'Projet', arrow: '→', title: 'Le document se range dans le bon dossier', text: 'Il s’enregistre tout seul dans le projet de votre choix.'},
    {a: 'files', b: 'hub', from: 'Fichiers', to: 'Projet', arrow: '→', title: 'Vos fichiers deviennent utilisables', text: 'Déposez un Word ou un PDF : LintellO le lit et s’en sert pour vous répondre.'},
    {a: 'hub', b: 'chat', from: 'Projet', to: 'Chat', arrow: '→', title: 'Le chat connaît vos dossiers', text: 'Il consulte les documents du projet et vous dit lequel il a utilisé.'},
    {a: 'chat', b: 'search', from: 'Chat', to: 'Recherche web', arrow: '⇄', title: 'Une réponse vérifiée sur le web', text: 'Le chat lance une recherche pour vérifier, et la synthèse sourcée revient dans la conversation.'},
    {a: 'search', b: 'hub', from: 'Recherche web', to: 'Projet', arrow: '→', title: 'Vous gardez ce que vous trouvez', text: 'Une image ou une source repérée sur le web se range dans votre projet, prête à être insérée dans un document.'},
] %}

<section class="lt-section lt-rel" id="outils" data-lt-rel data-lt-rel-tools="{{ relTools|json_encode|e('html_attr') }}" data-lt-rel-edges="{{ relEdges|json_encode|e('html_attr') }}">
    <div class="lt-container">
        <div class="lt-rel__head">
            <p class="lt-eyebrow">Tout est relié</p>
            <h2 class="lt-h2">Vos outils se parlent. Vous ne faites plus de copier-coller.</h2>
            <p class="lt-rel__lead">Le chat, l'éditeur, la recherche et vos fichiers travaillent ensemble, dans un seul espace.</p>
        </div>

        {% set relCloud %}
            <div class="lt-rel__cloud">
                <div class="lt-rel__cloud-box">
                    <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1-.6-8A6 6 0 0 1 18 9.5a4.2 4.2 0 0 1-.5 8.5z"/></svg>
                    <span>
                        <span class="lt-rel__cloud-name">Vos projets</span>
                        <span class="lt-rel__cloud-sub">hébergés à Strasbourg</span>
                    </span>
                </div>
                <p class="lt-rel__projects">
                    <span class="visually-hidden">Exemples de projets :</span>
                    <span>Client Dupont</span>
                    <span>Rénovation maison</span>
                </p>
            </div>
        {% endset %}

        {# --- Version empilee : la base, sans JS --- #}
        <div class="lt-rel__stack">
            {{ relCloud }}
            <div class="lt-rel__tabs" role="tablist" aria-label="Choisir un outil" hidden>
                {% for t in relTools %}
                    <button type="button" role="tab" class="lt-rel__tab" id="lt-rel-tab-{{ t.id }}" aria-controls="lt-rel-panel-{{ t.id }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}">{{ t.label }}</button>
                {% endfor %}
            </div>
            <div class="lt-rel__stack-tools">
                {% for t in relTools %}
                    <article class="lt-rel__stack-tool" id="lt-rel-panel-{{ t.id }}">
                        <div class="lt-rel__tool-head">
                            <span class="lt-rel__icon" aria-hidden="true">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ t.icon }}"/></svg>
                            </span>
                            <div>
                                <h3 class="lt-rel__tool-name">{{ t.label }}</h3>
                                <p class="lt-rel__tool-lead">{{ t.lead }}</p>
                            </div>
                        </div>
                        {% for e in relEdges|filter(e => e.a == t.id or e.b == t.id) %}
                            <div class="lt-rel__edge{{ e.b == t.id and e.a != 'hub' ? ' lt-rel__edge--dup' }}">
                                <p class="lt-rel__route">
                                    <span>{{ e.from }}</span>
                                    <span aria-hidden="true">{{ e.arrow }}</span>
                                    <span class="visually-hidden">{{ e.arrow == '⇄' ? 'et' : 'vers' }}</span>
                                    <span>{{ e.to }}</span>
                                </p>
                                <p class="lt-rel__edge-title">{{ e.title }}</p>
                                <p class="lt-rel__edge-text">{{ e.text }}</p>
                            </div>
                        {% endfor %}
                    </article>
                {% endfor %}
            </div>
        </div>

        {# --- Carrousel : affiche par le script (ecran large, animations permises) --- #}
        <div class="lt-rel__carousel" hidden>
            {# Deux colonnes sur grand ecran : le plateau et ses commandes a gauche, le texte a droite #}
            <div class="lt-rel__visual">
            <div class="lt-rel__stage" role="group" aria-roledescription="carrousel" aria-label="Les outils de LintellO autour de vos projets. Flèches gauche et droite pour tourner." tabindex="0">
                <div class="lt-rel__plate" aria-hidden="true"></div>
                <svg class="lt-rel__links" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none"></svg>
                {{ relCloud }}
                {% for t in relTools %}
                    <button type="button" class="lt-rel__card" data-index="{{ loop.index0 }}" aria-pressed="false">
                        <span class="lt-rel__icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ t.icon }}"/></svg>
                        </span>
                        <span class="lt-rel__card-name">{{ t.label }}</span>
                        <span class="lt-rel__card-lead">{{ t.lead }}</span>
                    </button>
                {% endfor %}
            </div>

            <div class="lt-rel__controls">
                <button type="button" class="lt-rel__arrow" data-step="-1" aria-label="Outil précédent">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                </button>
                <div class="lt-rel__switch" role="group" aria-label="Ce que montre le carrousel">
                    <button type="button" data-mode="front" aria-pressed="true">L'outil devant</button>
                    <button type="button" data-mode="all" aria-pressed="false">Tout le système</button>
                </div>
                <button type="button" class="lt-rel__arrow lt-rel__arrow--next" data-step="1" aria-label="Outil suivant">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                </button>
            </div>
            </div>

            <div class="lt-rel__side">
            <div class="lt-rel__panel" aria-live="polite">
                <h3 class="lt-rel__panel-title"></h3>
                <div class="lt-rel__edges"></div>
                <p class="lt-rel__hint">Cliquez sur un outil pour voir ses liens avec les autres.</p>
            </div>
            </div>
        </div>
    </div>
</section>

<script>
/* Carrousel « Tout est relie » : ameliore la version empilee. Ecouteurs
   poses sur le plateau seulement, aucun ecouteur clavier global. */
(function () {
    var section = document.querySelector('[data-lt-rel]');
    if (!section) return;

    var tools = JSON.parse(section.getAttribute('data-lt-rel-tools'));
    var edges = JSON.parse(section.getAttribute('data-lt-rel-edges'));
    var n = tools.length;
    var carousel = section.querySelector('.lt-rel__carousel');
    var stage = section.querySelector('.lt-rel__stage');
    var svg = section.querySelector('.lt-rel__links');
    var cards = Array.prototype.slice.call(section.querySelectorAll('.lt-rel__card'));
    var modeButtons = section.querySelectorAll('[data-mode]');
    var panelTitle = section.querySelector('.lt-rel__panel-title');
    var panelEdges = section.querySelector('.lt-rel__edges');
    var SVGNS = 'http://www.w3.org/2000/svg';

    var front = 0;      // entier non borne : garde le sens de rotation
    var all = false;
    var wide = window.matchMedia('(min-width: 768px)');
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)');

    function mod(i) { return ((i % n) + n) % n; }

    // Formule de la maquette : outil i, outil f devant
    function pos(i) {
        var t = (i - front) * (2 * Math.PI / n);
        return { x: 50 + 36 * Math.sin(t), y: 42 + 37 * Math.cos(t), depth: (1 + Math.cos(t)) / 2 };
    }
    function point(id) {
        if (id === 'hub') return { x: 50, y: 42 };
        for (var i = 0; i < n; i++) if (tools[i].id === id) return pos(i);
    }

    function edgeCard(e) {
        var box = document.createElement('div');
        box.className = 'lt-rel__edge';
        var route = document.createElement('p');
        route.className = 'lt-rel__route';
        [e.from, e.arrow, e.to].forEach(function (txt, j) {
            var s = document.createElement('span');
            s.textContent = txt;
            if (j === 1) s.setAttribute('aria-hidden', 'true');
            route.appendChild(s);
            if (j === 1) {
                var sr = document.createElement('span');
                sr.className = 'visually-hidden';
                sr.textContent = e.arrow === '⇄' ? 'et' : 'vers';
                route.appendChild(sr);
            }
        });
        var title = document.createElement('p');
        title.className = 'lt-rel__edge-title';
        title.textContent = e.title;
        var text = document.createElement('p');
        text.className = 'lt-rel__edge-text';
        text.textContent = e.text;
        box.appendChild(route);
        box.appendChild(title);
        box.appendChild(text);
        return box;
    }

    function render() {
        var k = mod(front);
        var frontId = tools[k].id;

        cards.forEach(function (card, i) {
            var p = pos(i);
            card.style.left = p.x + '%';
            card.style.top = p.y + '%';
            card.style.transform = 'translate(-50%, -50%) scale(' + (0.7 + 0.3 * p.depth).toFixed(3) + ')';
            // Les outils qui ne sont pas devant restent en petit, icone seule ;
            // « Tout le systeme » les montre en entier
            card.style.opacity = (0.55 + 0.45 * p.depth).toFixed(3);
            card.style.zIndex = String(Math.round(p.depth * 10) + 20);
            card.classList.toggle('is-mini', !all && i !== k);
            card.setAttribute('aria-pressed', i === k ? 'true' : 'false');
            card.classList.toggle('is-front', i === k);
            card.classList.toggle('is-lit', all || i === k);
        });

        var shown = all ? edges : edges.filter(function (e) { return e.a === frontId || e.b === frontId; });

        while (svg.firstChild) svg.removeChild(svg.firstChild);
        shown.forEach(function (e) {
            var p = point(e.a), q = point(e.b);
            var line = document.createElementNS(SVGNS, 'line');
            line.setAttribute('x1', p.x); line.setAttribute('y1', p.y);
            line.setAttribute('x2', q.x); line.setAttribute('y2', q.y);
            line.setAttribute('vector-effect', 'non-scaling-stroke');
            svg.appendChild(line);
        });

        panelTitle.textContent = all
            ? 'Les six échanges du système'
            : 'Ce que fait l’outil « ' + tools[k].label + ' » avec les autres';
        while (panelEdges.firstChild) panelEdges.removeChild(panelEdges.firstChild);
        shown.forEach(function (e) { panelEdges.appendChild(edgeCard(e)); });

        modeButtons.forEach(function (b) {
            b.setAttribute('aria-pressed', (b.getAttribute('data-mode') === 'all') === all ? 'true' : 'false');
        });
    }

    function step(d) { front += d; all = false; render(); }

    // Clic sur une carte : devant, par le plus court chemin
    cards.forEach(function (card, i) {
        card.addEventListener('click', function () {
            if (dragged) return;
            var d = i - mod(front);
            if (d > n / 2) d -= n;
            if (d < -n / 2) d += n;
            if (d !== 0 || all) step(d);
        });
    });
    section.querySelectorAll('[data-step]').forEach(function (b) {
        b.addEventListener('click', function () { step(parseInt(b.getAttribute('data-step'), 10)); });
    });
    modeButtons.forEach(function (b) {
        b.addEventListener('click', function () { all = b.getAttribute('data-mode') === 'all'; render(); });
    });

    // Clavier : fleches quand le plateau (ou une de ses cartes) a le focus
    stage.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
    });

    // Glisse horizontal : un cran tous les 120 px
    var drag = null, dragged = false;
    stage.addEventListener('pointerdown', function (e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        drag = { x: e.clientX, id: e.pointerId };
        dragged = false;
    });
    stage.addEventListener('pointermove', function (e) {
        if (!drag) return;
        var dx = e.clientX - drag.x;
        if (Math.abs(dx) > 8 && !stage.classList.contains('is-dragging')) {
            stage.classList.add('is-dragging');
            try { stage.setPointerCapture(drag.id); } catch (err) {}
        }
        if (Math.abs(dx) > 120) {
            drag.x = e.clientX;
            dragged = true;
            step(dx < 0 ? 1 : -1);
        }
    });
    function endDrag() {
        if (!drag) return;
        drag = null;
        stage.classList.remove('is-dragging');
        // Le clic qui suit un glisse ne doit pas re-tourner le plateau
        setTimeout(function () { dragged = false; }, 0);
    }
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
    stage.addEventListener('pointerleave', endDrag);

    // Molette : un cran au plus toutes les 600 ms, seulement sous le pointeur.
    // Au premier ou au dernier outil, la page reprend son defilement.
    var lastWheel = 0;
    stage.addEventListener('wheel', function (e) {
        var delta = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (delta === 0) return;
        var dir = delta > 0 ? 1 : -1;
        var k = mod(front);
        if ((dir > 0 && k === n - 1) || (dir < 0 && k === 0)) return;
        e.preventDefault();
        var now = Date.now();
        if (now - lastWheel < 600) return;
        lastWheel = now;
        step(dir);
    }, { passive: false });

    // Sans carrousel (mobile, mouvement reduit) : un outil a la fois, par onglets
    var tabList = section.querySelector('.lt-rel__tabs');
    var tabs = Array.prototype.slice.call(section.querySelectorAll('.lt-rel__tab'));
    var panels = tabs.map(function (tab) { return document.getElementById(tab.getAttribute('aria-controls')); });
    var activeTab = 0;
    function selectTab(j, focus) {
        activeTab = j;
        tabs.forEach(function (tab, i) {
            tab.setAttribute('aria-selected', i === j ? 'true' : 'false');
            tab.tabIndex = i === j ? 0 : -1;
            panels[i].hidden = i !== j;
        });
        if (focus) tabs[j].focus();
    }
    tabs.forEach(function (tab, i) {
        panels[i].setAttribute('role', 'tabpanel');
        panels[i].setAttribute('aria-labelledby', tab.id);
        tab.addEventListener('click', function () { selectTab(i, false); });
        tab.addEventListener('keydown', function (e) {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            selectTab((i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, true);
        });
    });

    // Carrousel seulement sur ecran large et animations permises
    function apply() {
        var on = wide.matches && !calm.matches;
        section.classList.toggle('is-carousel', on);
        section.classList.toggle('is-tabs', !on);
        carousel.hidden = !on;
        tabList.hidden = on;
        if (on) render();
        else selectTab(activeTab, false);
    }
    [wide, calm].forEach(function (mq) {
        if (mq.addEventListener) mq.addEventListener('change', apply);
        else if (mq.addListener) mq.addListener(apply);
    });
    apply();
})();
</script>

{# ====== 4. TEMOIGNAGES ======
