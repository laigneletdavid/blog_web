{# ======================================================================
   ACCUEIL — BM NOTAIRE
   Surcouche client, prioritaire sur le theme (voir home/index.html.twig).

   Transposition du lot statique livre par l'etude : une video qui occupe
   l'ecran, puis des sections qui alternent creme et encre. Les poles sont
   lus depuis les services de premier niveau, donc l'etude peut les reordonner
   depuis l'administration sans toucher a ce fichier.
   ====================================================================== */ #}

{# ====== 1. HERO ====== #}
<section class="bm-hero">
    <video class="bm-hero__video" autoplay muted loop playsinline preload="metadata"
           {% if site.heroImage %}poster="{{ asset('documents/medias/' ~ (site.heroImage.webpFileName ?? site.heroImage.fileName)) }}"{% endif %}
           aria-hidden="true" tabindex="-1">
        <source src="{{ asset('documents/medias/hero-bm-notaire.mp4') }}" type="video/mp4">
    </video>
    <div class="bm-hero__voile"></div>
    <div class="bm-hero__contenu">
        <span class="bm-kicker bm-hero__kicker">Étude notariale · {{ site.town|default('Saint-Martory') }}</span>
        <h1 class="bm-hero__signature">Le droit au service de vos projets.</h1>
        <a href="#engagement" class="bm-hero__defiler">Faire défiler <span aria-hidden="true">↓</span></a>
    </div>
</section>

{# ====== 2. ENGAGEMENT ====== #}
<section class="bm-section" id="engagement">
    <div class="bm-duo">
        <div><span class="bm-kicker">Notre engagement</span></div>
        <div>
            <h2 class="bm-titre">Vous accompagner dans les moments <em>qui comptent.</em></h2>
            <p class="bm-lede">
                Rendre le droit clair, sécuriser les décisions et construire avec vous
                des solutions durables.
            </p>
        </div>
    </div>
</section>

{# ====== 3. LES EXPERTISES ====== #}
{% if services|default([])|length > 0 %}
<section class="bm-section bm-section--encre" id="expertises">
    <div class="bm-duo">
        <div><span class="bm-kicker">Nos expertises</span></div>
        <div>
            <h2 class="bm-titre">Conseiller. <em>Anticiper.</em> Transmettre.</h2>
            <p class="bm-lede">
                Une approche exigeante, accessible et profondément humaine. Chaque dossier
                mérite du temps, de la précision et une vision d'ensemble.
            </p>
        </div>
    </div>

    <div class="bm-poles">
        {% for service in services %}
            <a href="{{ path('app_service_show', { slug: service.slug }) }}" class="bm-pole">
                {% if service.image %}
                    <span class="bm-pole__fond" style="background-image:url('{{ asset('documents/medias/' ~ (service.image.webpFileName ?? service.image.fileName)) }}')"></span>
                {% endif %}
                <span class="bm-pole__num">{{ '%02d'|format(loop.index) }}</span>
                <h3 class="bm-pole__titre">{{ service.title }}</h3>
                {% if service.children|length > 0 %}
                    <p class="bm-pole__liste">
                        {{ service.children|slice(0, 3)|map(e => e.title)|join(' · ') }}
                    </p>
                {% elseif service.shortDescription %}
                    <p class="bm-pole__liste">{{ service.shortDescription }}</p>
                {% endif %}
                <span class="bm-pole__fleche" aria-hidden="true">↗</span>
            </a>
        {% endfor %}
    </div>
</section>
{% endif %}

{# ====== 4. L'ETUDE ====== #}
<section class="bm-section" id="etude">
    <div class="bm-etude">
        <div class="bm-etude__portrait">
            {% if site.contactImage %}
                {{ responsive_img(site.contactImage, '(max-width: 860px) 100vw, 40vw', '', site.name|default(''), false, site) }}
            {% elseif site.aboutImage %}
                {{ responsive_img(site.aboutImage, '(max-width: 860px) 100vw, 40vw', '', site.name|default(''), false, site) }}
            {% endif %}
        </div>
        <div>
            <span class="bm-kicker">L'Étude</span>
            <h2 class="bm-titre">Une relation fondée sur la <em>proximité.</em></h2>
            <p class="bm-lede">
                Écouter avant de conseiller. Expliquer avant de décider. Anticiper pour
                sécuriser. L'étude privilégie une relation directe, lisible et durable à
                chaque étape de votre projet.
            </p>
            <a href="{{ path('app_contact') }}" class="bm-lien">Rencontrer l'étude <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>

{# ====== 5. MANIFESTE ====== #}
<section class="bm-section bm-section--encre">
    <span class="bm-kicker">Un office · un territoire · une exigence</span>
    <h2 class="bm-titre">Parce qu'un acte ne se résume jamais à une <em>signature.</em></h2>
    <div class="bm-valeurs">
        <span>Écouter.</span>
        <span>Conseiller.</span>
        <span>Anticiper.</span>
        <span>Transmettre.</span>
    </div>
</section>

{# ====== 6. ACTUALITES ====== #}
{% if articles|default([])|length > 0 %}
<section class="bm-section">
    <div class="bm-duo">
        <div><span class="bm-kicker">Actualités</span></div>
        <div>
            <h2 class="bm-titre">Les publications de <em>l'Étude.</em></h2>
            <a href="{{ path('app_article_show_all') }}" class="bm-lien">Toutes les actualités <span aria-hidden="true">↗</span></a>
        </div>
    </div>
    <div class="row mt-5">
        {% include 'article/article_liste.html.twig' with { articles } %}
    </div>
</section>
{% endif %}

{# ====== 7. CONTACT ====== #}
<section class="bm-section bm-section--encre" id="contact">
    <div class="bm-duo">
        <div><span class="bm-kicker">Vos démarches</span></div>
        <div>
            <h2 class="bm-titre">Comment souhaitez-vous <em>avancer ?</em></h2>
            <p class="bm-lede">
                Présentez-nous votre situation : l'étude vous indique les étapes et les
                pièces utiles avant le premier rendez-vous.
            </p>
            <a href="{{ path('app_contact') }}" class="bm-lien">Prendre rendez-vous <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>
