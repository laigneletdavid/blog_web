{# ====== HOME CLIENT — Override bw_front (BlogWeb) ====== #}
{# Surcharge de home/_home_generic.html.twig #}

{% import 'client/_macros.html.twig' as m %}
{{ m.symbole_vague() }}

{# Nom du produit affiché sur la home. Le nom du site (admin), le logo et le domaine
   basculent avec la migration (brief séparé). #}
{% set nomProduit = 'ComWeb Studio' %}


{# ====== 3.2 HERO ====== #}
<section class="home-hero">
    <div class="container position-relative">
        <div class="row align-items-center home-hero__row g-4 g-lg-5">
            <div class="col-lg-6 home-hero__content">
                <p class="home-hero__overtitle">Le code c'est nous, le contenu c'est vous.</p>
                <h1 class="home-hero__title">Site internet professionnel {{ m.vague('clé en main') }} pour TPE et artisans</h1>
                <p class="home-hero__desc">Un site professionnel livré en une demi-journée, prêt à être trouvé sur Google. Vous racontez votre métier, on s'occupe du reste.</p>
                <div class="home-hero__actions">
                    <a href="/page/offres" class="btn btn-primary btn-lg">Voir les offres<span class="cw-arrow" aria-hidden="true">&rarr;</span></a>
                    <a href="{{ path('app_contact') }}" class="btn btn-outline-primary btn-lg">Demander un devis</a>
                </div>
                <div class="home-hero__badges">
                    <span class="home-hero__trust-badge">&#9989; Site en ligne en &#189; journée</span>
                    <span class="home-hero__trust-badge">&#128274; Sécurisé & RGPD</span>
                    <span class="home-hero__trust-badge">&#127467;&#127479; Hébergé en France</span>
                </div>
            </div>
            <div class="col-lg-6">
                {# TODO CONTENU : capture de l'éditeur (servie en WebP via responsive_img, width/height,
                   alt descriptif). En attendant, maquette HTML de l'éditeur, base de la démo animée. #}
                {% set exemplesDemo = [
                    { titre: 'Atelier de menuiserie', texte: 'Fabrication sur mesure, pose et conseil près de chez vous.' },
                    { titre: 'Salon de coiffure', texte: 'Coupe, couleur et conseils, avec ou sans rendez-vous.' },
                    { titre: 'Plombier chauffagiste', texte: 'Dépannage, installation et entretien de vos équipements.' },
                ] %}
                <figure class="cw-browser hero-demo"
                        data-controller="typing-demo"
                        data-action="mouseenter->typing-demo#hold mouseleave->typing-demo#release"
                        data-typing-demo-examples-value="{{ exemplesDemo|json_encode|e('html_attr') }}">
                    <figcaption class="visually-hidden">L'éditeur du site : vous tapez votre titre et votre texte, l'aperçu de votre site se met à jour à côté.</figcaption>
                    <div class="cw-browser__bar" aria-hidden="true">
                        <span class="cw-browser__dots"><i></i><i></i><i></i></span>
                        <span class="cw-browser__url">votre-site.fr/admin</span>
                    </div>
                    <div class="hero-demo__body" aria-hidden="true">
                        <div class="hero-demo__editor">
                            <span class="hero-demo__label">Titre</span>
                            <div class="hero-demo__field hero-demo__field--title" data-typing-demo-target="field" data-key="titre">{{ exemplesDemo[0].titre }}</div>
                            <span class="hero-demo__label">Texte</span>
                            <div class="hero-demo__field" data-typing-demo-target="field" data-key="texte">{{ exemplesDemo[0].texte }}</div>
                            <span class="hero-demo__publish">Publier</span>
                        </div>
                        <div class="hero-demo__preview">
                            <span class="hero-demo__preview-bar"></span>
                            <strong class="hero-demo__preview-title" data-typing-demo-target="preview" data-key="titre">{{ exemplesDemo[0].titre }}</strong>
                            <span class="hero-demo__preview-text" data-typing-demo-target="preview" data-key="texte">{{ exemplesDemo[0].texte }}</span>
                            <span class="hero-demo__preview-btn"></span>
                        </div>
                    </div>
                    <button type="button" class="hero-demo__pause" hidden
                            data-typing-demo-target="toggle" data-action="typing-demo#toggle"
                            aria-pressed="false">Pause</button>
                </figure>
            </div>
        </div>
    </div>
</section>

{# ====== 3.3 PREUVE RAPIDE ====== #}
{# TODO CONTENU : 3 captures de sites clients (capture WebP + nom + métier, avec l'accord des clients).
   Remplir la liste : { image: 'fichier.webp', nom: '...', metier: '...', url: 'https://...' }.
   La section reste masquée tant que la liste est vide. #}
{% set sitesClients = [] %}
{% if sitesClients|length > 0 %}
<section class="home-proof">
    <div class="container">
        <p class="home-proof__title">Ils ont leur site avec nous</p>
        <div class="home-proof__grid">
            {% for client in sitesClients %}
            <a class="home-proof__card" href="{{ client.url }}" target="_blank" rel="noopener">
                <img src="{{ asset('documents/medias/' ~ client.image) }}" alt="Site de {{ client.nom }}, {{ client.metier }}" loading="lazy" width="480" height="300">
                <span class="home-proof__name">{{ client.nom }}</span>
                <span class="home-proof__job">{{ client.metier }}</span>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 3.4 POURQUOI PAS WORDPRESS ====== #}
<section class="home-wordpress-compare">
    <div class="container">
        <div class="home-wordpress-compare__inner" data-controller="reveal">
            <h2 class="home-section-title">Pourquoi pas un WordPress comme tout le monde ?</h2>
            <p class="home-wordpress-compare__text">WordPress, c'est l'illusion de la simplicité. En réalité : des plugins à empiler, des mises à jour qui cassent tout, des failles de sécurité tous les mois, et un site qui ralentit avec le temps. {{ nomProduit }} fait l'inverse : tout est intégré, sécurisé, optimisé dès le premier jour. Rien à installer, rien à maintenir, rien à craindre.</p>
            <a href="/page/site-sur-mesure-vs-cms-classique" class="btn btn-outline-light btn-lg">Voir la comparaison complète</a>
        </div>
    </div>
</section>

{# ====== 3.5 FONCTIONNALITES : 3 rangees texte / capture ====== #}
{% set rangees = [
    { titre: 'Éditeur visuel', texte: 'Rédigez vos articles avec un éditeur moderne. Texte, images, vidéos, code — tout en un.', icone: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>' },
    { titre: 'SEO intégré', texte: 'Meta tags, sitemap XML, Open Graph — votre site est optimisé pour les moteurs de recherche.', icone: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' },
    { titre: 'Personnalisation sans code', texte: 'Couleurs, polices et logo — personnalisez votre site sans toucher au code.', icone: '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>' },
] %}
<section class="home-features">
    <div class="container">
        <h2 class="home-section-title text-center" data-controller="reveal">{{ nomProduit }}, une plateforme pensée pour vous faire gagner du temps</h2>
        {% for r in rangees %}
        <div class="home-feature-row{{ loop.index is even ? ' home-feature-row--inverse' }}">
            <div class="home-feature-row__text" data-controller="reveal">
                <h3 class="home-feature-row__title">{{ r.titre }}</h3>
                <p class="home-feature-row__desc">{{ r.texte }}</p>
            </div>
            <div class="home-feature-row__visual" data-controller="reveal" data-reveal-from-value="{{ loop.index is even ? 'left' : 'right' }}">
                {# TODO CONTENU : capture admin « {{ r.titre }} » (WebP, width/height, alt descriptif) #}
                <div class="cw-browser cw-browser--maquette" aria-hidden="true">
                    <div class="cw-browser__bar"><span class="cw-browser__dots"><i></i><i></i><i></i></span></div>
                    <div class="cw-browser__maquette">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">{{ r.icone|raw }}</svg>
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
        <ul class="home-features__more" data-controller="reveal" data-reveal-stagger-value="70">
            <li><strong>Pages & Layouts</strong> — créez des pages vitrine avec différents layouts pour présenter vos services et votre activité.</li>
            <li><strong>Navigation flexible</strong> — organisez votre menu par glisser-déposer, avec sous-menus et liens personnalisés.</li>
            <li><strong>Contact & Notifications</strong> — formulaire de contact, commentaires et notifications email pour rester connectés à vos visiteurs.</li>
        </ul>
    </div>
</section>

{# ====== 3.6 COMMENT CA MARCHE : 4 etapes ====== #}
{# Parcours valide par David le 4/11/2026 : une vraie discussion d'abord (prise de rendez-vous
   Google Agenda, nouvel onglet), le questionnaire ensuite. Etapes 3 et 4 reprises des cartes
   de service ; les pages /service/* restent en ligne. #}
{% set lienRendezVous = m.lien_rdv() %}
{% set etapes = [
    { titre: 'On parle de votre projet', texte: 'Autour d’un café, au téléphone ou en visio : 30 minutes pour comprendre votre métier et vos besoins. Gratuit et sans engagement.', lien: lienRendezVous, libelle: 'Réserver un créneau', externe: true },
    { titre: 'On installe en ½ journée', texte: 'Vous remplissez un questionnaire guidé, on s’occupe du reste : nom de domaine, hébergement, sécurité.', lien: '/service/votre-site-est-pret-en-une-demi-journee' },
    { titre: 'Vous écrivez, simplement', texte: 'Vous racontez votre métier, vos services, avec un éditeur simple comme Word. Pas besoin de coder.', lien: '/service/vous-gerez-votre-contenu-en-toute-autonomie' },
    { titre: 'En ligne, et on reste là', texte: 'Formation de 30 min, guide écrit et support continu : un seul interlocuteur pour vos questions.', lien: '/service/on-ne-vous-laisse-pas-seul-apres-la-livraison' },
] %}
<section class="home-steps">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">Comment ça se passe concrètement</h2>
            <p class="home-section-subtitle">De notre premier échange à votre site en ligne, voici ce que vous allez vivre.</p>
        </div>
        <ol class="home-steps__list" data-controller="reveal" data-reveal-stagger-value="70">
            {% for e in etapes %}
            <li class="home-steps__item">
                <span class="home-steps__num" aria-hidden="true">{{ loop.index }}</span>
                <h3 class="home-steps__title">{{ e.titre }}</h3>
                <p class="home-steps__text">{{ e.texte }}</p>
                {% if e.lien %}
                {% if e.externe|default(false) %}
                <a href="{{ e.lien }}" class="home-steps__link" target="_blank" rel="noopener">{{ e.libelle }}<span class="visually-hidden"> (nouvel onglet)</span> &rarr;</a>
                {% else %}
                <a href="{{ e.lien }}" class="home-steps__link">En savoir plus<span class="visually-hidden"> : {{ e.titre|lower }}</span> &rarr;</a>
                {% endif %}
                {% endif %}
            </li>
            {% endfor %}
        </ol>
    </div>
</section>

{# ====== 3.7 TARIFS ====== #}
{# Formules et prix : client/_offres.html.twig, source unique (home + page Offres) #}
<section class="home-pricing">
    <div class="container">
        <div class="text-center mb-5" data-controller="reveal">
            <h2 class="home-section-title">Trois offres, trois prix, {{ m.vague('zéro mauvaise surprise') }}</h2>
            <p class="home-pricing__subtitle">Pas de devis opaque, pas de coûts cachés. Vous savez exactement ce que vous payez et ce que vous obtenez.</p>
        </div>
        {% include 'client/_offres.html.twig' with { vue: 'cartes' } %}
        <div class="text-center mt-4">
            <a href="/page/offres#comparatif" class="home-pricing__compare">Comparer toutes les offres &rarr;</a>
        </div>
    </div>
</section>

{# ====== 3.8 TEMOIGNAGES ====== #}
{# TODO CONTENU : témoignage (citation, prénom, métier, ville), à saisir dans l'admin
   (galerie du site, emplacement « testimonial ») : texte = citation, titre = « Prénom, métier, ville ».
   0 avis : section masquée. 1 avis : citation mise en avant. 2 ou 3 : grille de cartes. #}
{% set testimonials = site.getGalleryBySlot('testimonial') %}
{% if testimonials|length == 1 %}
{% set avis = testimonials|first %}
<section class="home-testimonials home-testimonials--single">
    <div class="container">
        <h2 class="visually-hidden">Ce que disent nos clients</h2>
        <figure class="home-quote" data-controller="reveal">
            <svg class="home-quote__vague" aria-hidden="true" viewBox="0 0 200 20" preserveAspectRatio="none"><use href="#bw-vague"/></svg>
            <blockquote class="home-quote__text">
                <p>{{ avis.content }}</p>
            </blockquote>
            <figcaption class="home-quote__author">
                {% if avis.media %}
                <img src="{{ asset('documents/medias/' ~ (avis.media.webpFileName ?? avis.media.fileName)) }}" alt="" class="home-quote__avatar" width="56" height="56" loading="lazy">
                {% endif %}
                <span>{{ avis.title }}</span>
            </figcaption>
        </figure>
    </div>
</section>
{% elseif testimonials|length > 1 %}
<section class="home-testimonials">
    <div class="container">
        <div data-controller="reveal">
            <h2 class="home-section-title text-center">Ce que disent nos clients</h2>
            {% include '_partials/_testimonials_grid.html.twig' with { testimonials: testimonials } %}
        </div>
    </div>
</section>
{% endif %}

{# ====== PRODUITS / EVENEMENTS / PORTFOLIO (modules, vides aujourd'hui) ====== #}
{% if featuredProducts|default([])|length > 0 %}
    {% include '_partials/_product_featured.html.twig' with { featuredProducts: featuredProducts, site: site|default(null) } %}
{% endif %}

{% if upcomingEvents|default([])|length > 0 %}
<section class="home-events">
    <div class="container">
        <h2 class="home-section-title text-center">Événements à venir</h2>
        <div class="row g-4">
            {% for event in upcomingEvents %}
            <div class="col-md-4">
                {% include '_partials/_event_card.html.twig' with { event: event } %}
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{% if featuredPortfolio|default([])|length > 0 %}
<section class="home-portfolio">
    <div class="container">
        <h2 class="home-section-title text-center">Nos réalisations</h2>
        {% include '_partials/_portfolio_grid.html.twig' with { portfolioItems: featuredPortfolio } %}
    </div>
</section>
{% endif %}

{# ====== 3.9 CHIFFRES CLES ====== #}
<section class="home-metrics">
    <div class="container">
        <div class="row" data-controller="reveal count-up" data-reveal-stagger-value="70">
            <div class="col-6 col-md-3 home-metrics__item">
                <div class="home-metrics__value">&frac12; j</div>
                <div class="home-metrics__label">pour être en ligne</div>
            </div>
            <div class="col-6 col-md-3 home-metrics__item">
                <div class="home-metrics__value" data-count-up-target="value">6</div>
                <div class="home-metrics__label">thèmes inclus</div>
            </div>
            <div class="col-6 col-md-3 home-metrics__item">
                <div class="home-metrics__value" data-count-up-target="value">0</div>
                <div class="home-metrics__label">plugin à installer</div>
            </div>
            <div class="col-6 col-md-3 home-metrics__item">
                <div class="home-metrics__value" data-count-up-target="value">1</div>
                <div class="home-metrics__label">interlocuteur unique</div>
            </div>
        </div>
    </div>
</section>

{# ====== 3.10 FAQ ====== #}
{% if faqs|default([])|length > 0 %}
<section class="home-faq">
    <div class="container">
        <div data-controller="reveal">
            <h2 class="home-section-title text-center">Questions fréquentes</h2>
            {% include '_partials/_faq_accordion.html.twig' with { faqs: faqs } %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 3.11 ACTUALITES ====== #}
{% if articles|default([])|length > 0 %}
<section class="home-articles">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="home-section-title mb-0">Actualités</h2>
            <a href="{{ path('app_article_show_all') }}" class="btn btn-outline-primary btn-sm">Tout voir &rarr;</a>
        </div>
        <div class="blog-grid blog-grid--3col" data-controller="reveal" data-reveal-stagger-value="70">
            {% include 'article/article_liste.html.twig' with { articles: articles|slice(0, 3), cardTitleTag: 'h3' } %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 3.12 A PROPOS ====== #}
{# TODO CONTENU : texte À propos (histoire Comminges / Commerce / Communication,
   « 15 ans à vendre, 10 ans à coder »). En attendant, texte actuel (description SEO du site). #}
<section class="home-about" id="home-about">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row align-items-center gap-4" data-controller="reveal">
            <div class="col-12 col-lg-3 home-about__img-wrapper d-flex justify-content-center">
                {% if site.aboutImage %}
                {{ responsive_img(site.aboutImage, '(max-width: 768px) 100vw, 25vw', 'home-about__img rounded-circle') }}
                {% else %}
                <img src="{{ asset('images/profil.jpg') }}"
                     alt="Votre interlocuteur"
                     class="home-about__img rounded-circle" loading="lazy"
                     width="279" height="279"/>
                {% endif %}
            </div>
            <div class="col-12 col-lg-9 home-about__content d-flex flex-column justify-content-evenly align-items-center">
                <span class="home-about__overtitle">À propos</span>
                <h2 class="home-about__title">{{ site.title|default(site.name|default('')) }}</h2>
                {# Phrase provisoire fournie par David (brief passe 2), en attendant le texte À propos #}
                <p class="home-about__text">{{ nomProduit }} est conçu et maintenu par David Laignelet, développeur web et commercial depuis 15 ans, dans le Comminges.</p>
                <a href="{{ path('app_contact') }}" class="btn btn-outline-primary">En savoir plus</a>
            </div>
        </div>
    </div>
</section>

{# ====== GALERIE / LOGOS (si renseignes dans l'admin) ====== #}
{% set gallery = site.getGalleryBySlot('gallery') %}
{% if gallery|length > 0 %}
<section class="home-gallery">
    <div class="container">
        <h2 class="home-section-title text-center">Galerie</h2>
        {% include '_partials/_gallery_grid.html.twig' with { gallery: gallery } %}
    </div>
</section>
{% endif %}

{% set logos = site.getGalleryBySlot('logo') %}
{% if logos|length > 0 %}
<section class="home-logos">
    <div class="container">
        <p class="home-logos__title text-center">Ils nous font confiance</p>
        {% include '_partials/_logos_grid.html.twig' with { logos: logos } %}
    </div>
</section>
{% endif %}

{# ====== 4.5 DONNEES STRUCTUREES DE LA HOME ======
   Organization / LocalBusiness : base.html.twig (type et adresse reglés dans l'admin).
   Ici : FAQPage (les questions affichées, 6 au plus comme l'accordéon) et une offre par formule. #}
{% if faqs|default([])|length > 0 %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {% for faq in faqs|slice(0, 6) %}
        {
            "@type": "Question",
            "name": {{ faq.question|json_encode|raw }},
            "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq.content|striptags|trim|json_encode|raw }}
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endif %}
{% include 'client/_offres.html.twig' with { vue: 'jsonld' } %}

{# ====== 3.13 CTA FINAL ====== #}
<section class="home-cta">
    <div class="container text-center" data-controller="reveal">
        <h2 class="home-cta__title">Prêt à lancer {{ m.vague('votre site') }} ?</h2>
        <p class="home-cta__desc">Contactez-nous pour discuter de votre projet. Installation, personnalisation et mise en ligne en une demi-journée, après validation de votre contenu.</p>
        <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">Nous contacter<span class="cw-arrow" aria-hidden="true">&rarr;</span></a>
    </div>
</section>
