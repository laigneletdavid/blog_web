{# ======================================================================
   ACCUEIL — LintellO
   Surcouche client, prioritaire sur le theme (voir home/index.html.twig).

   Ordre des sections (handoff vitrine v0.1, partie 2, section 10) :
     1. Heros : promettre et faire commencer
     2. Nos engagements : vos donnees, le detail est sur la page Confiance
     3. Trois outils : l'editeur en premier
     4. (Temoignages : a venir, composant BlogWeb)
     5. Qui est derriere
     6. Offres : trois publics, trois prix
     7. Apprendre et actualites : derniers articles, un par categorie
     8. FAQ : quatre questions, lues depuis le module FAQ

   Regles : une seule couleur, le bleu primaire ; aucun degrade ; le
   tricolore n'apparait que dans la pastille du heros. Aucun fournisseur
   nomme (moteur IA, recherche, hebergeur, paiement).
   ====================================================================== #}
{% set lt_app = 'https://www.lintello.ai' %}
{% import 'client/_macros.html.twig' as lt %}

<div class="lt-home">

{# ====== 1. HEROS ====== #}
<section class="lt-hero">
    <div class="lt-container lt-hero__grid">
        <div class="lt-hero__text">
            <p class="lt-pill">
                <span class="lt-flag" aria-hidden="true"><span></span><span></span><span></span></span>
                Votre intello personnel, 100&nbsp;% français
            </p>
            <h1 class="lt-hero__title lt-hero__title--home">Une IA simple et efficace qui travaille avec vous. <span>Vos données restent chez vous.</span></h1>
            <p class="lt-hero__lead">Rédiger, analyser, chercher : LintellO vous aide au quotidien sur un moteur IA français, hébergé à Strasbourg. Vos échanges restent chiffrés et ne servent jamais à entraîner l'IA.</p>
            <div class="lt-hero__actions">
                <a href="{{ lt_app }}/register" class="lt-btn lt-btn--primary lt-btn--lg">Commencer gratuitement</a>
                <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link">Voir les offres</a>
            </div>
            <p class="lt-hero__note">Offre Gratuite : 20 messages par jour avec l'IA du quotidien.</p>
        </div>

        {# Maquette de l'editeur de documents : un cas TPE, un passage
           surligne et la demande de reprise. Decor, sans contenu lisible
           par les lecteurs d'ecran au-dela de sa description. #}
        <div class="lt-hero__visual">
            <div class="lt-editor" role="img" aria-label="Exemple : un compte rendu de réunion dans l'éditeur de LintellO, avec un paragraphe surligné et la demande « Rends ce paragraphe plus clair pour le client »">
                <div class="lt-editor__head" aria-hidden="true">
                    <img src="{{ asset('images/lintello/icone-lintello.png') }}" alt="" width="22" height="22">
                    <span class="lt-editor__file">Compte rendu — Réunion client</span>
                    <span class="lt-editor__tools">
                        <span>B</span><span><i>I</i></span><span>H2</span>
                    </span>
                </div>
                <div class="lt-editor__page" aria-hidden="true">
                    <p class="lt-editor__title">Compte rendu de réunion</p>
                    <p class="lt-editor__meta">Projet de rénovation · 14 octobre</p>
                    <p>Points abordés : planning des travaux, choix des matériaux, budget.</p>
                    <p><mark>Compte tenu des contraintes d'approvisionnement évoquées, le démarrage initialement prévu fait l'objet d'un report dont la durée reste à confirmer.</mark></p>
                    <p class="lt-editor__line"></p>
                    <p class="lt-editor__line lt-editor__line--short"></p>
                </div>
                <div class="lt-editor__ask" aria-hidden="true">
                    <span>Rends ce paragraphe plus clair pour le client</span>
                    <span class="lt-chat__send">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

{# ====== 2. NOS ENGAGEMENTS ====== #}
{% set commitments = [
    {title: 'En France, de bout en bout', text: 'Un moteur IA français, des serveurs à Strasbourg, une recherche web européenne.', icon: 'M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z'},
    {title: "Jamais d'entraînement", text: 'Vos conversations et vos documents servent à vous répondre, à rien d’autre.', icon: 'M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V8a4 4 0 0 1 8 0v3'},
    {title: 'Ni pub, ni pistage, ni revente', text: 'Pas d’outil d’analyse tiers, et vos données s’exportent ou se suppriment en un clic.', icon: 'M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6zM4 4l16 16'},
] %}
<section class="lt-commit" aria-labelledby="engagements">
    <div class="lt-container">
        <h2 class="lt-h2" id="engagements">Vos données restent les vôtres.</h2>
        <div class="lt-commit__list">
            {% for c in commitments %}
                <div class="lt-commit__item">
                    <span class="lt-proofs__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ c.icon }}"/></svg>
                    </span>
                    <h3 class="lt-commit__title">{{ c.title }}</h3>
                    <p class="lt-commit__text">{{ c.text }}</p>
                </div>
            {% endfor %}
        </div>
        <a href="{{ path('app_page_show', {slug: 'confiance'}) }}" class="lt-link lt-commit__more">Voir exactement comment →</a>
    </div>
</section>

{# ====== 3. TROIS OUTILS ======
   L'editeur est mis en avant : carte pleine largeur, chat et recherche dessous. #}
{% set tools = [
    {title: 'Éditeur de documents', lead: 'Une réponse devient un vrai document : compte rendu, courrier, fiche produit. Sélectionnez un passage, demandez une reprise, LintellO modifie avec vous. Export en Word ou en PDF.', icon: 'M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5M9 13h6M9 17h6', wide: true},
    {title: 'Le chat', lead: 'Posez votre question comme à un collègue. LintellO comprend ce que vous voulez et s’adapte : réponse courte, analyse, code.', icon: 'M5 5h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-5 4V6a1 1 0 0 1 1-1z', wide: false},
    {title: 'La recherche web', lead: 'LintellO cherche sur le web à votre place, lit les pages et vous rend une synthèse avec ses sources. La recherche part de moteurs européens, et les sites visités ne voient ni votre adresse ni vos cookies.', icon: 'M11 5a6 6 0 1 0 0 12a6 6 0 1 0 0-12M20 20l-4.5-4.5', wide: false},
] %}
<section class="lt-section" id="outils">
    <div class="lt-container">
        <h2 class="lt-h2 lt-h2--narrow">Un éditeur, un chat, une recherche. Rien à régler.</h2>
        <div class="lt-tools">
            {% for t in tools %}
                <div class="lt-card{{ t.wide ? ' lt-tools__wide' }}">
                    <span class="lt-card__icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="{{ t.icon }}"/></svg>
                    </span>
                    <h3 class="lt-card__title">{{ t.title }}</h3>
                    <p class="lt-card__lead">{{ t.lead }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ====== 4. TEMOIGNAGES ======
   A venir : composant BlogWeb a creer sur main (handoff, section 4). #}

{# ====== 5. QUI EST DERRIERE ======
   Version courte du bloc de la page Confiance. #}
<section class="lt-section lt-section--tight">
    <div class="lt-container">
        <div class="lt-founder lt-founder--short">
            <img src="{{ asset('images/lintello/david-laignelet.jpg') }}" alt="David Laignelet, créateur de LintellO" width="96" height="96" class="lt-founder__photo" loading="lazy">
            <div class="lt-founder__text">
                <h2 class="lt-h3">Qui est derrière LintellO</h2>
                <p>LintellO est conçu par David Laignelet, fondateur de Com Web Solutions et enseignant, depuis la Haute-Garonne. Une IA pensée pour travailler avec vous, pas à votre place.</p>
                <a href="{{ path('app_page_show', {slug: 'confiance'}) }}" class="lt-link">En savoir plus →</a>
            </div>
        </div>
    </div>
</section>

{# ====== 6. OFFRES ======
   Le public titre la carte, le nom d'offre accompagne le prix.
   "des" seulement quand la carte regroupe plusieurs offres (Pros).
   La carte Pros est mise en avant (cible prioritaire de l'accueil : TPE/PME). #}
{% set audiences = [
    {who: 'Pros', title: 'Écrire, analyser, coder au quotidien.', offer: 'Offres Pro et LintellO', from: true, highlight: true, price: '19,90 €', per: 'HT / mois', cta: 'LintellO pour les pros', slug: 'professionnels'},
    {who: 'À la maison', title: 'Les démarches, les devoirs, les projets.', offer: 'Offre Perso', from: false, price: '9,90 €', per: 'TTC / mois', cta: 'LintellO à la maison', slug: 'particuliers'},
    {who: 'Études', title: 'Comprendre ses cours, réviser, rédiger.', offer: 'Offre Étudiant', from: false, price: '4,99 €', per: 'TTC / mois', cta: 'LintellO pour les études', slug: 'etudiants'},
] %}
<section class="lt-section lt-section--grey">
    <div class="lt-container">
        <div class="lt-section__head">
            <h2 class="lt-h2">Pour vous, à votre prix.</h2>
            <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link">Comparer toutes les offres →</a>
        </div>
        <div class="lt-cards lt-cards--280">
            {% for a in audiences %}
                <a href="{{ path('app_page_show', {slug: a.slug}) }}" class="lt-card lt-card--link{{ a.highlight|default(false) ? ' lt-card--highlight' }}">
                    <span class="lt-eyebrow">{{ a.who }}</span>
                    <span class="lt-card__title lt-card__title--lg">{{ a.title }}</span>
                    <span class="lt-card__offer">{{ a.offer }}</span>
                    <span class="lt-price">
                        {% if a.from %}<span class="lt-price__from">dès</span>{% endif %}
                        <span class="lt-price__amount">{{ a.price }}</span>
                        <span class="lt-price__per">{{ a.per }}</span>
                    </span>
                    <span class="lt-card__more">{{ a.cta }} →</span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

{# ====== 7. APPRENDRE ET ACTUALITES ======
   Un article par categorie, trois au plus, parmi ceux que fournit le
   controleur de la home. #}
{% set posts = [] %}
{% set seenCats = [] %}
{% for article in articles|default([]) %}
    {% set cat = article.categories|first %}
    {% set catKey = cat ? cat.id : 'sans-categorie' %}
    {% if catKey not in seenCats and posts|length < 3 %}
        {% set posts = posts|merge([article]) %}
        {% set seenCats = seenCats|merge([catKey]) %}
    {% endif %}
{% endfor %}
{% if posts|length > 0 %}
<section class="lt-section">
    <div class="lt-container">
        <div class="lt-section__head">
            <h2 class="lt-h2">Apprendre et actualités</h2>
            <a href="{{ path('app_article_show_all') }}" class="lt-link">Tous les contenus →</a>
        </div>
        <div class="lt-cards lt-cards--280">
            {% for article in posts %}
                {% set cat = article.categories|first %}
                <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="lt-post">
                    <span class="lt-post__media">
                        {% if article.featuredMedia %}
                            {{ responsive_img(article.featuredMedia, '(max-width: 768px) 100vw, 33vw', 'lt-post__img', null, false, article) }}
                        {% endif %}
                    </span>
                    <span class="lt-post__body">
                        {% if cat %}<span class="lt-eyebrow">{{ cat.name }}</span>{% endif %}
                        <span class="lt-post__title">{{ article.title }}</span>
                        <span class="lt-post__meta">{{ lt.date_fr(article.publishedAt ?? article.createdAt) }}</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 8. FAQ ======
   Les quatre premieres questions actives du module FAQ (ordre de l'admin). #}
{% set homeFaqs = faqs|default([])|slice(0, 4) %}
{% if homeFaqs|length > 0 %}
<section class="lt-section lt-faq" id="faq">
    <div class="lt-container lt-container--narrow">
        <h2 class="lt-h2">Questions fréquentes</h2>
        <div class="lt-faq__list">
            {% for faq in homeFaqs %}
                <details class="lt-faq__item"{% if loop.first %} open{% endif %}>
                    <summary class="lt-faq__q">
                        <span>{{ faq.question }}</span>
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <div class="lt-faq__a">{{ faq.content|raw }}</div>
                </details>
            {% endfor %}
        </div>
        <p class="lt-faq__more">D'autres questions ? <a href="{{ path('app_faq_index') }}">Toutes les questions</a> ou <a href="{{ path('app_article_show_all') }}">les guides</a>.</p>
    </div>
</section>
{% endif %}

</div>
