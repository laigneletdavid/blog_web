{# ======================================================================
   HEADER — Maître Bruno Mainguy
   Override client, prioritaire sur themes/corporate/_header.html.twig
   (voir base.html.twig). Copie du header corporate, avec trois ecarts :

     1. Plus de lien Connexion ni Mon compte : un office notarial n'a pas
        d'espace membre. L'acces se fait par /login ou /admin, et la barre
        d'administration reste affichee aux utilisateurs connectes.
     2. Le bouton d'appel dit « Nous rencontrer » et non « Demander un devis »,
        qui n'a pas de sens pour une profession a tarif reglemente.
     3. Ce bouton porte la classe bw-cta, stylee dans client/theme.css.

   Ce fichier est fige : les evolutions du header corporate sur main ne
   s'appliqueront plus ici. A comparer lors des merges si le header bouge.
   ====================================================================== #}
<header class="header header--corporate">
    {% include '_partials/_admin_bar.html.twig' %}

    <div class="header-main desk">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="{{ path('app_home') }}" class="header-logo">
                {% if site is not null and site.logo is not null %}
                    {{ logo_img(site.logo, 42, site.name|default('')) }}
                {% else %}
                    <img src="{{ asset('images/logo-blogweb.png') }}" alt="Blog&Web" width="52" height="42"/>
                {% endif %}
            </a>

            <nav class="header-nav d-flex align-items-center gap-1">
                {% for menu in header_menus %}
                    {% if menu.children|length > 0 %}
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle" href="{{ menu|menuLink }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ menu.name }}
                            </a>
                            <ul class="dropdown-menu">
                                {% for child in menu.children %}
                                    {% if child.isVisible %}
                                        <li><a class="dropdown-item" href="{{ child|menuLink }}">{{ child.name }}</a></li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ menu|menuLink }}" class="nav-link">{{ menu.name }}</a>
                    {% endif %}
                {% endfor %}
            </nav>

            <div class="header-actions d-flex align-items-center gap-2">
                {# Champ et loupe dans un seul cadre : la loupe est le bouton d'envoi. #}
                <div class="header-search dropdown" data-controller="search">
                    <form class="bw-search" action="{{ path('app_search_results') }}" method="get" data-search-target="form" data-api-url="{{ path('app_search') }}" data-action="search#doSearch:prevent">
                        <input type="search" name="q" class="bw-search__input" placeholder="Rechercher" aria-label="Rechercher sur le site" data-search-target="q" autocomplete="off">
                        <button class="bw-search__submit" type="submit" aria-label="Lancer la recherche">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.6"/><path d="M10.4 10.4 14 14"/></svg>
                        </button>
                    </form>
                    <div class="dropdown-menu" data-search-target="results"></div>
                </div>
                <a href="{{ path('app_contact') }}" class="btn bw-cta">
                    <span>Nous rencontrer</span>
                    {{ bi('arrow-right', 'bw-cta__arrow') }}
                </a>
            </div>
        </div>
    </div>

    <div class="header-mobile smart">
        <div class="container d-flex align-items-center justify-content-between py-2">
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-label="Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/></svg>
            </button>
            <a href="{{ path('app_home') }}" class="header-logo">
                {% if site is not null and site.logo is not null %}
                    {{ logo_img(site.logo, 42, site.name|default('')) }}
                {% else %}
                    <img src="{{ asset('images/logo-blogweb.png') }}" alt="Blog&Web" width="52" height="42"/>
                {% endif %}
            </a>
        </div>
        <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar">
            <div class="offcanvas-header">
                <span class="fw-bold">{{ site.name|default('Menu') }}</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
            </div>
            <div class="offcanvas-body">
                <div class="header-search dropdown mb-4" data-controller="search">
                    <form class="bw-search bw-search--block" action="{{ path('app_search_results') }}" method="get" data-search-target="form" data-api-url="{{ path('app_search') }}" data-action="search#doSearch:prevent">
                        <input type="search" name="q" class="bw-search__input" placeholder="Rechercher" aria-label="Rechercher sur le site" data-search-target="q" autocomplete="off">
                        <button class="bw-search__submit" type="submit" aria-label="Lancer la recherche">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.6"/><path d="M10.4 10.4 14 14"/></svg>
                        </button>
                    </form>
                    <div class="dropdown-menu" data-search-target="results"></div>
                </div>
                <ul class="navbar-nav mb-4">
                    {% for menu in header_menus %}
                        <li class="nav-item"><a href="{{ menu|menuLink }}" class="nav-link">{{ menu.name }}</a></li>
                    {% endfor %}
                </ul>
                <div class="d-grid gap-2">
                    <a href="{{ path('app_contact') }}" class="btn bw-cta bw-cta--block">
                        <span>Nous rencontrer</span>
                        {{ bi('arrow-right', 'bw-cta__arrow') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
