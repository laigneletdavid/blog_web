{# ======================================================================
   EN-TETE — BM NOTAIRE
   Surcouche client, prioritaire sur celle du theme (voir base.html.twig).

   Repris du lot livre : pose en transparence par-dessus le visuel, logo
   eclairci par inversion, deux boutons a droite. Il reste fixe au defilement.

   La transparence suppose un fond sombre derriere. L'accueil et les pages de
   pole en ont un ; ailleurs, l'en-tete prend un fond creme et son encre
   habituelle, faute de quoi il deviendrait illisible.
   ====================================================================== #}

{% set _route = app.request.attributes.get('_route') %}
{% set _routes_sombres = ['app_home', 'app_votre_projet', 'app_rendez_vous', 'app_demarrer_dossier'] %}
{% set _sur_visuel = _route in _routes_sombres or (_route == 'app_service_show' and service is defined and service.children|default([])|length > 0) %}

<header class="bm-nav{{ _sur_visuel ? ' bm-nav--clair' : ' bm-nav--plein' }}">
    {% include '_partials/_admin_bar.html.twig' %}

    <div class="bm-nav__barre">
        <a class="bm-nav__marque" href="{{ path('app_home') }}" aria-label="{{ site.name|default('Accueil') }}">
            {% if site is not null and site.logo is not null %}
                {{ logo_img(site.logo, 42, site.name|default('')) }}
            {% else %}
                <img src="{{ asset('images/logo-blogweb.png') }}" alt="Blog&Web" width="52" height="42">
            {% endif %}
        </a>

        <nav class="bm-nav__liens" aria-label="Navigation principale">
            {% for menu in header_menus %}
                <a href="{{ menu|menuLink }}">{{ menu.name }}</a>
            {% endfor %}
        </nav>

        <div class="bm-nav__actions">
            <a class="bm-nav__bouton bm-nav__bouton--plein" href="{{ path('app_simulateurs') }}">
                <span>Simulateurs</span><b aria-hidden="true">↗</b>
            </a>
            <a class="bm-nav__bouton" href="{{ path('app_contact') }}">
                <span class="bm-nav__long">Prendre rendez-vous</span>
                <span class="bm-nav__court">Rendez-vous</span>
                <b aria-hidden="true">↗</b>
            </a>
        </div>

        <button class="bm-nav__burger" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-label="Ouvrir le menu">
            <span></span><span></span>
        </button>
    </div>

    {% if _sur_visuel %}
        {# L'en-tete transparent ne tient que tant qu'un fond sombre le porte.
           Passe le bandeau, il reprend son fond creme : sans cela le visiteur
           se retrouvait avec un logo fantome et des liens invisibles. #}
        <script>
            (function () {
                var barre = document.currentScript.closest('.bm-nav');
                var repere = null;
                var attente = false;

                function regarder() {
                    attente = false;
                    repere = repere || document.querySelector(
                        '.bm-cine .stage, .ph, .bm-dossier .hero, .bm-xp-hero'
                    );
                    if (!repere) { return; }
                    barre.classList.toggle(
                        'bm-nav--pose',
                        repere.getBoundingClientRect().bottom <= barre.offsetHeight
                    );
                }

                function planifier() {
                    if (attente) { return; }
                    attente = true;
                    requestAnimationFrame(regarder);
                }

                document.addEventListener('DOMContentLoaded', regarder);
                window.addEventListener('scroll', planifier, { passive: true });
                window.addEventListener('resize', planifier, { passive: true });
            })();
        </script>
    {% endif %}

    {# Menu deroulant pour les petits ecrans : la barre n'y tient pas. #}
    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar">
        <div class="offcanvas-header">
            <span class="fw-bold">{{ site.name|default('Menu') }}</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="navbar-nav mb-4">
                {% for menu in header_menus %}
                    <li class="nav-item"><a href="{{ menu|menuLink }}" class="nav-link">{{ menu.name }}</a></li>
                {% endfor %}
                <li class="nav-item"><a href="{{ path('app_simulateurs') }}" class="nav-link">Simulateurs</a></li>
            </ul>
            <a href="{{ path('app_contact') }}" class="bm-nav__bouton bm-nav__bouton--plein w-100 justify-content-center">
                <span>Prendre rendez-vous</span><b aria-hidden="true">↗</b>
            </a>
        </div>
    </div>
</header>
