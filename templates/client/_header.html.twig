{# ======================================================================
   EN-TETE — BM NOTAIRE
   Surcouche client, prioritaire sur celle du theme (voir base.html.twig).

   Repris du lot livre : pose en transparence par-dessus le visuel, logo
   eclairci par inversion, deux boutons a droite. Il reste fixe au defilement.

   La transparence suppose un fond sombre derriere. L'accueil et les pages de
   pole en ont un ; ailleurs, l'en-tete prend un fond creme et son encre
   habituelle, faute de quoi il deviendrait illisible.
   ====================================================================== #}

{# Dans la maquette, « Expertises » ne mene pas a la liste des prestations
   mais a la galerie de l'accueil -- le lot pointe d'ailleurs sur
   index.html#expertises depuis ses pages internes, donc une seule adresse
   suffit ici.

   La reecriture se fait dans ce gabarit et non en base : app:menu:sync
   reecrit toujours la route des entrees systeme, et la route l'emporte dans
   menuLink. Corrigee en base, l'entree serait revenue a la liste des
   prestations au premier deploiement, sans bruit. #}
{% set _ancres = { 'services': path('app_home') ~ '#expertises' } %}

{% set _liens = [] %}
{% for menu in header_menus %}
    {% set _liens = _liens|merge([{
        nom: menu.name,
        href: menu.systemKey is not null and _ancres[menu.systemKey] is defined
            ? _ancres[menu.systemKey]
            : menu|menuLink
    }]) %}
{% endfor %}

{% set _route = app.request.attributes.get('_route') %}
{# app_espace_client_envoi y figure aussi : en cas d'erreur, le POST reaffiche
   la meme page, avec le meme bandeau sombre. #}
{% set _routes_sombres = ['app_home', 'app_etude', 'app_votre_projet', 'app_rendez_vous', 'app_demarrer_dossier', 'app_contact', 'app_simulateurs', 'app_simulateur_show', 'app_espace_client', 'app_espace_client_envoi'] %}
{# Les deux niveaux de l'offre ouvrent desormais sur un bandeau sombre. #}
{% set _sur_visuel = _route in _routes_sombres or _route == 'app_service_show' %}

<header class="bm-nav{{ _sur_visuel ? ' bm-nav--clair' : ' bm-nav--plein' }}">
    {% include '_partials/_admin_bar.html.twig' %}

    <div class="bm-nav__barre">
        <a class="bm-nav__marque" href="{{ path('app_home') }}" aria-label="{{ site.name|default('Accueil') }}">
            {% if site is not null and site.logo is not null %}
                {{ logo_img(site.logo, 42, site.name|default('')) }}
            {% else %}
                <img src="{{ asset('images/logo-blogweb.png') }}" alt="Blog&Web" width="52" height="42">
            {% endif %}
        </a>

        <nav class="bm-nav__liens" aria-label="Navigation principale">
            {% for lien in _liens %}
                <a href="{{ lien.href }}">{{ lien.nom }}</a>
            {% endfor %}
        </nav>

        {# La maquette pose deux boutons : « Espace client », en lien simple, et
           « Prendre rendez-vous », en gelule. Les deux libelles se raccourcissent
           ensemble sur les ecrans etroits. #}
        <div class="bm-nav__actions">
            <a class="bm-nav__bouton bm-nav__bouton--discret" href="{{ path('app_espace_client') }}"
               aria-label="Espace client — dépôt documentaire">
                <span class="bm-nav__long">Espace client</span>
                <span class="bm-nav__court">Documents</span>
                <b aria-hidden="true">↗</b>
            </a>
            <a class="bm-nav__bouton bm-nav__bouton--plein" href="{{ path('app_rendez_vous') }}">
                <span class="bm-nav__long">Prendre rendez-vous</span>
                <span class="bm-nav__court">Rendez-vous</span>
                <b aria-hidden="true">↗</b>
            </a>
        </div>

        <button class="bm-nav__burger" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-label="Ouvrir le menu">
            <span></span><span></span>
        </button>
    </div>

    {% if _sur_visuel %}
        {# L'en-tete reste transparent de bout en bout, comme dans la maquette :
           aucune barre ne vient jamais s'y poser.

           Mais la maquette le laisse en creme meme au-dessus de ses sections
           claires, ou il devient invisible. Il passe donc a l'encre quand une
           de ces sections arrive sous lui.

           Les zones claires sont nommees plutot que devinees : lire le fond
           sous l'en-tete echouerait sur le film, dont les plans n'ont pas de
           couleur de fond propre et laisseraient voir le blanc du CMS. #}
        <script>
            (function () {
                var CLAIRES = '.bm-cine .office-story, .bm-cine .manifesto,'
                    + '.bm-portal .cta,'
                    + '.bm-dossier .section:not(.alt), .bm-dossier .final,'
                    + '.bm-xp .xp-overview, .bm-xp .xp-menu, .bm-xp .xp-cta,'
                    + '.bm-d .d-intro, .bm-d .d-docs, .bm-d .d-faq,'
                    + '.bm-ct .ct-info, .bm-ct .ct-hours, .bm-ct .ct-action, .bm-ct .final,'
                    + '.bm-sim';

                var barre = document.currentScript.closest('.bm-nav');
                var zones = null;
                var attente = false;

                function regarder() {
                    attente = false;
                    zones = zones || document.querySelectorAll(CLAIRES);

                    var bas = barre.offsetHeight;
                    var sousLaBarre = false;
                    for (var i = 0; i < zones.length; i++) {
                        var cadre = zones[i].getBoundingClientRect();
                        if (cadre.top < bas && cadre.bottom > 0) {
                            sousLaBarre = true;
                            break;
                        }
                    }

                    barre.classList.toggle('bm-nav--sombre', sousLaBarre);
                }

                function planifier() {
                    if (attente) { return; }
                    attente = true;
                    requestAnimationFrame(regarder);
                }

                document.addEventListener('DOMContentLoaded', regarder);
                window.addEventListener('scroll', planifier, { passive: true });
                window.addEventListener('resize', planifier, { passive: true });
            })();
        </script>
    {% endif %}

    {# Menu deroulant pour les petits ecrans : la barre n'y tient pas. #}
    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar">
        <div class="offcanvas-header">
            <span class="fw-bold">{{ site.name|default('Menu') }}</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="navbar-nav mb-4">
                {% for lien in _liens %}
                    <li class="nav-item"><a href="{{ lien.href }}" class="nav-link">{{ lien.nom }}</a></li>
                {% endfor %}
            </ul>
            <a href="{{ path('app_rendez_vous') }}" class="bm-nav__bouton bm-nav__bouton--plein w-100 justify-content-center">
                <span>Prendre rendez-vous</span><b aria-hidden="true">↗</b>
            </a>
            {# La barre d'actions disparait sous 860px : l'espace client doit
               rester joignable ici, sinon la page n'a plus d'entree mobile. #}
            <a href="{{ path('app_espace_client') }}" class="bm-nav__bouton w-100 justify-content-center mt-2">
                <span>Espace client</span><b aria-hidden="true">↗</b>
            </a>
        </div>
    </div>
</header>
