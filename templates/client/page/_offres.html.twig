{# ======================================================================
   PAGE OFFRES & TARIFS — bw_front (ComWeb Studio)
   Gabarit dessine, meme principe que les pages de bw_lintello : la
   structure vit ici, le titre et la description SEO dans l'admin (page
   « offres »). Formules et prix : client/_offres.html.twig (source unique,
   partagee avec la home). Recap valide par David le 4/11/2026, puis le cout
   sur 3 ans remonte juste apres les prix avec tout ce que couvre l'abonnement.
   ====================================================================== #}
{% import 'client/_macros.html.twig' as m %}
{{ m.symbole_vague() }}

{# Ce que couvre l'abonnement (liste de David, 4/11/2026). « Un rapport chaque
   mois » : app:report:monthly aux admins du site ; « une surveillance chaque
   semaine » : app:site:alerts, aux super admins, seulement en cas de probleme. #}
{% set abonnement = [
    'Hébergement en France, sans limite de taille',
    'Renouvellement de votre nom de domaine',
    'Mises à jour de sécurité du système',
    'Sauvegardes régulières',
    'Toutes les évolutions de ComWeb Studio, sans supplément',
    'Accès illimité à votre administration',
    'Un rapport chaque mois : visites, contacts reçus et santé de votre site',
    'Une surveillance chaque semaine : site en ligne, certificat de sécurité, erreurs. On est prévenus avant vous.',
    'Assistance et formation par téléphone ou visio',
] %}

{# Ce qui est fait a l'installation #}
{% set installation = [
    'Un rendez-vous découverte',
    'Un questionnaire guidé',
    'Votre nom de domaine',
    'La mise en ligne en ½ journée',
    'Une formation de 30 minutes',
] %}

{# Options a la carte (prix HT ; TTC = HT x 1,2) #}
{% set options = [
    { nom: 'Module supplémentaire', prix_ht: 100, texte: 'Événements, Annuaire, Catalogue… : ajoutez le module dont vous avez besoin, hors Blog et Marketing.' },
    { nom: 'Module Marketing', prix_ht: 250, texte: 'Landing pages et statistiques avancées. Déjà inclus dans Click & Collect.' },
    { nom: 'Design sur mesure', prix_ht: 250, texte: 'Nous intégrons le design spécifique de votre choix à la place des thèmes proposés.' },
    { nom: 'Rédaction des contenus', prix_ht: null, texte: 'Pas le temps d’écrire ? Nous rédigeons les textes de votre site.' },
    { nom: 'Fonctionnalité spécifique', prix_ht: null, texte: 'Un besoin qui sort des modules existants ? On en parle, puis on le chiffre.' },
] %}

{# ====== 1. EN-TETE ====== #}
<section class="cw-page-head">
    <div class="container">
        <h1 class="cw-page-head__title">Prix d'un site internet professionnel clé en main</h1>
        <p class="cw-page-head__lead">Pas de devis surprise, pas de coûts cachés.</p>
        <p class="cw-page-head__prix">{% include 'client/_offres.html.twig' with { vue: 'a_partir' } %}</p>
    </div>
</section>

{# ====== 2. LES 3 FORMULES ====== #}
<section class="home-pricing cw-offres-cartes">
    <div class="container">
        <h2 class="visually-hidden">Nos trois formules</h2>
        {% include 'client/_offres.html.twig' with { vue: 'cartes', surPageOffres: true } %}
    </div>
</section>

{# ====== 3. LE COUT SUR 3 ANS ET CE QUE COUVRE L'ABONNEMENT ====== #}
<section class="cw-section cw-section--alt" id="trois-ans">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">Ce que vous payez {{ m.vague('vraiment') }} sur 3 ans</h2>
            <p class="home-section-subtitle">Installation et abonnement compris, hors options. Le seul calcul qui compte pour comparer deux devis.</p>
        </div>
        {% include 'client/_offres.html.twig' with { vue: 'cout' } %}
        <div class="cw-couvre" data-controller="reveal">
            <h3 class="cw-couvre__titre">Ce que couvre votre abonnement, chaque mois</h3>
            <ul class="home-pricing__list cw-couvre__liste">
                {% for ligne in abonnement %}<li>{{ ligne }}</li>{% endfor %}
            </ul>
        </div>
    </div>
</section>

{# ====== 3 bis. WORDPRESS GRATUIT : LE COMPARATIF COURT ======
   Chiffres : client/_wordpress.html.twig (source unique avec la page comparatif). #}
<section class="cw-section" id="wordpress">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">WordPress est gratuit. Votre temps, non.</h2>
            <p class="home-section-subtitle">On vous a dit qu'un site WordPress ne coûtait rien. C'est vrai pour le logiciel. Pour tout le reste, voici la vraie facture sur 3 ans.</p>
        </div>
        {% include 'client/_wordpress.html.twig' with { vue: 'tableau' } %}
        <p class="cw-wp__temps">Sans compter le temps : {% include 'client/_wordpress.html.twig' with { vue: 'heures' } %} pour apprendre à faire son site WordPress soi-même la première année.</p>
        <p class="cw-wp__liens">
            <a href="{{ path('app_page_show', { slug: 'wordpress-gratuit-vrai-cout' }) }}" class="btn btn-outline-primary">Voir le comparatif complet<span class="cw-arrow" aria-hidden="true">&rarr;</span></a>
            <a href="{{ path('app_article_show', { slug: 'combien-coute-vraiment-un-site-internet-professionnel-en-2026' }) }}">Notre article : combien coûte vraiment un site internet professionnel ?</a>
        </p>
    </div>
</section>

{# ====== 4. TABLEAU COMPARATIF ====== #}
<section class="cw-section cw-section--alt" id="comparatif">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">Comparez les formules en détail</h2>
            <p class="home-section-subtitle">Tout ce que comprend chaque formule, ligne par ligne. « En option » : voir les options à la carte juste en dessous.</p>
        </div>
        {% include 'client/_offres.html.twig' with { vue: 'tableau' } %}
    </div>
</section>

{# ====== 5. OPTIONS A LA CARTE ====== #}
<section class="cw-section" id="options">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">Les options à la carte</h2>
            <p class="home-section-subtitle">Votre formule couvre l'essentiel. Pour aller plus loin, vous ajoutez seulement ce qui vous sert.</p>
        </div>
        <ul class="cw-options" data-controller="reveal" data-reveal-stagger-value="70">
            {% for o in options %}
            <li class="cw-options__item">
                <h3 class="cw-options__nom">{{ o.nom }}</h3>
                <p class="cw-options__prix">
                    {% if o.prix_ht %}<strong>+{{ m.euros(o.prix_ht) }} HT</strong> <span>({{ m.euros(o.prix_ht * 1.2) }} TTC)</span>
                    {% else %}<strong>Sur devis</strong>{% endif %}
                </p>
                <p class="cw-options__texte">{{ o.texte }}</p>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# ====== 6. L'INSTALLATION ====== #}
<section class="cw-section cw-section--alt">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">L'installation : ce qu'on fait pour vous</h2>
            <p class="home-section-subtitle">Payée une seule fois, au démarrage. Vous n'avez rien de technique à gérer.</p>
        </div>
        <ol class="cw-installation" data-controller="reveal" data-reveal-stagger-value="70">
            {% for etape in installation %}<li>{{ etape }}</li>{% endfor %}
        </ol>
    </div>
</section>

{# ====== 7. FAQ DES TARIFS ======
   TODO CONTENU : questions à rédiger après les réponses de David (engagement et
   préavis de résiliation ; ce que garde le client s'il arrête : nom de domaine,
   export du contenu ; mode de paiement, mensuel ou annuel ; changement de formule
   en cours de route et son coût). Section non affichée tant qu'elle est vide ;
   prévoir alors les données structurées FAQPage. #}

{# ====== 8. APPEL FINAL ====== #}
<section class="home-cta">
    <div class="container text-center" data-controller="reveal">
        <h2 class="home-cta__title">Parlons de {{ m.vague('votre projet') }}</h2>
        <p class="home-cta__desc">Autour d'un café, au téléphone ou en visio : 30 minutes pour comprendre votre métier et vos besoins. Gratuit et sans engagement.</p>
        <a href="{{ m.lien_rdv() }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Prendre rendez-vous<span class="visually-hidden"> (nouvel onglet)</span><span class="cw-arrow" aria-hidden="true">&rarr;</span></a>
        <p class="cw-cta__second">Pas encore prêt ? <a href="{{ path('app_contact') }}">Demandez le questionnaire</a></p>
    </div>
</section>

{% include 'client/_offres.html.twig' with { vue: 'jsonld' } %}
