{# ======================================================================
   POUR QUI — gabarit commun aux pages Pros, Etudes et A la maison
   Utilise via {% embed %} par client/page/_<slug>.html.twig, qui fournit
   les donnees du public et, au besoin, le bloc propre au public
   (block lt_specific).

   Mise en page de la maquette du 22/10 (artifact « Pages Pour qui
   LintellO — design ») :
     1. heros sur fond bleu doux, sous-menu des publics en onglets
        (Pros, Etudes, A la maison), apercu d'un chat dans le mode du public
     2. « Pourquoi c'est important » : bande bleu fonce, lien Confiance
     3. les modes du public, l'icone de l'app et une phrase chacun
     4. l'offre : titre et bascule mensuel / annuel en tete ; avec
        offer.alt (Pros), deux cartes cote a cote, sinon texte et carte
     5. un bloc propre au public
     6. les guides du tag du public
     7. la FAQ du public, en deux colonnes
     8. l'appel final, le meme que sur l'accueil

   Les guides sont les articles publies des tags poses sur la page
   (relation Tag <-> Page, posee en base). Sans article, le bloc disparait.

   Variables attendues : hero, story, modes, offer (offer.alt facultatif),
   guides, faqs. Les icones des modes viennent de lt.mode_icon (celles de
   l'app).
   Volumes d'IA en niveaux d'usage (handoff v0.4, Q3) : le detail chiffre
   n'est que sur /page/tarifs.
   ====================================================================== #}
{% import 'client/_macros.html.twig' as lt %}

{% set audiences = [
    {label: 'Pros', slug: 'professionnels'},
    {label: 'Études', slug: 'etudiants'},
    {label: 'À la maison', slug: 'particuliers'},
] %}

{# Articles publies des tags de la page, du plus recent au plus ancien #}
{% set guideArticles = [] %}
{% set guideIds = [] %}
{% for tag in page.tags %}
    {% for article in tag.article %}
        {% if article.published and article.id not in guideIds %}
            {% set guideArticles = guideArticles|merge([article]) %}
            {% set guideIds = guideIds|merge([article.id]) %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% set guideArticles = guideArticles|sort((a, b) => (b.publishedAt ?? b.createdAt) <=> (a.publishedAt ?? a.createdAt))|slice(0, 3) %}
{% set guideTag = page.tags|first %}

{% set check %}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4 10-10"/></svg>{% endset %}

<div class="lt-audience" data-lt-audience>

{# ====== 1. HEROS, avec le sous-menu des publics ====== #}
<section class="lt-pq__hero">
    <div class="lt-container">
        <nav class="lt-pq__tabs" aria-label="Pour qui">
            {% for a in audiences %}
                <a href="{{ path('app_page_show', {slug: a.slug}) }}"{% if a.slug == page.slug %} aria-current="page"{% endif %}>{{ a.label }}</a>
            {% endfor %}
        </nav>
    </div>
    <div class="lt-container lt-hero__grid lt-pq__hero-grid">
        <div class="lt-hero__text">
            <p class="lt-eyebrow">{{ hero.eyebrow }}</p>
            <h1 class="lt-page-head__title">{{ hero.title }} <span>{{ hero.accent }}</span></h1>
            <p class="lt-hero__lead">{{ hero.lead }}</p>
            <div class="lt-hero__actions">
                {{ lt.cta(hero.cta, 'lt-btn lt-btn--primary lt-btn--lg') }}
                {% if hero.secondary is defined and hero.secondary %}
                    <a href="{{ hero.secondary.href }}" class="lt-link">{{ hero.secondary.label }}</a>
                {% endif %}
            </div>
            <p class="lt-hero__note">{{ hero.note }}</p>
        </div>

        <div class="lt-hero__visual">
            <div class="lt-chat lt-pq__chat" role="img" aria-label="Exemple de conversation avec LintellO en mode {{ hero.chat.mode }}">
                <div class="lt-chat__head">
                    <img src="{{ asset('images/lintello/icone-lintello.png') }}" alt="" width="22" height="22">
                    <span>{{ hero.chat.title }}</span>
                    <span class="lt-chat__mode">Mode : {{ hero.chat.mode }}</span>
                </div>
                <div class="lt-chat__body" aria-hidden="true">
                    <div class="lt-chat__user">{{ hero.chat.user }}</div>
                    <div class="lt-chat__bot">
                        {% for line in hero.chat.bot %}<p>{{ line }}</p>{% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ====== 2. POURQUOI C'EST IMPORTANT ====== #}
{% if story is defined and story %}
<section class="lt-why-section">
    <div class="lt-container">
        <div class="lt-why">
            <div class="lt-why__head">
                <p class="lt-eyebrow">Pourquoi c’est important</p>
                <h2 class="lt-why__title">{{ story.title }}</h2>
            </div>
            <div class="lt-why__body">
                <p class="lt-why__text">{{ story.text }}</p>
                <a href="{{ path('app_page_show', {slug: 'confiance'}) }}" class="lt-why__link">Voir exactement comment →</a>
            </div>
        </div>
    </div>
</section>
{% endif %}

{# ====== 3. LES MODES DU PUBLIC ====== #}
<section class="lt-pq__section">
    <div class="lt-container">
        <div class="lt-pq__intro">
            <h2 class="lt-h2">{{ modes.title }}</h2>
            <p class="lt-pq__lead">{{ modes.lead }}</p>
        </div>
        <ul class="lt-pq__modes">
            {% for m in modes.items %}
                <li class="lt-pq__mode">
                    <span class="lt-pq__mode-badge">{{ lt.mode_icon(m.name, 20) }}</span>
                    <div>
                        <h3 class="lt-mode__name">{{ m.name }}</h3>
                        <p>{{ m.text }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# ====== 4. L'OFFRE ====== #}
{% set periodSwitch %}
    <div class="lt-segmented" role="group" aria-label="Période de facturation" hidden data-lt-period-group>
        <button type="button" data-lt-period="m" aria-pressed="true">Mensuel</button>
        <button type="button" data-lt-period="y" aria-pressed="false">Annuel · −17 %</button>
    </div>
{% endset %}
{% set detailLink %}<a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-offer__detail">Le détail des volumes →</a>{% endset %}

<section class="lt-pq__section lt-pq__section--grey">
    {% if offer.alt is defined and offer.alt %}
        {# Deux offres cote a cote (Pros : Pro et l'offre LintellO) #}
        <div class="lt-container">
            <div class="lt-pq__offer-head">
                <div class="lt-pq__intro">
                    <h2 class="lt-h2">{{ offer.title }}</h2>
                    <p class="lt-pq__lead">{{ offer.lead }}</p>
                </div>
                {{ periodSwitch }}
            </div>
            <div class="lt-pq__offers">
                <div class="lt-offer__card lt-pq__card lt-pq__card--main">
                    <p class="lt-offer__name">{{ offer.name }}</p>
                    <p class="lt-offer__price">
                        <span class="lt-offer__amount" data-m="{{ offer.m }}" data-y="{{ offer.y }}">{{ offer.m }}</span>
                        <span class="lt-offer__per" data-m="{{ offer.mp }}" data-y="{{ offer.yp }}">{{ offer.mp }}</span>
                    </p>
                    <ul class="lt-offer__points">
                        {% for pt in offer.points %}<li>{{ check }}<span>{{ pt }}</span></li>{% endfor %}
                    </ul>
                    {{ lt.cta(offer.cta, 'lt-btn lt-btn--primary lt-offer__cta') }}
                    {{ detailLink }}
                </div>
                <div class="lt-offer__card lt-pq__card" id="offre-lintello">
                    <p class="lt-offer__name">{{ offer.alt.name }}</p>
                    <p class="lt-offer__price">
                        <span class="lt-offer__amount" data-m="{{ offer.alt.m }}" data-y="{{ offer.alt.y }}">{{ offer.alt.m }}</span>
                        <span class="lt-offer__per" data-m="{{ offer.alt.mp }}" data-y="{{ offer.alt.yp }}">{{ offer.alt.mp }}</span>
                    </p>
                    <p class="lt-pq__card-intro">{{ offer.alt.intro }}</p>
                    <ul class="lt-offer__points">
                        {% for pt in offer.alt.points %}<li>{{ check }}<span>{{ pt }}</span></li>{% endfor %}
                    </ul>
                    {{ lt.cta(offer.alt.cta, 'lt-btn lt-btn--outline lt-offer__cta') }}
                    {{ detailLink }}
                </div>
            </div>
        </div>
    {% else %}
        {# Une offre : le texte a gauche, la carte a droite #}
        <div class="lt-container lt-offer">
            <div class="lt-offer__text">
                <h2 class="lt-h2">{{ offer.title }}</h2>
                <p class="lt-pq__lead">{{ offer.lead }}</p>
                <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link lt-offer__compare">Comparer avec les autres offres →</a>
            </div>
            <div class="lt-offer__card lt-pq__card lt-pq__card--main">
                <div class="lt-offer__top">
                    <div>
                        <p class="lt-offer__name">{{ offer.name }}</p>
                        <p class="lt-offer__price">
                            <span class="lt-offer__amount" data-m="{{ offer.m }}" data-y="{{ offer.y }}">{{ offer.m }}</span>
                            <span class="lt-offer__per" data-m="{{ offer.mp }}" data-y="{{ offer.yp }}">{{ offer.mp }}</span>
                        </p>
                    </div>
                    {{ periodSwitch }}
                </div>
                <ul class="lt-offer__points">
                    {% for pt in offer.points %}<li>{{ check }}<span>{{ pt }}</span></li>{% endfor %}
                </ul>
                {{ lt.cta(offer.cta, 'lt-btn lt-btn--primary lt-offer__cta') }}
                {{ detailLink }}
            </div>
        </div>
    {% endif %}
</section>

{# ====== 5. BLOC PROPRE AU PUBLIC ====== #}
{% block lt_specific %}{% endblock %}

{# ====== 6. LES GUIDES DU TAG ====== #}
{% if guideArticles|length > 0 %}
<section class="lt-pq__section lt-pq__section--guides">
    <div class="lt-container">
        <div class="lt-section__head">
            <h2 class="lt-h3">{{ guides.title }}</h2>
            {% if guideTag %}
                <a href="{{ path('app_tag_show', {slug: guideTag.slug}) }}" class="lt-link">{{ guides.link }} →</a>
            {% endif %}
        </div>
        <div class="lt-cards lt-cards--280">
            {% for article in guideArticles %}
                {% set cat = article.categories|first %}
                <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="lt-card lt-card--link">
                    {% if cat %}<span class="lt-eyebrow">{{ cat.name }}</span>{% endif %}
                    <span class="lt-card__title lt-card__title--sm">{{ article.title }}</span>
                    <span class="lt-post__meta">{{ lt.date_fr(article.publishedAt ?? article.createdAt) }}</span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 7. FAQ DU PUBLIC, en deux colonnes ====== #}
{% if faqs|length > 0 %}
<section class="lt-pq__section lt-pq__faq">
    <div class="lt-container lt-pq__faq-grid">
        <div class="lt-pq__faq-head">
            <h2 class="lt-h2">{{ faqTitle }}</h2>
            <p>Une autre question ? <a href="{{ path('app_faq_index') }}">Toutes les questions</a></p>
        </div>
        <div class="lt-faq__list">
            {% for faq in faqs %}
                <details class="lt-faq__item"{% if loop.first %} open{% endif %}>
                    <summary class="lt-faq__q">
                        <span>{{ faq.q }}</span>
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <div class="lt-faq__a"><p>{{ faq.a }}</p></div>
                </details>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ====== 8. APPEL FINAL (le meme que sur l'accueil) ====== #}
<section class="lt-final lt-final--light">
    <div class="lt-container">
        <div class="lt-final__box">
            <div class="lt-final__text">
                <h2>Votre intello vous attend.</h2>
                <p>Essayez LintellO gratuitement : 20 messages par jour, sans engagement.</p>
            </div>
            <div class="lt-final__actions">
                {{ lt.cta('Commencer gratuitement', 'lt-btn lt-btn--primary lt-btn--lg') }}
                <a href="{{ path('app_page_show', {slug: 'tarifs'}) }}" class="lt-link">Voir les offres</a>
            </div>
        </div>
    </div>
</section>

</div>

<script>
(function () {
    var root = document.querySelector('[data-lt-audience]');
    if (!root) return;
    var group = root.querySelector('[data-lt-period-group]');
    if (!group) return;
    group.hidden = false;
    group.querySelectorAll('[data-lt-period]').forEach(function (b) {
        b.addEventListener('click', function () {
            var p = b.getAttribute('data-lt-period');
            root.querySelectorAll('.lt-offer__card [data-m][data-y]').forEach(function (el) {
                el.textContent = el.getAttribute('data-' + p);
            });
            group.querySelectorAll('[data-lt-period]').forEach(function (x) {
                x.setAttribute('aria-pressed', x === b ? 'true' : 'false');
            });
        });
    });
})();
</script>
