{# ======================================================================
   PAGES LEGALES DU SITE — LintellO
   Mentions legales et politique de confidentialite de la vitrine
   (generees par LegalPageContentService, completees en base).
   Le menu lateral ne renvoie pas vers l'app (decision du 21/10) : la
   politique de confidentialite du site reprend celle de l'app.
   Reutilise par _cgu-cgv-app.html.twig (copie des CGU et CGV de l'app),
   qui change le surtitre via legalEyebrow.
   ====================================================================== #}
{% set legalPages = [
    {label: 'Mentions légales', type: 'mentions-legales', slug: 'mentions-legales'},
    {label: 'Politique de confidentialité', type: 'politique-de-confidentialite', slug: 'politique-confidentialite'},
] %}

<div class="lt-legal">

<section class="lt-page-head lt-legal__head">
    <div class="lt-container">
        <p class="lt-eyebrow">{{ legalEyebrow|default('Informations légales · site lintello.fr') }}</p>
        <h1 class="lt-page-head__title">{{ page.title }}</h1>
    </div>
</section>

<section class="lt-legal__body">
    <div class="lt-container lt-legal__grid">
        <aside class="lt-legal__side">
            <nav class="lt-toc" aria-label="Pages légales">
                <p class="lt-toc__title">Ce site</p>
                <ul class="lt-toc__list">
                    {% for l in legalPages %}
                        <li><a href="{{ path('app_legal_page', {type: l.type}) }}" class="lt-toc__link{{ page.slug == l.slug ? ' widget-toc__link--active' }}"{% if page.slug == l.slug %} aria-current="page"{% endif %}>{{ l.label }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        </aside>

        <article class="lt-prose lt-legal__content">
            {{ page.content|raw }}
        </article>
    </div>
</section>

</div>
