{# ======================================================================
   PAGE « À PROPOS » — bw_cws (spec du 06/11/2026)
   Pleine largeur, sans colonne laterale ni bandeau photo. Le texte vit ici ;
   en base, la page garde titre, slug et SEO. Fiche Person : client/page/show.
   Frise : memes annees que celle de ComWeb Studio (2000, 2016, 2023, 2026),
   plus « Chef de projet marketing digital » (juin 2026, valide par David).
   Ne pas ecrire de phrase sur la confidentialite des donnees vis-a-vis des
   outils d'IA (refusee par David le 06/11/2026).
   ====================================================================== #}
{% import 'client/_macros.html.twig' as m %}
{{ m.symbole_vague() }}

{# ====== 1. HERO ====== #}
<section class="home-hero cws-hero cws-hero--page">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb cws-breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">À propos</li>
            </ol>
        </nav>
        <div class="cws-hero__grille cws-hero__grille--portrait">
            <div>
                <p class="home-hero__overtitle">À propos — David Laignelet</p>
                <h1 class="home-hero__title">J'ai vendu avant de coder. Aujourd'hui, je fais les deux pour {{ m.vague('vous') }}.</h1>
                <p class="home-hero__desc">Vendeur depuis 2000, développeur depuis 2016, chef de projet marketing digital depuis 2026. Je ne suis pas une agence&nbsp;: je suis l'interlocuteur unique qui comprend votre business, construit vos outils et vous aide à vous faire connaître.</p>
                <div class="home-hero__actions">
                    <a href="{{ m.lien_rdv() }}" target="_blank" rel="noopener" class="btn btn-accent btn-lg">Prendre rendez-vous (gratuit)<span class="visually-hidden"> (nouvel onglet)</span></a>
                    <a href="#parcours" class="btn btn-outline-primary btn-lg">Voir mon parcours</a>
                </div>
            </div>
            {% if site.heroImage %}
            <div class="cws-hero__photo cws-hero__photo--portrait">
                {{ responsive_img(site.heroImage, '(max-width: 991px) 100vw, 40vw', 'cws-hero__img', 'David Laignelet, Com Web Solutions', true) }}
            </div>
            {% endif %}
        </div>
    </div>
</section>

{# ====== 2. MON PARCOURS (frise) ====== #}
<section class="cws-section cws-section--alt" id="parcours">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Mon parcours</span>
            <h2 class="home-section-title">26 ans de terrain, trois métiers qui se complètent</h2>
        </div>
        {% set parcours = [
            { date: '2000', titre: 'Le terrain commercial', texte: 'B2B, B2C, produits, services : prospection, négociation, closing, puis direction commerciale.' },
            { date: '2016', titre: 'Le code', texte: "J'apprends à développer, sur le terrain comme pour le commerce : Symfony, PHP, JavaScript, bases de données." },
            { date: '2023', titre: 'Com Web Solutions', texte: 'Je crée ma structure pour réunir les deux : vendre et construire, avec un seul interlocuteur.' },
            { date: 'Juin 2026', titre: 'Chef de projet marketing digital', texte: 'Stratégie de visibilité, référencement, contenus, campagnes : le chaînon entre le commercial et le site.' },
            { date: '2026', titre: 'ComWeb Studio et LintellO', texte: 'Je lance mes propres outils : un CMS français pour les sites de mes clients, et une IA française et confidentielle.' },
        ] %}
        <ol class="cws-frise" data-controller="reveal" data-reveal-stagger-value="70">
            {% for e in parcours %}
            <li class="cws-frise__etape">
                <span class="cws-frise__date">{{ e.date }}</span>
                <h3 class="cws-frise__titre">{{ e.titre }}</h3>
                <p class="cws-frise__texte">{{ e.texte|insecables }}</p>
            </li>
            {% endfor %}
        </ol>
    </div>
</section>

{# ====== 3. TROIS MÉTIERS ====== #}
<section class="cws-section">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Ce que je fais</span>
            <h2 class="home-section-title">Vendre, construire, faire connaître</h2>
        </div>
        <div class="cws-cartes cws-cartes--3" data-controller="reveal" data-reveal-stagger-value="90">
            <div class="cws-carte">
                <span class="cws-num" aria-hidden="true">01</span>
                <h3>Le commerce</h3>
                <p>Prospection B2B, direction commerciale externalisée, réponse aux appels d'offres. En Occitanie uniquement, avec le réseau <a href="https://enleys.com/" target="_blank" rel="noopener">Enleys <span aria-hidden="true">&#x2197;&#xFE0E;</span><span class="visually-hidden"> (nouvel onglet)</span></a>.</p>
                <a href="/page/developpement-commercial" class="cws-carte__lien">Développement commercial <span class="cw-arrow" aria-hidden="true">→</span></a>
            </div>
            <div class="cws-carte">
                <span class="cws-num" aria-hidden="true">02</span>
                <h3>Le web et l'IA</h3>
                <p>Sites sur ComWeb Studio, applications sur mesure, IA française et confidentielle avec LintellO. Partout en France.</p>
                <a href="/service/votre-site-web" class="cws-carte__lien">Votre site web <span class="cw-arrow" aria-hidden="true">→</span></a>
            </div>
            <div class="cws-carte">
                <span class="cws-num" aria-hidden="true">03</span>
                <h3>Le marketing digital</h3>
                <p>Être trouvé sur Google, publier les bons contenus, mesurer ce qui marche. C'est ce qui relie votre site à votre prospection.</p>
            </div>
        </div>
        <p class="cws-formules__note">Un seul interlocuteur, du premier appel à la mise en ligne. Pas de jargon, pas de chargé de compte.</p>
    </div>
</section>

{# ====== 4. MA FAÇON DE TRAVAILLER (fonce) ====== #}
<section class="cws-section cws-section--dark">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Ma façon de travailler</span>
            <h2 class="home-section-title">Seul, je livre ce que livrait une équipe</h2>
            <p>Je développe avec l'aide de l'IA, comme je le recommande à mes clients. Elle me fait gagner du temps sur l'exécution&nbsp;; je garde la conception, le contrôle de chaque livraison et la responsabilité du résultat. C'est ce qui me permet de livrer plus vite, sans multiplier les intermédiaires.</p>
        </div>
        <ul class="cws-atouts" data-controller="reveal" data-reveal-stagger-value="70">
            <li><h3>Je conçois.</h3><p>Je comprends votre métier avant d'écrire la moindre ligne.</p></li>
            <li><h3>Je vérifie.</h3><p>Chaque livraison est relue, testée, sécurisée.</p></li>
            <li><h3>Je réponds.</h3><p>Une question, un souci&nbsp;: vous m'appelez, moi directement.</p></li>
        </ul>
    </div>
</section>

{# ====== 5. BASÉ DANS LE COMMINGES ====== #}
<section class="cws-section">
    <div class="container">
        <div class="cws-ou">
            <div class="cws-section__head">
                <span class="home-overtitle">Où je travaille</span>
                <h2 class="home-section-title">Basé dans le Comminges, disponible partout</h2>
                <p>Mon bureau est à Montsaunès, au pied des Pyrénées. Pour le web et l'IA, je travaille avec des clients partout en France, en visio ou en présentiel selon ce qui vous arrange. Pour le développement commercial, j'interviens en Occitanie.</p>
            </div>
            <ul class="cws-contact__coord cws-ou__infos">
                <li><span class="cws-contact__label">Bureau</span>Montsaunès (31260)</li>
                {% if site.phone %}<li><span class="cws-contact__label">Téléphone</span><a href="tel:{{ site.phone|phone|replace({' ': ''}) }}">{{ site.phone|phone }}</a></li>{% endif %}
                {% if site.email %}<li><span class="cws-contact__label">E-mail</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
            </ul>
        </div>
    </div>
</section>

{# ====== 6. MA PHILOSOPHIE ====== #}
<section class="cws-section cws-section--alt">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Ma philosophie</span>
            <h2 class="home-section-title">Direct, concret, terrain</h2>
            <p>Je ne fais pas de jargon. Je ne vous parlerai pas de «&nbsp;synergie&nbsp;» ni d'«&nbsp;écosystème&nbsp;». Je parle comme je vends&nbsp;: simplement, avec des exemples concrets.</p>
            <p>Quand je peux vous aider, je vous le dis. Quand je ne peux pas, je vous le dis aussi, et je vous oriente vers quelqu'un qui peut.</p>
        </div>
        <p class="cws-encadre">En parallèle, j'enseigne les techniques commerciales. Expliquer simplement ce qu'on fait, c'est aussi mon métier.</p>
    </div>
</section>

{# ====== 7. TÉMOIGNAGE (Camille Dassieu, texte de la home) ====== #}
{% set avis = site.getGalleryBySlot('testimonial')|filter(t => t.title starts with 'Camille Dassieu')|first %}
{% if avis %}
{% set parts = avis.title|split(' — ', 2) %}
<section class="cws-section">
    <div class="container">
        {# Titre pour la structure de la page (lecteurs d ecran, moteurs), masque a l ecran #}
        <h2 class="visually-hidden">Ce qu'en disent mes clients</h2>
        <figure class="cws-temoignage-seul">
            <span class="cws-temoignage__guillemet" aria-hidden="true">“</span>
            <blockquote><p>{{ avis.content }}</p></blockquote>
            <figcaption><strong>{{ parts|first }}</strong>{% if parts|length > 1 %} <span>{{ parts|last }}</span>{% endif %}</figcaption>
        </figure>
    </div>
</section>
{% endif %}

{# ====== 8. APPEL FINAL ====== #}
{% include 'client/_cta_final.html.twig' with {
    cta_texte: "Pas d'engagement, pas de présentation commerciale. On parle de votre entreprise, de ce qui bloque, et je vous dis honnêtement si je peux aider."
} %}
