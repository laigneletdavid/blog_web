{# Exemples de la demo (a verifier dans l'app avant publication) #}
{% set modeExamples = [
    {q: 'Je ne comprends toujours pas les fractions', mode: 'Tout s’explique'},
    {q: 'Aide-moi à répondre à un client mécontent', mode: 'Relation client'},
    {q: 'Une idée de cadeau pour les 40 ans de ma sœur', mode: 'Créatif'},
    {q: 'Relis cette clause de mon contrat de prestation', mode: 'Juriste'},
