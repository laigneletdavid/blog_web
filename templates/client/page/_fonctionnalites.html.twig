{% set options = [
    { icone: 'evenements', nom: 'Événements', prix: prix_module, texte: 'Portes ouvertes, ateliers, marchés, formations : date, lieu, description et inscription. Vos abonnés sont prévenus à chaque nouvel événement.', ideal: ['formateurs', 'associations', 'commerces avec des animations', 'thérapeutes qui organisent des ateliers'] },
    { icone: 'annuaire', nom: 'Annuaire', prix: prix_module, texte: 'Contacts, partenaires, membres ou points de vente, chacun avec sa fiche, consultables en quelques clics.', ideal: ['associations', 'réseaux professionnels', 'franchises', 'groupements d’artisans'] },
    { icone: 'catalogue', nom: 'Catalogue', prix: prix_module, texte: 'Vos produits avec fiche, photo, description et prix : une vitrine organisée, sans vente en ligne. Inclus dans Click & Collect.', ideal: ['commerçants', 'artisans créateurs', 'producteurs', 'traiteurs'] },
    { icone: 'marketing', nom: 'Marketing', prix: prix_marketing, texte: 'Landing pages et statistiques avancées pour vos campagnes. Inclus dans Click & Collect.', ideal: ['ceux qui font de la publicité en ligne', 'lancent une nouvelle offre', 'remplissent une session de formation'] },
] %}

