{# ====== 3. LES MODES (demo : un exemple allume le mode) ====== #}
<section class="lt-fx__section lt-fx__section--grey" id="modes">
    <div class="lt-container lt-fx__modes" data-lt-modes>
        <div class="lt-fx__modes-text">
            <p class="lt-eyebrow">Les modes</p>
            <h2 class="lt-h2">Vous posez la question. LintellO prend le bon mode.</h2>
            <p class="lt-fx__lead">Dix-huit modes, pour apprendre, pour la maison et pour le travail. Pas de réglage : LintellO s’adapte à votre demande. Ctrl+M pour choisir vous-même.</p>
            <p class="lt-fx__hint">Choisissez un exemple : le mode qui répond s’allume parmi les dix-huit.</p>
            <div class="lt-fx__examples">
                {% for e in modeExamples %}
                    <button type="button" class="lt-fx__example" data-mode="{{ e.mode }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">« {{ e.q }} »</button>
                {% endfor %}
            </div>
        </div>
        <div class="lt-fx__board">
            {% for g in modeGroups %}
                <div class="lt-fx__group">
                    <p class="lt-fx__group-name">{{ g.name }}</p>
                    <div class="lt-fx__pills">
                        {% for m in g.modes %}
                            <button type="button" class="lt-fx__pill" data-mode="{{ m.name }}" data-text="{{ m.text }}" aria-pressed="{{ m.name == firstMode ? 'true' : 'false' }}">{{ lt.mode_icon(m.name, 16) }}{{ m.name }}</button>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
            <div class="lt-fx__active" aria-live="polite">
                <p class="lt-fx__active-name">Mode {{ firstMode }}</p>
                <p class="lt-fx__active-text">{{ firstText }}</p>
            </div>
        </div>
        <p class="lt-fx__offers">Gratuit : la découverte des modes et 3 essais par mois. Étudiant : les 5 modes Études. Perso : Études et Maison. Pro : les 18. LintellO : les 18, et bientôt vos propres modes.</p>
        <p class="lt-fx__links">
            <a href="{{ path('app_page_show', {slug: 'etudiants'}) }}" class="lt-link">Études →</a>
            <a href="{{ path('app_page_show', {slug: 'particuliers'}) }}" class="lt-link">À la maison →</a>
            <a href="{{ path('app_page_show', {slug: 'professionnels'}) }}" class="lt-link">Pros →</a>
        </p>
    </div>
</section>

<script>
/* Modes : un exemple ou une pastille allume le mode et affiche sa phrase.
   Ecouteurs poses sur la section seulement. */
(function () {
    var root = document.querySelector('[data-lt-modes]');
    if (!root) return;
    var pills = Array.prototype.slice.call(root.querySelectorAll('.lt-fx__pill'));
    var examples = Array.prototype.slice.call(root.querySelectorAll('.lt-fx__example'));
    var name = root.querySelector('.lt-fx__active-name');
    var text = root.querySelector('.lt-fx__active-text');

    function light(mode, example) {
        pills.forEach(function (p) {
            var on = p.getAttribute('data-mode') === mode;
            p.setAttribute('aria-pressed', on ? 'true' : 'false');
            if (on) {
                name.textContent = 'Mode ' + mode;
                text.textContent = p.getAttribute('data-text');
            }
        });
        examples.forEach(function (e) {
            e.setAttribute('aria-pressed', e === example ? 'true' : 'false');
        });
    }
    examples.forEach(function (e) {
        e.addEventListener('click', function () { light(e.getAttribute('data-mode'), e); });
    });
    pills.forEach(function (p) {
        p.addEventListener('click', function () { light(p.getAttribute('data-mode'), null); });
    });
})();
</script>

