{# ======================================================================
   PAGE FONCTIONNALITES — bw_front (ComWeb Studio)
   Brief du 4/11/2026. La page Tarifs fait foi pour ce qui est inclus ou en
   option ; prix des options dans client/_offres.html.twig. Textes repris de la
   page d'origine (dont tous les « Idéal pour »). Référencement et rapport
   mensuel décrits d'après le code : SeoAnalyzer (score par contenu),
   SeoIntentChecker (bilan de la fiche Référencement), MonthlyReportBuilder.
   Titre et description SEO dans l'admin (page « fonctionnalites »).
   ====================================================================== #}
{% import 'client/_macros.html.twig' as m %}
{{ m.symbole_vague() }}

{% set prix_module = include('client/_offres.html.twig', { vue: 'prix_option', option: 'module' })|trim %}
{% set prix_marketing = include('client/_offres.html.twig', { vue: 'prix_option', option: 'marketing' })|trim %}

