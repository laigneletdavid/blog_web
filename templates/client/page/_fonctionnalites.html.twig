{# Mobile : retour en haut, visible une fois le hero depasse #}
<a href="#haut" class="lt-fx__top" data-lt-top hidden>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    Retour en haut
</a>
<script>
(function () {
    var top = document.querySelector('[data-lt-top]');
    var hero = document.getElementById('haut');
    if (!top || !hero || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (entries) {
        top.hidden = entries[0].isIntersecting;
    }).observe(hero);
})();
</script>

