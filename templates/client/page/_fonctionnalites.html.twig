    'paiement': '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>',
    'marketing': '<path d="M3 11l15-6v14L3 13z"/><path d="M7 12.5V18a2 2 0 0 0 4 0v-3.5"/>',
    'evenements': '<rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/>',
    'annuaire': '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><line x1="17" y1="8" x2="22" y2="8"/><line x1="17" y1="12" x2="22" y2="12"/>'
} %}

{% macro ideal(liste) %}<p class="cw-ideal"><span class="cw-ideal__label">Idéal pour</span>{% for x in liste %}<span class="cw-ideal__tag">{{ x }}</span>{% endfor %}</p>{% endmacro %}

{# ====== 1. EN-TETE ====== #}
<section class="cw-page-head">
    <div class="container">
        <h1 class="cw-page-head__title">Tout ce dont votre site a besoin, {{ m.vague('déjà intégré') }}</h1>
        <p class="cw-page-head__lead">Pas d'extension à installer, pas de mise à jour qui casse tout. On active, vous utilisez.</p>
        <ul class="cw-badges">
            <li>0 extension</li>
            <li>Activé pour vous</li>
            <li>Mis à jour pour vous</li>
        </ul>
    </div>
</section>

{# ====== 2. LE SOCLE ====== #}
<section class="cw-section cw-section--alt" id="socle">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">Le socle, inclus dans toutes les formules</h2>
            <p class="home-section-subtitle">Vitrine, Blog ou Click & Collect : tout ceci est dans votre site dès la mise en ligne… et trois outils qui changent tout, détaillés juste en dessous.</p>
        </div>
        <ul class="cw-fonc-grille" data-controller="reveal" data-reveal-stagger-value="60">
            {% for c in socle %}
            <li class="cw-fonc-carte">
                <span class="cw-fonc-carte__icone">{{ _self.icone(icones[c.icone]) }}</span>
                <h3 class="cw-fonc-carte__titre">{{ c.titre }}</h3>
                <p class="cw-fonc-carte__texte">{{ c.texte }}</p>
                {{ _self.ideal(c.ideal) }}
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# ====== 3. EN VEDETTE ====== #}
<section class="cw-section home-features" id="vedette">
    <div class="container">
        <h2 class="home-section-title text-center" data-controller="reveal">Ce qui fait la différence au quotidien</h2>
        {% for v in vedettes %}
        <div class="home-feature-row{{ loop.index is even ? ' home-feature-row--inverse' }}">
            <div class="home-feature-row__text" data-controller="reveal">
                <p class="cw-fonc-surtitre">{{ v.surtitre }}</p>
                <h3 class="home-feature-row__title">{{ v.titre }}</h3>
                <p class="home-feature-row__desc">{{ v.texte }}</p>
                <ul class="home-pricing__list cw-fonc-points">
                    {% for p in v.points %}<li>{{ p }}</li>{% endfor %}
                </ul>
            </div>
            <div class="home-feature-row__visual" data-controller="reveal" data-reveal-from-value="{{ loop.index is even ? 'left' : 'right' }}">
                <div class="cw-browser cw-browser--maquette" aria-hidden="true">
                    <div class="cw-browser__bar"><span class="cw-browser__dots"><i></i><i></i><i></i></span></div>
                    <div class="cw-browser__maquette">
                        {{ _self.icone(icones[v.icone], 56) }}
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>

{# ====== 4. AVEC L'OFFRE BLOG ====== #}
<section class="cw-section cw-section--alt" id="blog">
    <div class="container">
        <div class="cw-fonc-formule" data-controller="reveal">
            <div class="cw-fonc-formule__tete">
                <p class="cw-fonc-surtitre">Avec l'offre Blog</p>
                <h2 class="home-section-title">Le blog qui vous amène des clients</h2>
            </div>
            <div class="cw-fonc-carte cw-fonc-carte--large">
                <span class="cw-fonc-carte__icone">{{ _self.icone(icones['blog']) }}</span>
                <h3 class="cw-fonc-carte__titre">Blog — articles, catégories, tags</h3>
                <p class="cw-fonc-carte__texte">Publiez des articles sur votre métier, vos actualités, vos conseils. Ils sont classés par catégories et par tags, et chaque article publié est une porte d'entrée de plus sur Google.</p>
                <p class="cw-fonc-carte__plus">Vos abonnés sont prévenus par email à chaque nouvel article, automatiquement.</p>
                {{ _self.ideal(['tous ceux qui veulent être trouvés sur Google', 'montrer leur expertise']) }}
            </div>
        </div>
    </div>
</section>

{# ====== 5. AVEC CLICK & COLLECT ====== #}
<section class="cw-section" id="click-collect">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <p class="cw-fonc-surtitre">Avec Click & Collect</p>
            <h2 class="home-section-title">Vos clients commandent en ligne, et passent chercher</h2>
            <p class="home-section-subtitle"><strong>Aucune commission sur vos ventes</strong> : vous ne payez que les frais Stripe standards.</p>
        </div>
        <ul class="cw-fonc-grille cw-fonc-grille--4" data-controller="reveal" data-reveal-stagger-value="60">
            <li class="cw-fonc-carte">
                <span class="cw-fonc-carte__icone">{{ _self.icone(icones['catalogue']) }}</span>
                <h3 class="cw-fonc-carte__titre">Catalogue</h3>
                <p class="cw-fonc-carte__texte">Vos produits avec fiche, photo, description, prix et catégorie. Vos clients parcourent votre offre comme dans une boutique.</p>
            </li>
            <li class="cw-fonc-carte">
                <span class="cw-fonc-carte__icone">{{ _self.icone(icones['commande']) }}</span>
                <h3 class="cw-fonc-carte__titre">Commande en ligne</h3>
                <p class="cw-fonc-carte__texte">Vos clients commandent et paient en ligne, vous êtes prévenu, ils viennent récupérer leur commande sur place.</p>
            </li>
            <li class="cw-fonc-carte">
                <span class="cw-fonc-carte__icone">{{ _self.icone(icones['paiement']) }}</span>
                <h3 class="cw-fonc-carte__titre">Paiement Stripe</h3>
                <p class="cw-fonc-carte__texte">Paiement sécurisé par carte bancaire. Aucune commission ComWeb Studio, seulement les frais Stripe standards.</p>
            </li>
            <li class="cw-fonc-carte">
                <span class="cw-fonc-carte__icone">{{ _self.icone(icones['marketing']) }}</span>
                <h3 class="cw-fonc-carte__titre">Marketing</h3>
                <p class="cw-fonc-carte__texte">Landing pages et statistiques avancées pour mesurer vos campagnes.</p>
            </li>
        </ul>
        <p class="cw-fonc-ideal-centre">{{ _self.ideal(['artisans créateurs', 'producteurs locaux', 'petits commerces qui vendent en complément de leur boutique']) }}</p>
    </div>
</section>

{# ====== 6. LES MODULES EN OPTION ====== #}
<section class="cw-section cw-section--alt" id="options">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">Les modules en option</h2>
            <p class="home-section-subtitle">Ajoutés à votre formule en une seule fois, sans surcoût mensuel. On l'active, vous l'utilisez.</p>
        </div>
        <ul class="cw-options cw-options--fonc" data-controller="reveal" data-reveal-stagger-value="70">
            {% for o in options %}
            <li class="cw-options__item">
                <span class="cw-fonc-carte__icone">{{ _self.icone(icones[o.icone]) }}</span>
                <h3 class="cw-options__nom">{{ o.nom }}</h3>
                <p class="cw-options__prix"><strong>+{{ m.euros(o.prix) }} HT</strong> <span>({{ m.euros(o.prix * 1.2) }} TTC)</span></p>
                <p class="cw-options__texte">{{ o.texte }}</p>
                {{ _self.ideal(o.ideal) }}
            </li>
            {% endfor %}
        </ul>
        <p class="cw-sources">Événements, Annuaire et Catalogue : {{ m.euros(prix_module) }} HT chacun, une seule fois. Marketing : {{ m.euros(prix_marketing) }} HT. Le blog est inclus dans l'offre Blog.</p>
    </div>
</section>

{# ====== 7. COMMENT CA MARCHE ====== #}
<section class="cw-section">
    <div class="container">
        <div class="text-center" data-controller="reveal">
            <h2 class="home-section-title">Comment ça marche</h2>
        </div>
        <ol class="cw-installation cw-installation--3" data-controller="reveal" data-reveal-stagger-value="70">
            <li>Vous choisissez votre formule et vos modules</li>
            <li>On les active : ils sont déjà dans votre site</li>
            <li>Vous n'avez rien à mettre à jour, jamais</li>
        </ol>
    </div>
</section>

{# ====== 8. APPEL FINAL ====== #}
<section class="home-cta cw-cta--alt">
    <div class="container text-center" data-controller="reveal">
        <h2 class="home-cta__title">Une question sur {{ m.vague('une fonctionnalité') }} ?</h2>
        <p class="home-cta__desc">30 minutes pour regarder ce dont votre activité a besoin, et la formule qui va avec. Gratuit et sans engagement.</p>
        <a href="{{ m.lien_rdv() }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Prendre rendez-vous<span class="visually-hidden"> (nouvel onglet)</span><span class="cw-arrow" aria-hidden="true">&rarr;</span></a>
        <p class="cw-cta__second"><a href="{{ path('app_page_show', { slug: 'offres' }) }}#comparatif">Comparer les formules</a></p>
    </div>
</section>
