        {name: 'Quizz Master', text: 'Vous fait réviser par questions progressives, QCM, vrai ou faux ou questions ouvertes, et tient le score.'},
        {name: 'Langues', text: 'Converse dans la langue que vous pratiquez et corrige vos erreurs en les expliquant.'},
        {name: 'Rédacteur étudiant', text: 'Corrige votre texte en expliquant chaque règle, sans écrire le devoir à votre place.'},
    ]},
    {name: 'À la maison', modes: [
        {name: 'Coach de vie', text: 'Des conseils pratiques pour décider, vous organiser et avancer sur vos projets.'},
        {name: 'Rédacteur', text: 'E-mails, lettres, CV et textes personnels, rédigés avec vous.'},
        {name: 'Créatif', text: 'Des idées et de l’inspiration quand il faut trouver un angle, un nom, un cadeau.'},
        {name: 'Santé & Sport', text: 'Entraînement, nutrition et bien-être, sans remplacer l’avis d’un professionnel.'},
    ]},
    {name: 'Pros', modes: [
        {name: 'Rédacteur Pro', text: 'Rapports, documentation, propositions et e-mails formels.'},
        {name: 'Relation client', text: 'Service client, échanges commerciaux et négociation.'},
        {name: 'Expert marketing', text: 'Référencement, rédaction persuasive, réseaux sociaux et conversion.'},
        {name: 'Développeur', text: 'Code, débogage, architecture et documentation technique.'},
        {name: 'Analyste', text: 'Synthèse, extraction et comparaison de documents.'},
        {name: 'Juriste', text: 'Contrats, conformité et langage juridique, avec prudence. Il ne remplace pas un avocat.'},
        {name: 'RH & Management', text: 'Recrutement, management d’équipe et questions de droit du travail.'},
        {name: 'Coach dirigeant', text: 'Prendre une décision, prendre du recul, piloter.'},
        {name: 'Stratège business', text: 'Stratégie, développement, business plan et projets.'},
    ]},
