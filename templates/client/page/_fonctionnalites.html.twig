    { icone: 'services', titre: 'Services', texte: 'Chaque prestation a sa fiche : titre, description, image et page détaillée. Vos visiteurs comprennent en un coup d’œil ce que vous proposez.', ideal: ['artisans', 'consultants', 'prestataires de services', 'coachs', 'thérapeutes'] },
    { icone: 'faq', titre: 'FAQ', texte: 'Répondez aux questions que vos clients posent tout le temps, avant même qu’ils appellent. Bonus : Google aime les FAQ bien structurées.', ideal: ['tous ceux qui reçoivent les mêmes questions par téléphone ou par email'] },
    { icone: 'realisations', titre: 'Réalisations', texte: 'Photos de chantiers, projets livrés, avant/après : vos réalisations parlent mieux qu’un long discours.', ideal: ['artisans du bâtiment', 'photographes', 'designers', 'architectes', 'paysagistes'] },
] %}

