{# JSON-LD Service des fiches commerce : zone Occitanie et prix.
   Variables : nom, description, et soit prix + unite (une offre), soit offres
   (liste de { nom, prix, unite }). #}
{% set listeOffres = [] %}
{% for o in offres|default([{ nom: nom, prix: prix|default(''), unite: unite|default('') }]) %}
    {% set listeOffres = listeOffres|merge([{ '@type': 'Offer', 'name': o.nom, 'priceCurrency': 'EUR', 'price': o.prix, 'description': o.unite }]) %}
{% endfor %}
<script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@type': 'Service',
    'name': nom,
    'description': description,
    'areaServed': { '@type': 'AdministrativeArea', 'name': 'Occitanie' },
    'provider': { '@type': 'ProfessionalService', 'name': site.name|default('Com Web Solutions'), 'url': absolute_url('/') },
    'offers': listeOffres|length == 1 ? listeOffres|first : listeOffres
}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
