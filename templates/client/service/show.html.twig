{# ====== FICHE SERVICE — bw_cws ======
   Une fiche dessinee a son gabarit client/service/_<slug>.html.twig (page IA) ;
   les autres gardent le rendu commun, avec l'appel final de la home en bas
   (brief 4.6). Le fil d'Ariane suit la rubrique du menu (main, 05/11/2026). #}
{% if source('client/service/_' ~ service.slug ~ '.html.twig', true) is not empty %}
    {% include 'client/service/_' ~ service.slug ~ '.html.twig' %}
{% else %}
    {% include 'service/_show_generic.html.twig' %}
    {% include 'client/_cta_final.html.twig' %}
{% endif %}
