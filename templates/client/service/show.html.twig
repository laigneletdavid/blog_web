{# ======================================================================
   SERVICE — BM NOTAIRE
   Surcouche client, prioritaire sur le rendu commun (service/show.html.twig).

   Le meme fichier sert les deux niveaux de l'offre, dont la maquette donne
   deux decoupages distincts :
     - un pole  : hero plein ecran, approche, besoins, accompagnement, echange,
                  balisage et styles repris d'expertise.css sous .bm-xp ;
     - une prestation : hero, propos, parcours, pieces, questions, echange.
   La distinction se lit dans l'arborescence, pas dans un champ a cocher.

   Les intitules numerotes ("01 / NOTRE APPROCHE") sont constants d'une page a
   l'autre : ils vivent donc ici, et non dans le contenu de chaque service.
   ====================================================================== #}

{% set est_pole = children|default([])|length > 0 %}

{% if est_pole %}

    {# L'import a range le contenu du pole dans un ordre constant, verifie sur
       les quatre poles : la vision d'ensemble, puis le propos d'accompagnement,
       puis trois axes de la forme « Titre — description ».

       On relit donc les paragraphes dans l'ordre plutot que d'ajouter des
       champs a l'entite. Si un pole s'ecartait de cette forme, les sections
       concernees disparaissent au lieu de s'afficher de travers. #}
    {% set paragraphes = service.content|default('')|split('<p>')|slice(1)
        |map(bloc => bloc|split('</p>')[0]|trim)
        |filter(bloc => bloc is not empty) %}

    {% set apercu = paragraphes[0]|default('') %}
    {% set propos = paragraphes[1]|default('') %}
    {% set axes = paragraphes|slice(2)|filter(axe => ' — ' in axe) %}

    {# Les styles d'expertise.css sont repris sous .bm-xp : la feuille visait
       html, body et a, elle aurait repeint le site. #}
    <div class="bm-xp">

    {# ====== 01. HERO ====== #}
    <section class="xp-hero">
        {% if service.image %}
            <div class="xp-bg" style="background-image:url('{{ asset('documents/medias/' ~ (service.image.webpFileName ?? service.image.fileName)) }}')"></div>
        {% endif %}
        <div class="xp-shade"></div>

        <div class="xp-hero-copy">
            <p class="xp-kicker">BM NOTAIRE · EXPERTISE</p>
            <h1>{{ service.title }}</h1>
            {% if service.shortDescription %}
                <p class="xp-intro">{{ service.shortDescription }}</p>
            {% endif %}
        </div>

        {# Le lot laisse cette mention inerte ; elle mene ici la ou elle invite. #}
        <a class="xp-scroll" href="#accompagnement">DÉCOUVRIR ↓</a>
    </section>

    {# ====== 02. NOTRE APPROCHE ====== #}
    {% if apercu %}
        <section class="xp-overview">
            <div><span class="xp-no">01 / NOTRE APPROCHE</span></div>
            <div>
                <h2>Une vision<br><em>d’ensemble.</em></h2>
                <p>{{ apercu|raw }}</p>
            </div>
        </section>
    {% endif %}

    {# ====== 03. VOS BESOINS ====== #}
    <section class="xp-menu">
        <div class="xp-menu-head">
            <span class="xp-no">02 / VOS BESOINS</span>
            <h2>Comment pouvons-nous<br>vous accompagner&nbsp;?</h2>
        </div>

        <div class="xp-list">
            {% for enfant in children %}
                <a href="{{ path('app_service_show', { slug: enfant.slug }) }}">
                    <span class="n">{{ '%02d'|format(loop.index) }}</span>
                    <h3>{{ enfant.title }}</h3>
                    <p>{{ enfant.shortDescription }}</p>
                    <b aria-hidden="true">↗</b>
                </a>
            {% endfor %}
        </div>
    </section>

    {# ====== 04. ACCOMPAGNEMENT ====== #}
    {% if propos or axes %}
        <section class="xp-detail" id="accompagnement">
            <div class="xp-detail-head">
                <div><span class="xp-no">03 / ACCOMPAGNEMENT</span></div>
                <div>
                    <h2>Du projet<br><em>à l’acte.</em></h2>
                    {% if propos %}<p class="lead">{{ propos|raw }}</p>{% endif %}
                </div>
            </div>

            {% if axes %}
                <div class="xp-cards">
                    {% for axe in axes %}
                        {% set coupe = axe|split(' — ', 2) %}
                        <article class="xp-card">
                            <span>{{ '%02d'|format(loop.index) }}</span>
                            <h3>{{ coupe[0]|striptags }}</h3>
                            <p>{{ coupe[1]|default('')|raw }}</p>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    {% endif %}

    {# ====== 05. ECHANGEONS ====== #}
    <section class="xp-cta">
        <span class="xp-no">04 / ÉCHANGEONS</span>
        <h2>Parlons de<br><em>votre projet.</em></h2>
        <p>
            Un premier échange permet d’identifier votre besoin, les documents à
            réunir et les prochaines étapes.
        </p>
        <a class="xp-button" href="{{ path('app_rendez_vous') }}">Prendre rendez-vous ↗</a>
    </section>

    </div>{# /.bm-xp #}

{% else %}

    {# ====== PRESTATION ======
       L'import a range le contenu dans un ordre constant, verifie sur les
       trente-deux prestations : un chapeau d'introduction, puis trois blocs
       ouverts par un <h3> -- le parcours en liste numerotee, les pieces en
       liste a puces suivies de leur reserve, et les questions en paires
       <h4>/<p>.

       On relit donc ce decoupage plutot que d'ajouter des champs a l'entite.
       Un contenu qui s'en ecarterait perdrait les sections concernees au lieu
       de les afficher de travers. #}

    {% set contenu = service.content|default('') %}
    {% set blocs = contenu|split('<h3>') %}

    {% set intro = blocs[0]|default('')|split('<p>')|slice(1)
        |map(bloc => bloc|split('</p>')[0]|trim)|first|default('') %}

    {# Chaque bloc porte son intitule, puis son corps. Les intitules du lot
       sont constants, on ne garde donc que les corps, dans l'ordre. #}
    {% set corps = blocs|slice(1)|map(bloc => bloc|split('</h3>')[1]|default('')) %}

    {% set etapes = (corps[0]|default(''))|split('<li>')|slice(1)
        |map(item => item|split('</li>')[0]|striptags|trim)
        |filter(item => item is not empty) %}

    {% set pieces = (corps[1]|default(''))|split('<li>')|slice(1)
        |map(item => item|split('</li>')[0]|striptags|trim)
        |filter(item => item is not empty) %}

    {# La reserve suit la liste des pieces, hors de celle-ci. #}
    {% set reserve = (corps[1]|default('')|split('</ul>')[1]|default(''))
        |split('<p>')|slice(1)|map(bloc => bloc|split('</p>')[0]|trim)|first|default('') %}

    {% set questions = (corps[2]|default(''))|split('<h4>')|slice(1)
        |map(bloc => {
            question: bloc|split('</h4>')[0]|striptags|trim,
            reponse: bloc|split('<p>')[1]|default('')|split('</p>')[0]|trim
        })
        |filter(item => item.question is not empty) %}

    {# Les prestations n'ont pas de visuel propre : le lot reprend celui du
       pole dont elles dependent. #}
    {% set visuel = service.image ?? (parent|default(null) ? parent.image : null) %}

    {# Les styles de detail.css sont repris sous .bm-d : la feuille visait
       html, body et a, elle aurait repeint le site. #}
    <div class="bm-d">

    {# ====== 01. HERO ====== #}
    <section class="d-hero">
        {% if visuel %}
            <div class="d-bg" style="background-image:url('{{ asset('documents/medias/' ~ (visuel.webpFileName ?? visuel.fileName)) }}')"></div>
        {% endif %}
        <div class="d-shade"></div>

        <nav class="crumbs" aria-label="Fil d'Ariane">
            <a href="{{ path('app_home') }}">Accueil</a> ·
            {% if parent|default(null) %}
                <a href="{{ path('app_service_show', { slug: parent.slug }) }}">{{ parent.title }}</a> ·
            {% endif %}
            {{ service.title }}
        </nav>

        <div class="d-copy">
            <span class="eyebrow">BM Notaire{% if parent|default(null) %} · {{ parent.title }}{% endif %}</span>
            <h1>{{ service.title }}</h1>
            {% if service.shortDescription %}
                <p class="lead">{{ service.shortDescription }}</p>
            {% endif %}
        </div>
    </section>

    {# ====== 02. LE BESOIN ====== #}
    {% if intro %}
        <section class="d-intro">
            <div class="grid2">
                <div><span class="num">01 / Le besoin</span></div>
                <div>
                    <h2>Comprendre avant<br><em>d’agir.</em></h2>
                    <p>{{ intro|raw }}</p>
                </div>
            </div>
        </section>
    {% endif %}

    {# ====== 03. LE PARCOURS ====== #}
    {% if etapes %}
        <section class="d-steps">
            <div class="grid2">
                <div><span class="num">02 / Le parcours</span></div>
                <div>
                    <h2>Votre dossier,<br><em>étape par étape.</em></h2>
                    <ol class="step-list">
                        {% for etape in etapes %}
                            <li class="step">
                                <span>{{ '%02d'|format(loop.index) }}</span>
                                <b>{{ etape }}</b>
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        </section>
    {% endif %}

    {# ====== 04. PREPARER ====== #}
    {% if pieces %}
        <section class="d-docs">
            <div class="grid2">
                <div><span class="num">03 / Préparer</span></div>
                <div>
                    <h2>Les premiers éléments<br><em>à réunir.</em></h2>
                    <ul class="chips">
                        {% for piece in pieces %}
                            <li class="chip">{{ piece }}</li>
                        {% endfor %}
                    </ul>
                    {% if reserve %}<p class="chips-note">{{ reserve|raw }}</p>{% endif %}
                </div>
            </div>
        </section>
    {% endif %}

    {# ====== 05. QUESTIONS ====== #}
    {% if questions %}
        <section class="d-faq">
            <div class="grid2">
                <div><span class="num">04 / Questions</span></div>
                <div>
                    <h2>Avant le<br><em>rendez-vous.</em></h2>
                    <div class="faq-list">
                        {% for item in questions %}
                            <div class="faq">
                                <h3>{{ item.question }}</h3>
                                <p>{{ item.reponse|raw }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {# ====== 06. ECHANGEONS ====== #}
    <section class="d-cta">
        <span class="num">05 / Échangeons</span>
        <h2>Parlons de<br><em>votre projet.</em></h2>
        <p>
            Présentez-nous votre situation. Nous vous indiquerons les premières
            pièces utiles et la prochaine étape.
        </p>
        <a class="btn" href="{{ path('app_rendez_vous') }}">Prendre rendez-vous ↗</a>
    </section>

    </div>{# /.bm-d #}

{% endif %}
