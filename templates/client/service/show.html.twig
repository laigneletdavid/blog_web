{# ======================================================================
   SERVICE — BM NOTAIRE
   Surcouche client, prioritaire sur le rendu commun (service/show.html.twig).

   Le meme fichier sert les deux niveaux de l'offre, dont la maquette donne
   deux decoupages distincts :
     - un pole  : hero en image, approche, besoins, accompagnement, echange ;
     - une prestation : hero, propos, parcours, pieces, questions, echange.
   La distinction se lit dans l'arborescence, pas dans un champ a cocher.

   Les intitules numerotes ("01 / NOTRE APPROCHE") sont constants d'une page a
   l'autre : ils vivent donc ici, et non dans le contenu de chaque service.
   ====================================================================== #}

{% set est_pole = children|default([])|length > 0 %}

{# Le contenu TipTap porte, dans l'ordre, la vision d'ensemble puis le reste.
   On isole le premier paragraphe pour alimenter la section d'approche. #}
{% set morceaux = service.content|default('')|split('</p>', 2) %}
{% set apercu = morceaux[0] is defined and morceaux[0] is not empty ? morceaux[0] ~ '</p>' : '' %}
{% set suite = morceaux[1]|default('') %}

{% if est_pole %}

    {# ====== 01. HERO ====== #}
    <section class="bm-xp-hero">
        {% if service.image %}
            <span class="bm-xp-hero__fond" style="background-image:url('{{ asset('documents/medias/' ~ (service.image.webpFileName ?? service.image.fileName)) }}')"></span>
        {% endif %}
        <span class="bm-xp-hero__voile"></span>
        <div class="bm-xp-hero__texte">
            <nav class="bm-fil bm-fil--clair" aria-label="Fil d'Ariane">
                <a href="{{ path('app_home') }}">Accueil</a>
                <span aria-hidden="true">·</span>
                <a href="{{ path('app_service_index') }}">{{ section_title|default('Expertises') }}</a>
            </nav>
            <p class="bm-kicker">BM Notaire · Expertise</p>
            <h1 class="bm-xp-hero__titre">{{ service.title }}</h1>
            {% if service.shortDescription %}
                <p class="bm-xp-hero__intro">{{ service.shortDescription }}</p>
            {% endif %}
        </div>
        <a href="#besoins" class="bm-xp-hero__defiler">Découvrir <span aria-hidden="true">↓</span></a>
    </section>

    {# ====== 02. NOTRE APPROCHE ====== #}
    {% if apercu %}
        <section class="bm-section">
            <div class="bm-duo">
                <div><span class="bm-kicker">01 / Notre approche</span></div>
                <div>
                    <h2 class="bm-titre">Une vision <em>d'ensemble.</em></h2>
                    <div class="bm-corps bm-corps--nu">{{ apercu|raw }}</div>
                </div>
            </div>
        </section>
    {% endif %}

    {# ====== 03. VOS BESOINS ====== #}
    <section class="bm-section bm-section--encre" id="besoins">
        <div class="bm-duo">
            <div><span class="bm-kicker">02 / Vos besoins</span></div>
            <div><h2 class="bm-titre">Comment pouvons-nous vous <em>accompagner&nbsp;?</em></h2></div>
        </div>

        <div class="bm-besoins">
            {% for enfant in children %}
                <a href="{{ path('app_service_show', { slug: enfant.slug }) }}" class="bm-besoin">
                    <span class="bm-besoin__num">{{ '%02d'|format(loop.index) }}</span>
                    <h3 class="bm-besoin__titre">{{ enfant.title }}</h3>
                    {% if enfant.shortDescription %}
                        <p class="bm-besoin__chapo">{{ enfant.shortDescription }}</p>
                    {% endif %}
                    <span class="bm-besoin__fleche" aria-hidden="true">↗</span>
                </a>
            {% endfor %}
        </div>
    </section>

    {# ====== 04. ACCOMPAGNEMENT ====== #}
    {% if suite %}
        <section class="bm-section">
            <div class="bm-duo">
                <div><span class="bm-kicker">03 / Accompagnement</span></div>
                <div><h2 class="bm-titre">Du projet <em>à l'acte.</em></h2></div>
            </div>
            <div class="bm-corps bm-corps--axes">{{ suite|raw }}</div>
        </section>
    {% endif %}

{% else %}

    {# ====== PRESTATION ====== #}
    <header class="bm-entete">
        <nav class="bm-fil" aria-label="Fil d'Ariane">
            <a href="{{ path('app_home') }}">Accueil</a>
            <span aria-hidden="true">·</span>
            <a href="{{ path('app_service_index') }}">{{ section_title|default('Expertises') }}</a>
            {% if parent|default(null) %}
                <span aria-hidden="true">·</span>
                <a href="{{ path('app_service_show', { slug: parent.slug }) }}">{{ parent.title }}</a>
            {% endif %}
        </nav>

        <p class="bm-kicker">BM Notaire{% if parent|default(null) %} · {{ parent.title }}{% endif %}</p>
        <h1 class="bm-titre">{{ service.title }}</h1>
        {% if service.shortDescription %}
            <p class="bm-lede">{{ service.shortDescription }}</p>
        {% endif %}
    </header>

    <div class="bm-corps bm-corps--prestation">
        {{ service.content|raw }}
    </div>

{% endif %}

{# ====== ECHANGEONS — commun aux deux niveaux ====== #}
<section class="bm-section bm-section--encre">
    <div class="bm-duo">
        <div><span class="bm-kicker">{{ est_pole ? '04' : '05' }} / Échangeons</span></div>
        <div>
            <h2 class="bm-titre">Parlons de <em>votre projet.</em></h2>
            <p class="bm-lede">
                Un premier échange permet d'identifier votre besoin, les documents à
                réunir et les prochaines étapes.
            </p>
            <a href="{{ path('app_contact') }}" class="bm-lien">Prendre rendez-vous <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>
