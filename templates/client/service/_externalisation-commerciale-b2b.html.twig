{# ======================================================================
   FICHE « PROSPECTION B2B » — bw_cws (spec du 06/11/2026, lot C)
   Pleine largeur, sans image generique. Prix : client/_macros (prix_b2b_*),
   trois formules HT : au lead, 500 appels, 1 000 appels (David, 06/11/2026).
   Process precise par David (06/11/2026) : une equipe de teleoperateurs appelle,
   qualifie le lead, valide le besoin et/ou le rendez-vous, et le lead est
   transmis au client ; David pilote et centralise l'ensemble. Plus de relance
   apres devis, de suivi apres vente, d'exclusivite ni de reunion mensuelle.
   « 1 000 appels par mois » : absent tant que non valide.
   ====================================================================== #}
{% import 'client/_macros.html.twig' as m %}
{% set ht = m.ht() %}
{% set prix = 'dès ' ~ m.prix_b2b_lead_mois() ~ ' € HT/mois' %}
{% set faq_qui_appelle_valide = true %}
{{ m.symbole_vague() }}

{# ====== 1. HERO + CARTE PRIX ====== #}
{% include 'client/_hero_commerce.html.twig' with {
    page_nom: 'Prospection B2B',
    surtitre: 'Le commerce — Prospection B2B',
    h1_avant: 'Des rendez-vous qualifiés dans votre ',
    h1_vague: 'agenda',
    h1_apres: ', sans recruter',
    texte: "Prospecter demande du temps, des outils et de la régularité. Je prends en charge votre prospection de A à Z ; vous vous concentrez sur ce qui rapporte : le rendez-vous et la signature.",
    carte: { libelle: 'Prospection B2B — 3 formules', prix: '<small>dès</small> ' ~ m.prix_b2b_lead_mois() ~ ' € HT<small>/mois</small>', complement: 'Au lead, ou forfaits de 500 et 1&nbsp;000 appels par mois', lien_ancre: '#formules', lien_libelle: 'Voir les 3 formules', puces: ['Une équipe de téléopérateurs dédiée', 'Leads qualifiés : besoin validé et/ou rendez-vous', 'Je pilote et centralise l’ensemble'] }
} %}

{# ====== 2. LE CONSTAT ====== #}
<section class="cws-section cws-section--alt">
    <div class="container">
        <div class="cws-section__head">
            <h2 class="home-section-title">Entre deux contrats, votre carnet de commandes se vide</h2>
            <p>La plupart des dirigeants de TPE et PME n'ont ni le temps ni les outils pour prospecter régulièrement. On prospecte quand ça va mal, on arrête quand ça repart, et le cycle recommence.</p>
        </div>
    </div>
</section>

{# ====== 3. CE QUE JE FAIS ====== #}
<section class="cws-section cws-offres">
    <div class="container">
        <div class="cws-section__head">
            <h2 class="home-section-title">Votre prospection, clé en main</h2>
        </div>
        {% set lignes = [
            { titre: 'Prospection téléphonique', texte: 'Une équipe de téléopérateurs appelle vos cibles avec un script validé ensemble et adapté à votre offre.' },
            { titre: 'Qualification et transmission', texte: 'Chaque contact est qualifié : on valide qu’il a un besoin et, si possible, on prend le rendez-vous. Le lead vous est alors transmis directement.' },
            { titre: "Campagnes d'emails", texte: 'Prise de contact et contenus utiles : des séquences ciblées sur les segments précis de votre marché.' },
            { titre: 'Base de prospects fournie', texte: "Pas besoin d'acheter de fichiers : je constitue et qualifie votre base à partir de sources professionnelles, par secteur, taille d'entreprise et zone." },
            { titre: 'Pilotage et reporting', texte: 'Je pilote l’équipe et je centralise l’ensemble : appels, réponses, leads, rendez-vous. Tout est tracé dans le CRM, vous recevez un suivi clair sans rien faire.' },
        ] %}
        <div class="cws-offres__liste">
            {% for l in lignes %}
            <article class="cws-offre" data-controller="reveal">
                <div class="cws-offre__tete">
                    <span class="cws-num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                    <h3 class="cws-offre__titre">{{ l.titre }}</h3>
                </div>
                <div class="cws-offre__corps"><p>{{ l.texte|insecables }}</p></div>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

{# ====== 4. LE PRINCIPE 20/80 (fonce) ====== #}
<section class="cws-section cws-section--dark">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Le principe</span>
            <h2 class="home-section-title">Je fais les 80&nbsp;%, vous gardez les 20&nbsp;% qui comptent</h2>
        </div>
        <div class="cws-barre" role="img" aria-label="80 % du travail pour mon équipe et moi : ciblage, appels, qualification. 20 % pour vous : rendez-vous et signature.">
            <div class="cws-barre__moi"><strong>80&nbsp;%</strong><span>Ciblage, appels, qualification — mon équipe et moi</span></div>
            <div class="cws-barre__vous"><strong>20&nbsp;%</strong><span>Rendez-vous et signature — vous</span></div>
        </div>
        <p class="cws-section__texte">Je prends en charge le travail de fond de la prospection pour que vous investissiez votre temps là où il rapporte&nbsp;: face à vos futurs clients.</p>
    </div>
</section>

{# ====== 4 bis. LES 3 FORMULES (fond gris, entre la section foncee et « inclus ») ====== #}
{% set formules = [
    { nom: 'Au lead', prix: m.prix_b2b_lead_mois() ~ ' € HT', unite: '/mois', plus: '+ ' ~ m.prix_b2b_lead() ~ ' € HT par lead qualifié', pour: 'Vous payez au résultat : un abonnement réduit, puis chaque lead qualifié transmis.' },
    { nom: '500 appels', prix: m.prix_b2b_500() ~ ' € HT', unite: '/mois', plus: '500 appels par mois', pour: 'Un volume d’appels défini chaque mois, pour une prospection régulière.', avant: true },
    { nom: '1 000 appels', prix: m.prix_b2b_1000() ~ ' € HT', unite: '/mois', plus: '1&nbsp;000 appels par mois', pour: 'Le volume pour couvrir un marché large ou accélérer.' },
] %}
<section class="cws-section cws-section--alt" id="formules">
    <div class="container">
        <div class="cws-section__head">
            <span class="home-overtitle">Les formules</span>
            <h2 class="home-section-title">Trois formules pour s'adapter à vos besoins</h2>
        </div>
        <div class="cws-cartes cws-cartes--3" data-controller="reveal" data-reveal-stagger-value="90">
            {% for f in formules %}
            <div class="cws-carte cws-formule{{ f.avant|default(false) ? ' cws-carte--avant' }}">
                <h3>{{ f.nom }}</h3>
                <p class="cws-formule__prix cws-formule__prix--ligne">{{ f.prix|raw }}&nbsp;<span>{{ f.unite }}</span></p>
                <p class="cws-formule__plus">{{ f.plus|raw }}</p>
                <p>{{ f.pour }}</p>
            </div>
            {% endfor %}
        </div>
        <p class="cws-formules__aide">Vous démarrez ou testez&nbsp;? Prenez la formule au lead. Vous voulez un flux régulier&nbsp;? 500 appels. Vous couvrez un marché large&nbsp;? 1&nbsp;000 appels.</p>
        <p class="cws-formules__note">Sans engagement. Même équipe, même qualification des leads, même pilotage dans les trois formules.</p>
    </div>
</section>

{# ====== 5. CE QUI EST INCLUS ====== #}
<section class="cws-section" id="inclus">
    <div class="container">
        <div class="cws-section__head">
            <h2 class="home-section-title">Ce qui est inclus</h2>
        </div>
        <ul class="cws-checklist">
            <li>Ciblage et constitution de la base de prospects</li>
            <li>Script d'appel validé ensemble</li>
            <li>Appels par une équipe de téléopérateurs dédiée</li>
            <li>Séquences d'emails</li>
            <li>Leads qualifiés (besoin validé et/ou rendez-vous) transmis directement</li>
            <li>Pilotage et centralisation par un interlocuteur unique</li>
            <li>Aucun recrutement, aucune charge salariale</li>
        </ul>
        <p class="cws-rappel-prix">{{ ('D' ~ prix|slice(1))|raw }}, sans engagement. <a href="#formules">Voir les 3 formules</a></p>
    </div>
</section>

{# ====== 6. POUR QUI ? ====== #}
<section class="cws-section cws-section--alt">
    <div class="container">
        <div class="cws-section__head">
            <h2 class="home-section-title">Pour qui&nbsp;?</h2>
            <p>Les TPE et PME en B2B qui veulent une prospection régulière sans embaucher de commercial&nbsp;: entreprises de services, ESN, bureaux d'études, prestataires industriels, et toute structure qui se développe en conquérant de nouveaux clients, en Occitanie.</p>
        </div>
    </div>
</section>

{# ====== 7. FAQ ====== #}
{% set faqPage = [] %}
{% if faq_qui_appelle_valide %}
    {% set faqPage = faqPage|merge([{ q: 'Qui passe les appels ?', r: "Une équipe de téléopérateurs dédiée à la prospection. Moi, je pilote et je centralise l'ensemble : ciblage, script, qualification des contacts et transmission des leads. Votre interlocuteur, c'est moi." }]) %}
{% endif %}
{% set faqPage = faqPage|merge([
    { q: 'Les prospects savent-ils que c’est externalisé ?', r: "Non. Je prospecte en votre nom, avec votre identité, votre adresse email, votre numéro. Pour le prospect, c'est votre entreprise qui le contacte. Quand le rendez-vous est pris, c'est vous qui reprenez la main sur la relation commerciale. C'est votre marque, votre image, votre pipe. Moi je suis le moteur, pas la carrosserie." },
    { q: 'Comment se passe le démarrage ?', r: "On définit ensemble vos cibles et votre discours. Je construis la base de prospects et le script, puis l'équipe appelle : chaque contact est qualifié, son besoin validé et, si possible, un rendez-vous pris. Je vous transmets les leads au fil de l'eau." },
    { q: 'Quelle formule choisir ?', r: "Au lead si vous voulez payer au résultat : un abonnement de " ~ m.prix_b2b_lead_mois() ~ " € HT par mois, puis " ~ m.prix_b2b_lead() ~ " € HT par lead qualifié transmis. Les forfaits de 500 ou 1 000 appels si vous préférez un volume d'appels défini chaque mois, à " ~ m.prix_b2b_500() ~ " ou " ~ m.prix_b2b_1000() ~ " € HT par mois. On en parle au premier échange." },
    { q: 'Et si ça ne marche pas ?', r: "C'est sans engagement. On fait le point régulièrement ; si les résultats ne sont pas là, on ajuste ou on arrête." },
]) %}
{% include 'client/_faq_page.html.twig' with { faqItems: faqPage, faqId: 'faq-prospection' } %}

{% include 'client/_jsonld_service_commerce.html.twig' with {
    nom: 'Prospection B2B externalisée',
    description: service.seoDescription|default(''),
    offres: [
        { nom: 'Au lead', prix: m.prix_b2b_lead_mois()|trim, unite: 'HT par mois, plus ' ~ m.prix_b2b_lead()|trim ~ ' € HT par lead qualifié' },
        { nom: '500 appels', prix: m.prix_b2b_500()|trim, unite: 'HT par mois, 500 appels' },
        { nom: '1 000 appels', prix: m.prix_b2b_1000()|trim, unite: 'HT par mois, 1 000 appels' },
    ]
} %}

{# ====== 8. APPEL FINAL ====== #}
{% include 'client/_cta_final.html.twig' %}
