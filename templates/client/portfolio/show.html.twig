{# ======================================================================
   REALISATION (fiche, en etude de cas) — bw_front (ComWeb Studio)
   - En-tete : type, titre, resume (description courte), client, date, lien.
   - Captures : l'accueil (image principale) puis la galerie, champ JSON
     gallery = [{ media: id, legende: '...', format: 'ecran'|'mobile' }]
     (pas encore editable dans l'admin : se remplit en base).
   - Etude de cas : le contenu detaille de l'admin, avec des H2 « Le client »,
     « Son besoin », « Ce qu'on a fait » et le temoignage en citation.
     TODO CONTENU : textes des etudes de cas (etude notariale, Les Pros d'Ici).
   - Les sites maison (tag « Nos sites ») ont une mention a la place.
   Les donnees structurees restent produites par portfolio/show.html.twig.
   ====================================================================== #}
{% import 'client/_macros.html.twig' as m %}

{% set site_maison = item.tags|filter(t => t.slug == 'nos-sites')|length > 0 %}
{% set galerie = [] %}
{% for g in item.gallery|default([]) %}
    {% set media_g = media_by_id(g.media|default(null)) %}
    {% if media_g %}
        {% set galerie = galerie|merge([{ media: media_g, legende: g.legende|default(''), format: g.format|default('ecran') }]) %}
    {% endif %}
{% endfor %}
{% set ecrans = galerie|filter(g => g.format != 'mobile') %}
{% set mobiles = galerie|filter(g => g.format == 'mobile') %}

<section class="cw-page-head cw-real-head">
    <div class="container">
        <p class="cw-real-head__retour"><a href="{{ path('app_portfolio_index') }}"><span aria-hidden="true">&larr;</span> Toutes les réalisations</a></p>
        <p class="cw-real__type">{{ site_maison ? 'Un de nos sites' : 'Étude de cas' }}{% if item.category %} · {{ item.category.name }}{% endif %}</p>
        <h1 class="cw-page-head__title">{{ item.title }}</h1>
        {% if item.shortDescription %}<p class="cw-page-head__lead">{{ item.shortDescription }}</p>{% endif %}
        <p class="cw-real-head__meta">
            {% if item.client %}<span>{{ item.client }}</span>{% endif %}
            {% if item.projectDate %}<span>En ligne depuis {{ item.projectDate|format_date(pattern='MMMM y', locale='fr') }}</span>{% endif %}
        </p>
        {% if item.projectUrl %}
        <a href="{{ item.projectUrl }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Visiter le site<span class="visually-hidden"> (nouvel onglet)</span><span class="cw-arrow" aria-hidden="true">&rarr;</span></a>
        {% else %}
        <p class="cw-real__ici">Vous y êtes</p>
        {% endif %}
    </div>
</section>

{# ====== CAPTURES ====== #}
<section class="cw-section cw-section--alt">
    <div class="container">
        {% if item.image %}
        <figure class="cw-real__capture cw-real__capture--grande">
            <span class="cw-real__barre"><span></span><span></span><span></span></span>
            {{ responsive_img(item.image, '(max-width: 1199px) 92vw, 1100px', 'cw-real__img', item.image.alt, true) }}
        </figure>
        {% endif %}

        {% if galerie|length > 0 %}
        <div class="cw-galerie{{ mobiles|length > 0 and ecrans|length > 0 ? ' cw-galerie--mixte' }}">
            {% for g in ecrans %}
            <figure class="cw-galerie__item" data-controller="reveal">
                <div class="cw-real__capture cw-galerie__ecran">
                    <span class="cw-real__barre"><span></span><span></span><span></span></span>
                    {{ responsive_img(g.media, '(max-width: 767px) 92vw, 700px', 'cw-real__img') }}
                </div>
                {% if g.legende %}<figcaption>{{ g.legende }}</figcaption>{% endif %}
            </figure>
            {% endfor %}
            {% for g in mobiles %}
            <figure class="cw-galerie__item cw-galerie__item--mobile" data-controller="reveal">
                <div class="cw-galerie__tel">
                    {{ responsive_img(g.media, '(max-width: 767px) 60vw, 260px', 'cw-galerie__tel-img') }}
                </div>
                {% if g.legende %}<figcaption>{{ g.legende }}</figcaption>{% endif %}
            </figure>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>

{# ====== ETUDE DE CAS ====== #}
{% if item.content|striptags|trim or site_maison %}
<section class="cw-section">
    <div class="container">
        {% if item.content|striptags|trim %}
        <div class="cw-real__contenu content-body">
            {{ item.content|raw }}
        </div>
        {% endif %}
        {% if site_maison %}
        <div class="cw-real__maison">
            <p><strong>Un de nos propres sites.</strong> Il tourne sur ComWeb Studio, avec le même outil et les mêmes mises à jour que les sites de nos clients.</p>
        </div>
        {% endif %}
    </div>
</section>
{% endif %}

<section class="home-cta">
    <div class="container text-center" data-controller="reveal">
        <h2 class="home-cta__title">Votre site, c'est le prochain ?</h2>
        <p class="home-cta__desc">Prenons un café, ou un appel en visio : 30 minutes, gratuit et sans engagement.</p>
        <a href="{{ m.lien_rdv() }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">Prendre rendez-vous<span class="visually-hidden"> (nouvel onglet)</span><span class="cw-arrow" aria-hidden="true">&rarr;</span></a>
        <p class="cw-cta__second">Ou <a href="{{ path('app_portfolio_index') }}">voir les autres réalisations</a>.</p>
    </div>
</section>
