{# ====== MACROS — bw_cws (Com Web Solutions) ======
   Repris de bw_front (ComWeb Studio) : meme vague, meme agenda. #}

{# Symbole SVG de la vague, a poser une fois par page avant tout usage de vague().
   Trace du logo couche a plat. Couleur portee par currentColor. #}
{% macro symbole_vague() %}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="bw-vague" viewBox="0 0 200 20">
        <path d="M3 8 C 30 10, 50 19, 61 19 C 67 19, 68 12, 72 12 C 77 12, 79 17, 85 17 C 93 17, 97 11, 101 8 C 105 4, 109 3, 114 3 C 121 3, 123 8, 129 8 C 135 8, 135 1, 140 1 C 155 1, 176 8, 197 11"
              fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"
              vector-effect="non-scaling-stroke"/>
    </symbol>
</svg>
{% endmacro %}

{# Mots soulignes par la vague, devoilee a l'apparition (controleur wave-draw).
   Classe wave-target : point d'accroche demande par le brief du 05/11/2026. #}
{% macro vague(mots) %}<span class="vague wave-target" data-controller="wave-draw">{{ mots }}<span class="vague__clip" aria-hidden="true"><svg class="vague__trait" viewBox="0 0 200 20" preserveAspectRatio="none"><use href="#bw-vague"/></svg></span></span>{% endmacro %}

{# Montant a la francaise : 1 250 € (espace insecable) #}
{% macro euros(n) %}{{ n|number_format(0, ',', ' ') }} €{% endmacro %}

{# Agenda de reservation Google, le meme que ComWeb Studio (decision David, 05/11/2026).
   Seul endroit des templates ou il est ecrit ; les textes en base le portent en clair. #}
{% macro lien_rdv() %}https://calendar.app.google/HjoNfP83BWDB3rkW6{% endmacro %}

{# Site ComWeb Studio : parametre studio_url de main (config/services.yaml) #}
{% macro lien_studio() %}{{ studio_url }}{% endmacro %}

{# Site LintellO (les fiches service Studio et LintellO ont ete retirees le 05/11/2026 :
   la home et le menu renvoient vers les sites des produits) #}
{% macro lien_lintello() %}https://lintello.fr{% endmacro %}

{# Reseau Enleys (activite commerciale de David, en Occitanie uniquement) #}
{% macro lien_enleys() %}https://enleys.com/{% endmacro %}
{% macro lien_enleys_agences() %}https://enleys.com/nos-agences/{% endmacro %}

{# Interrupteurs des fonctions a venir : '1' = en production, '' = pas encore.
   ia_api_disponible : API LintellO (debut 2027) ; tant que '', badges « Début 2027 ».
   chatbot_disponible : assistant IA sur le site du client ; tant que '', non cite.
   Usage : {% set ia_api_disponible = m.ia_api_disponible() is not empty %} #}
{% macro ia_api_disponible() %}{% endmacro %}
{% macro chatbot_disponible() %}{% endmacro %}

{# Accords pour montrer des references (meme convention : '1' = oui, '' = non).
   ref_bm_notaire_publiee : accord du notaire pour montrer bm-notaire.fr.
   kayre_captures_publiees : captures anonymisees de Kayre validees par le client.
   Les images vont dans public/images/references/ (voir les gabarits). #}
{% macro ref_bm_notaire_publiee() %}{% endmacro %}
{% macro kayre_captures_publiees() %}1{% endmacro %}

{# ====== Prix des offres commerce (pages commerce, spec du 06/11/2026) ======
   Un seul endroit pour les changer. Montants repris des anciennes pages.
   prix_commerce_ht : mettre 1 quand David confirme que les prix sont HT ;
   « HT » s'ajoute alors partout (m.ht()). #}
{% macro prix_commerce_ht() %}1{% endmacro %}
{% macro ht() %}{% import _self as s %}{% if s.prix_commerce_ht()|trim is not empty %} HT{% endif %}{% endmacro %}
{% macro prix_direction() %}1&nbsp;650{% endmacro %}
{# Prospection B2B : trois formules, prix HT (David, 06/11/2026).
   Au lead : abonnement + prix par lead qualifie ; forfaits 500 et 1 000 appels par mois. #}
{% macro prix_b2b_lead_mois() %}375{% endmacro %}
{% macro prix_b2b_lead() %}65{% endmacro %}
{% macro prix_b2b_500() %}650{% endmacro %}
{% macro prix_b2b_1000() %}950{% endmacro %}
{# Appels d'offres (David, 06/11/2026) : veille et preselection par mois, montage par dossier #}
{% macro prix_ao_mois() %}175{% endmacro %}
{% macro prix_ao_dossier() %}250{% endmacro %}

{# ====== Offre Com (brief du 09/11/2026) ======
   Modules independants, combinables librement (ce ne sont pas des paliers).
   Prix HT par mois ; engagement en mois (1 = sans engagement au-dela du 1er mois).
   La mise en place est facturee une fois, quel que soit le nombre de modules ;
   pour un client ComWeb Studio, c'est l'option Marketing de Studio (meme prix,
   a garder identique : bw_front, client/_offres.html.twig, options_prix.marketing). #}
{% macro prix_com_fiche() %}149{% endmacro %}
{% macro prix_com_blog() %}199{% endmacro %}
{% macro prix_com_reseaux() %}249{% endmacro %}
{% macro prix_com_seo() %}349{% endmacro %}
{% macro prix_com_pack() %}849{% endmacro %}
{% macro prix_com_mise_en_place() %}290{% endmacro %}
{# Offre de lancement : '1' = affichee, '' = masquee (a confirmer par David avant
   mise en ligne). Texte dans client/service/_communication-visibilite. #}
{% macro offre_lancement_com() %}{% endmacro %}
{# Chargee de com (execution de l'offre Com) presentee sur le site : '1' = oui.
   Emplacement pret dans la home (bloc signature) ; photo et texte a fournir. #}
{% macro chargee_com_presentee() %}{% endmacro %}
{# Page de l'offre Com : un seul endroit pour son adresse #}
{% macro lien_com() %}/service/communication-visibilite{% endmacro %}
