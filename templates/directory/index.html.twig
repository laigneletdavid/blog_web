{% extends 'base.html.twig' %}

{% block seo %}
    <title>{{ seo.title|default('Annuaire') }}</title>
    <meta name="description" content="{{ seo.description|default('Decouvrez les professionnels de notre annuaire') }}">
{% endblock %}

{% block body %}
<div class="container py-5 directory-section">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">Annuaire</li>
        </ol>
    </nav>

    <h1 class="title-one mb-4">{{ title_page }}</h1>

    {# --- Recherche + filtres par famille de tags --- #}
    <form class="directory-search mb-4" method="get" action="{{ path('app_directory') }}" data-controller="auto-submit">
        {% if activeCategory %}<input type="hidden" name="categorie" value="{{ activeCategory.slug }}">{% endif %}
        <div class="directory-search__row">
            <div class="input-group directory-search__input">
                <input type="text" name="q" class="form-control" placeholder="Rechercher un nom, metier, ville..." value="{{ search }}" autocomplete="off">
                <button class="btn btn-primary" type="submit" aria-label="Rechercher">{{ bi('search') }}</button>
            </div>
            {% for filter in tagFilterGroups %}
                <div class="directory-search__filter">
                    <label class="visually-hidden" for="tag-filter-{{ filter.group.slug }}">{{ filter.group.name }}</label>
                    <select id="tag-filter-{{ filter.group.slug }}"
                            name="tags[]"
                            class="form-select directory-search__select"
                            style="--tg-color: {{ filter.group.color }};"
                            data-action="change->auto-submit#submit">
                        <option value="">{{ filter.group.name }} : tous</option>
                        {% for row in filter.tags %}
                            <option value="{{ row.tag.slug }}"{% if row.tag.slug in activeTagSlugs %} selected{% endif %}>{{ row.tag.name }} ({{ row.count }})</option>
                        {% endfor %}
                    </select>
                </div>
            {% endfor %}
            <noscript>
                <button type="submit" class="btn btn-outline-primary">Filtrer</button>
            </noscript>
        </div>
        {% if search != '' or activeTagSlugs is not empty %}
            <a href="{{ path('app_directory', {categorie: activeCategory ? activeCategory.slug : null}) }}"
               class="directory-search__clear">{{ bi('x-lg', 'me-1') }}Effacer les filtres</a>
        {% endif %}
    </form>

    {# --- Filtres categories --- #}
    {% if directoryCategories|length > 1 %}
    <div class="directory-filters mb-4">
        <a href="{{ path('app_directory', {q: search ?: null, tags: activeTagSlugs}) }}"
           class="directory-filters__pill{% if not activeCategory %} directory-filters__pill--active{% endif %}">
            Tous
        </a>
        {% for cat in directoryCategories %}
        <a href="{{ path('app_directory', {categorie: cat.slug, q: search ?: null, tags: activeTagSlugs}) }}"
           class="directory-filters__pill{% if activeCategory and activeCategory.id == cat.id %} directory-filters__pill--active{% endif %}">
            {% if cat.icon %}{{ bi(cat.icon, 'me-1') }}{% endif %}
            {{ cat.name }}
        </a>
        {% endfor %}
    </div>
    {% endif %}

    {# --- Grille --- #}
    {% if entries|length > 0 %}
        <p class="directory-count text-muted mb-3">{{ entries|length }} professionnel{{ entries|length > 1 ? 's' : '' }}{% if search %} pour « {{ search }} »{% endif %}</p>
        <div class="directory-grid">
            {% for entry in entries %}
                {% include '_partials/_directory_card.html.twig' with { entry: entry } %}
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-5">
            <p class="text-muted">Aucun professionnel trouve{% if search %} pour « {{ search }} »{% endif %}.</p>
            {% if search %}
                <a href="{{ path('app_directory') }}" class="btn btn-outline-primary btn-sm mt-2">Effacer la recherche</a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
