{% extends 'base.html.twig' %}

{# SEO gere par SeoService via la variable seo (base.html.twig) #}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": {{ service.title|json_encode|raw }},
    "description": {{ seo.description|default(service.shortDescription|default(''))|json_encode|raw }}
    {%- if service.image %},
    "image": "{{ absolute_url(asset('documents/medias/' ~ service.image.fileName)) }}"
    {%- endif %},
    "provider": {
        "@type": "Organization",
        "name": {{ site.name|default('Blog&Web')|json_encode|raw }}
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ absolute_url(path('app_home')) }}"},
        {"@type": "ListItem", "position": 2, "name": "Services", "item": "{{ absolute_url(path('app_service_index')) }}"},
        {"@type": "ListItem", "position": 3, "name": {{ service.title|json_encode|raw }}}
    ]
}
</script>
{% endblock %}

{% block body %}
    {# Corps delegue : une surcouche client, sinon celle du theme, sinon le
       rendu commun. Un client peut ainsi redessiner cette page sans toucher
       aux fichiers partages par les autres. #}
    {% include [
        'client/service/show.html.twig',
        'themes/' ~ _theme ~ '/service/show.html.twig',
        'service/_show_generic.html.twig'
    ] %}
{% endblock %}
