{% extends 'base.html.twig' %}

{% block seo %}
    {# Valeurs par defaut, puis le bloc commun : robots (noindex d'une liste vide), canonical, Open Graph #}
    {% set seo = (seo|default({}))|merge({ title: seo.title|default(title_page), description: seo.description|default('Découvrez nos services') }) %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {# Corps delegue : une surcouche client, sinon celle du theme, sinon le
       rendu commun. Un client peut ainsi redessiner cette page sans toucher
       aux fichiers partages par les autres. #}
    {% include [
        'client/service/index.html.twig',
        'themes/' ~ _theme ~ '/service/index.html.twig',
        'service/_index_generic.html.twig'
    ] %}
{% endblock %}
