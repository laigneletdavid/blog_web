{% extends 'base.html.twig' %}

{% block seo %}
    <title>{{ seo.title|default(title_page) }}</title>
    <meta name="description" content="{{ seo.description|default('Découvrez nos services') }}">
{% endblock %}

{% block body %}
<div class="container py-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ title_page }}</li>
        </ol>
    </nav>

    {# Avec une image mise en avant, le titre passe dessus, comme sur une page.
       Sans image, il reste un titre ordinaire. #}
    {% if intro|default(null) and intro.featuredMedia %}
        <div class="page-hero services-hero">
            {{ responsive_img(intro.featuredMedia, '(max-width: 991px) 100vw, 1100px', 'page-hero__img', intro.title, false, intro) }}
            <div class="page-hero__overlay">
                <h1 class="page-hero__title">{{ title_page }}</h1>
            </div>
        </div>
    {% else %}
        <h1 class="title-one mb-4">{{ title_page }}</h1>
    {% endif %}

    {# Introduction facultative : page systeme "services_intro", editable dans l'admin #}
    {% if intro|default(null) %}
    <div class="services-intro page-detail__content article-detail__content mb-5">
        {{ intro.content|raw }}
    </div>
    {% endif %}

    {% include '_partials/_services_grid.html.twig' with { services: services } %}

    {% if services|length == 0 %}
    <p class="text-muted text-center py-5">Aucun service disponible pour le moment.</p>
    {% endif %}
</div>
{% endblock %}
