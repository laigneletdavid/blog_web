{% extends 'base.html.twig' %}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ (article.seoTitle ?? article.title)|json_encode|raw }},
    "datePublished": "{{ (article.publishedAt ?? article.createdAt)|date('c') }}",
    "dateModified": "{{ (article.updatedAt ?? article.createdAt)|date('c') }}",
    {% if article.featuredMedia %}
    "image": "{{ absolute_url(asset('documents/medias/' ~ article.featuredMedia.fileName)) }}",
    {% endif %}
    "description": {{ (article.seoDescription ?? article.featuredText ?? '')|json_encode|raw }},
    {% if article.author %}
    "author": {
        "@type": "Person",
        "name": {{ article.author.displayName|json_encode|raw }}
        {%- if article.author.jobTitle %},
        "jobTitle": {{ article.author.jobTitle|json_encode|raw }}
        {%- endif %}
    },
    {% else %}
    "author": {
        "@type": "Organization",
        "name": {{ site.name|default('Blog&Web')|json_encode|raw }},
        "url": "{{ absolute_url('/') }}"
    },
    {% endif %}
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ app.request.uri }}"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ absolute_url(path('app_home')) }}"},
        {"@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ absolute_url(path('app_article_show_all')) }}"},
        {"@type": "ListItem", "position": 3, "name": {{ article.title|json_encode|raw }}}
    ]
}
</script>
{% endblock %}

{% block body %}
    {# Corps delegue : une surcouche client, sinon celle du theme, sinon le
       rendu commun. Un client peut ainsi redessiner cette page sans toucher
       aux fichiers partages par les autres. #}
    {% include [
        'client/article/show.html.twig',
        'themes/' ~ _theme ~ '/article/show.html.twig',
        'article/_show_generic.html.twig'
    ] %}
{% endblock %}
